;; "" WINDOWS_TOGGLES """""""""""""""""""""""""""""""""""""""""""""""""""""""
(defvar
  toggle_windows_layer                (t! toggle_layer             windows_layer)
  toggle_windows+lsft_layer           (t! toggle_mod_layer   lsft  windows+lsft_layer)
  toggle_windows+rsft_layer           (t! toggle_mod_layer   rsft  windows+rsft_layer)
  toggle_windows+move_layer           (t! toggle_layer             windows+move_layer)
  toggle_windows+resize_layer         (t! toggle_layer             windows+resize_layer)
  toggle_windows+snap_layer           (t! toggle_layer             windows+snap_layer)
  toggle_windows+swap_layer           (t! toggle_layer             windows+swap_layer)
)

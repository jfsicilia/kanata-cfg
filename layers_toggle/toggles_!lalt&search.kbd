;; "" !LALT&SEARCH_TOGGLES """"""""""""""""""""""""""""""""""""""""""""""""""
(defvar
  toggle_!lalt&search_layer          (t! toggle_mod_2layer  lalt       lalt_layer      !lalt&search_layer      )
  toggle_!lalt&search+lsft_layer     (t! toggle_2mod_2layer lalt lsft  lalt+lsft_layer !lalt&search+lsft_layer )
  toggle_!lalt&search+rsft_layer     (t! toggle_2mod_2layer lalt rsft  lalt+rsft_layer !lalt&search+rsft_layer )
  toggle_!lalt&search+lmet_layer            (t! toggle_2mod_2layer lalt lmet      lalt+lmet_layer      !lalt&search+lmet_layer)
  toggle_!lalt&search+lmet+lsft_layer       (t! toggle_3mod_2layer lalt lmet lsft lalt+lmet+lsft_layer !lalt&search+lmet+lsft_layer)
  toggle_!lalt&search+lmet+rsft_layer       (t! toggle_3mod_2layer lalt lmet rsft lalt+lmet+rsft_layer !lalt&search+lmet+rsft_layer)
  toggle_!lalt&search+lsft+lmet_layer       (t! toggle_3mod_2layer lalt lmet lsft lalt+lmet+lsft_layer !lalt&search+lmet+lsft_layer)
  toggle_!lalt&search+rsft+lmet_layer       (t! toggle_3mod_2layer lalt lmet rsft lalt+lmet+rsft_layer !lalt&search+lmet+rsft_layer)
  toggle_!lsft+lalt+lmet_layer       (t! toggle_3mod_2layer lsft lalt lmet lalt+lmet+lsft_layer !lalt&search+lmet+lsft_layer)
  toggle_!lsft+lmet+lalt_layer       (t! toggle_3mod_2layer lsft lalt lmet lalt+lmet+lsft_layer !lalt&search+lmet+lsft_layer)
  toggle_!rsft+lalt+lmet_layer       (t! toggle_3mod_2layer rsft lalt lmet lalt+lmet+rsft_layer !lalt&search+lmet+rsft_layer)
  toggle_!rsft+lmet+lalt_layer       (t! toggle_3mod_2layer rsft lalt lmet lalt+lmet+rsft_layer !lalt&search+lmet+rsft_layer)
  toggle_!lmet&replace+lalt_layer            (t! toggle_2mod_2layer lmet lalt      lalt+lmet_layer      !lalt&search+lmet_layer)
  toggle_!lmet&replace+lalt+lsft_layer       (t! toggle_3mod_2layer lmet lalt lsft lalt+lmet+lsft_layer !lalt&search+lmet+lsft_layer)
  toggle_!lmet&replace+lalt+rsft_layer       (t! toggle_3mod_2layer lmet lalt rsft lalt+lmet+rsft_layer !lalt&search+lmet+rsft_layer)
  toggle_!lmet&replace+lsft+lalt_layer       (t! toggle_3mod_2layer lmet lalt lsft lalt+lmet+lsft_layer !lalt&search+lmet+lsft_layer)
  toggle_!lmet&replace+rsft+lalt_layer       (t! toggle_3mod_2layer lmet lalt rsft lalt+lmet+rsft_layer !lalt&search+lmet+rsft_layer)
)

;; "" LALT_TOGGLES """"""""""""""""""""""""""""""""""""""""""""""""""""""""""
(defvar
  toggle_lalt_layer                  (t! toggle_mod_layer  lalt       lalt_layer  )
  toggle_lalt+lsft_layer             (t! toggle_2mod_layer lalt lsft  lalt+lsft_layer)
  toggle_lalt+rsft_layer             (t! toggle_2mod_layer lalt rsft  lalt+rsft_layer)
  toggle_lalt+lmet_layer             (t! toggle_2mod_layer  lalt lmet      lalt+lmet_layer)
  toggle_lalt+lmet+lsft_layer        (t! toggle_3mod_layer  lalt lmet lsft lalt+lmet+lsft_layer)
  toggle_lalt+lmet+rsft_layer        (t! toggle_3mod_layer  lalt lmet rsft lalt+lmet+rsft_layer)
  toggle_lalt+lsft+lmet_layer        (t! toggle_3mod_layer  lalt lmet lsft lalt+lmet+lsft_layer)
  toggle_lalt+rsft+lmet_layer        (t! toggle_3mod_layer  lalt lmet rsft lalt+lmet+rsft_layer)
  toggle_lsft+lalt+lmet_layer        (t! toggle_3mod_layer  lsft lalt lmet lalt+lmet+lsft_layer)
  toggle_lsft+lmet+lalt_layer        (t! toggle_3mod_layer  lsft lalt lmet lalt+lmet+lsft_layer)
  toggle_rsft+lalt+lmet_layer        (t! toggle_3mod_layer  rsft lalt lmet lalt+lmet+rsft_layer)
  toggle_rsft+lmet+lalt_layer        (t! toggle_3mod_layer  rsft lalt lmet lalt+lmet+rsft_layer)
  toggle_lmet+lalt_layer             (t! toggle_2mod_layer  lmet lalt      lalt+lmet_layer)
  toggle_lmet+lalt+lsft_layer        (t! toggle_3mod_layer  lmet lalt lsft lalt+lmet+lsft_layer)
  toggle_lmet+lalt+rsft_layer        (t! toggle_3mod_layer  lmet lalt rsft lalt+lmet+rsft_layer)
  toggle_lmet+lsft+lalt_layer        (t! toggle_3mod_layer  lmet lalt lsft lalt+lmet+lsft_layer)
  toggle_lmet+rsft+lalt_layer        (t! toggle_3mod_layer  lmet lalt rsft lalt+lmet+rsft_layer)
)

;; "" TAB LAYER """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (tabs_layer)
  spc   $action_tabs+spc

  h     $action_tabs+h
  left  $action_tabs+h
  l     $action_tabs+l
  right $action_tabs+l
  j     $action_tabs+j
  down  $action_tabs+j
  up    $action_tabs+k

  r     $action_tabs+r
  t     $action_tabs+t
  w     $action_tabs+w

  1     $action_tabs+1
  2     $action_tabs+2
  3     $action_tabs+3
  4     $action_tabs+4
  5     $action_tabs+5
  6     $action_tabs+6
  7     $action_tabs+7
  8     $action_tabs+8
  9     $action_tabs+9

  ;; == SFT ======================
  $d|lsft         (t! th _                    $toggle_tabs+lsft_layer)
  $k|rsft         (t! th $action_tabs+k    $toggle_tabs+rsft_layer)
  lsft            (t! th _                    $toggle_tabs+lsft_layer)
  rsft            (t! th _                    $toggle_tabs+rsft_layer)

  ;; == Gui Actions ========================
  $move   (t! th _ $toggle_tabs+move_layer)
  $toggle $action_tabs+toggle
)
(deflayermap (tabs+move_layer)
  h     $action_tabs+move+h
  left  $action_tabs+move+h
  l     $action_tabs+move+l
  right $action_tabs+move+l
  j     $action_tabs+move+j
  down  $action_tabs+move+j
  k     $action_tabs+move+k
  up    $action_tabs+move+k
)
(deflayermap (tabs+lsft_layer)
  t $action_tabs+lsft+t
)
(deflayermap (tabs+rsft_layer)
  t $action_tabs+lsft+t
)

;; "" !LMET_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lmet&replace_layer)
  (t! map_layers "$action_!lmet&replace" "!lmet&replace" ($<lctl $>lctl $<lalt $>lalt $lsft $rsft $!lctl $!lalt lsft rsft))
  (t! map_keys   "$action_!lmet&replace"         ($<lctl $>lctl $<lalt $>lalt $lsft $rsft tab))
    spc $action_!lmet&replace+spc
)

(deflayermap (!lmet&replace+lsft_layer)
  (t! map_layers "$action_!lmet&replace+lsft" "!lmet&replace+lsft" ($<lctl $>lctl $<lalt $>lalt $!lctl $!lalt))
  (t! map_keys   "$action_!lmet&replace+lsft"              ($<lctl $>lctl $<lalt $>lalt tab))
    spc $action_!lmet&replace+lsft+spc
)

(deflayermap (!lmet&replace+rsft_layer)
  (t! map_layers "$action_!lmet&replace+rsft" "!lmet&replace+rsft" ($<lctl $>lctl $<lalt $>lalt $!lctl $!lalt))
  (t! map_keys   "$action_!lmet&replace+rsft"              ($<lctl $>lctl $<lalt $>lalt tab))
    spc $action_!lmet&replace+rsft+spc
)


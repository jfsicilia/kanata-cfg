;; "" !LMET_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lmet_layer)
  (t! map_layers "$action_!lmet" "!lmet" ($<lctl $>lctl $<lalt $>lalt $lsft $rsft $!lctl $!lalt lsft rsft))
  (t! map_keys   "$action_!lmet"         ($<lctl $>lctl $<lalt $>lalt $lsft $rsft tab))
)

(deflayermap (!lmet+lsft_layer)
  (t! map_layers "$action_!lmet+lsft" "!lmet+lsft" ($<lctl $>lctl $<lalt $>lalt $!lctl $!lalt))
  (t! map_keys   "$action_!lmet+lsft"              ($<lctl $>lctl $<lalt $>lalt tab))
)

(deflayermap (!lmet+rsft_layer)
  (t! map_layers "$action_!lmet+rsft" "!lmet+rsft" ($<lctl $>lctl $<lalt $>lalt $!lctl $!lalt))
  (t! map_keys   "$action_!lmet+rsft"              ($<lctl $>lctl $<lalt $>lalt tab))
)

;; "" REPLACE_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""
;; Always pushed together with !lmet (see toggle_replace_&_!lmet_layer).
(deflayermap (replace_layer)
    (t! map_layers _ "replace" ($lsft $rsft lsft rsft))
    spc $action_replace+spc
)
(deflayermap (replace+lsft_layer)
    spc $action_replace+lsft+spc
)
(deflayermap (replace+rsft_layer)
    spc $action_replace+rsft+spc
)

;; "" OMNI_LAYER """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (omni_layer)
  (t! map_layers _ "omni" (lsft rsft))

  spc  (multi (on-press tap-vkey vk_help_close) $action_omni+spc)
  ent  (multi (on-press tap-vkey vk_help_close) $action_omni+ent)

  a    (multi (on-press tap-vkey vk_help_close) $action_omni+a)
  b    (multi (on-press tap-vkey vk_help_close) $action_omni+b)
  ;;   Tapping c copies. Holding c allows you to copy to another view/pane/tab.
  c    (multi (on-press tap-vkey vk_help_close) (t! th $action_omni+c (t! toggle_layer omni+c_layer)))
  d    (multi (on-press tap-vkey vk_help_close) $action_omni+d)
  e    (multi (on-press tap-vkey vk_help_close) $action_omni+e)
  f    (multi (on-press tap-vkey vk_help_close) $action_omni+f)
  g    (multi (on-press tap-vkey vk_help_close) $action_omni+g)
  h    (multi (on-press tap-vkey vk_help_close) $action_omni+h)
  i    (multi (on-press tap-vkey vk_help_close) $action_omni+i)
  j    (multi (on-press tap-vkey vk_help_close) $action_omni+j)
  k    (multi (on-press tap-vkey vk_help_close) $action_omni+k)
  l    (multi (on-press tap-vkey vk_help_close) $action_omni+l)
  m    (multi (on-press tap-vkey vk_help_close) $action_omni+m)
  n    (multi (on-press tap-vkey vk_help_close) $action_omni+n)
  o    (multi (on-press tap-vkey vk_help_close) $action_omni+o)
  p    (multi (on-press tap-vkey vk_help_close) $action_omni+p)
  q    (multi (on-press tap-vkey vk_help_close) $action_omni+q)
  r    (multi (on-press tap-vkey vk_help_close) $action_omni+r)
  s    (multi (on-press tap-vkey vk_help_close) $action_omni+s)
  t    (multi (on-press tap-vkey vk_help_close) $action_omni+t)
  u    (multi (on-press tap-vkey vk_help_close) $action_omni+u)
  v    (multi (on-press tap-vkey vk_help_close) $action_omni+v)
  w    (multi (on-press tap-vkey vk_help_close) $action_omni+w)
  ;;   Tapping x cuts. Holding x allows you to cut to another view/pane/tab.
  x    (multi (on-press tap-vkey vk_help_close) (t! th $action_omni+x (t! toggle_layer omni+x_layer)))
  y    (multi (on-press tap-vkey vk_help_close) $action_omni+y)
  z    (multi (on-press tap-vkey vk_help_close) $action_omni+z)
  `    (multi (on-press tap-vkey vk_help_close) $action_omni+`)
  -    (multi (on-press tap-vkey vk_help_close) $action_omni+-)
  =    (multi (on-press tap-vkey vk_help_close) $action_omni+=)
  bspc (multi (on-press tap-vkey vk_help_close) $action_omni+bcsp) 
  [    (multi (on-press tap-vkey vk_help_close) $action_omni+[)
  ]    (multi (on-press tap-vkey vk_help_close) $action_omni+])
  \    (multi (on-press tap-vkey vk_help_close) $action_omni+\)
  ;    (multi (on-press tap-vkey vk_help_close) $action_omni+;)   ;;""
  '    (multi (on-press tap-vkey vk_help_close) $action_omni+')
  ,    (multi (on-press tap-vkey vk_help_close) $action_omni+,)
  .    (multi (on-press tap-vkey vk_help_close) $action_omni+.)
  /    (multi (on-press tap-vkey vk_help_close) $action_omni+/)

  1    (multi (on-press tap-vkey vk_help_close) $action_omni+1)
  2    (multi (on-press tap-vkey vk_help_close) $action_omni+2)
  3    (multi (on-press tap-vkey vk_help_close) $action_omni+3)
  4    (multi (on-press tap-vkey vk_help_close) $action_omni+4)
  5    (multi (on-press tap-vkey vk_help_close) $action_omni+5)
  6    (multi (on-press tap-vkey vk_help_close) $action_omni+6)
  7    (multi (on-press tap-vkey vk_help_close) $action_omni+7)
  8    (multi (on-press tap-vkey vk_help_close) $action_omni+8)
  9    (multi (on-press tap-vkey vk_help_close) $action_omni+9)
  0    (multi (on-press tap-vkey vk_help_close) $action_omni+0)

  $!lmet|desktops (multi (on-press tap-vkey vk_help_close) $action_omni+!lmet)
  $!lalt|panes    (multi (on-press tap-vkey vk_help_close) $action_omni+!lalt)
  $!lctl|tabs     (multi (on-press tap-vkey vk_help_close) $action_omni+!lctl)
   $ralt|apps     (multi (on-press tap-vkey vk_help_close) $action_omni+ralt)
   $prnt|groups   (multi (on-press tap-vkey vk_help_close) $action_omni+prnt)
   $rctl|sessions (multi (on-press tap-vkey vk_help_close) $action_omni+rctl)
)

(deflayermap (omni+lsft_layer)
  e $action_omni+lsft+e
  a $action_omni+lsft+a
  n $action_omni+lsft+n
  z $action_omni+lsft+z
  s $action_omni+lsft+s

  \ $action_omni+lsft+\

  t $action_omni+lsft+t
)

(deflayermap (omni+rsft_layer)
  e $action_omni+lsft+e
  a $action_omni+rsft+a
  n $action_omni+rsft+n
  z $action_omni+lsft+z
  s $action_omni+lsft+s

  \ $action_omni+rsft+\

  t $action_omni+lsft+t
)

(deflayermap (omni+c_layer)
  l      $action_omni+c+right
  right  $action_omni+c+right
  h      $action_omni+c+left
  left   $action_omni+c+left
)

(deflayermap (omni+x_layer)
  l      $action_omni+x+right
  right  $action_omni+x+right
  h      $action_omni+x+left
  left   $action_omni+x+left
)

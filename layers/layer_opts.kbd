;; "" OPTS_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (opts_layer)
  (t! map_layers _ "opts" (lsft rsft))

  1 $action_opts_set_quiet_profile
  2 $action_opts_set_balanced_profile
  3 $action_opts_set_performance_profile
  k $action_opts_reload_kanata
  d $action_opts_debug_message
  p $action_opts_print_screen
  q $action_sleep_system
)

(deflayermap (opts+lsft_layer)
  k $action_opts_sync_and_reload_kanata
  p $action_opts_print_window
  q $action_opts_restart_system 
)

(deflayermap (opts+rsft_layer)
  k $action_opts_restart_kwanata
  q $action_opts_shutdown_system 
)

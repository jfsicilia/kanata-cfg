;; "" SESSION_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (sessions_layer)

  spc             $action_sessions+spc
  w               $action_sessions+w
  r               $action_sessions+r 
  h               $action_sessions+h 
  j               $action_sessions+j 
  l               $action_sessions+l 

  ;; == SFT ======================
  $d|lsft         (t! th $action_sessions+d   $toggle_sessions+lsft_layer)
  $k|rsft         (t! th $action_sessions+k   $toggle_sessions+rsft_layer)
  lsft            (t! th _                    $toggle_sessions+lsft_layer)
  rsft            (t! th _                    $toggle_sessions+rsft_layer)
)
(deflayermap (sessions+lsft_layer)
)
(deflayermap (sessions+rsft_layer)
)

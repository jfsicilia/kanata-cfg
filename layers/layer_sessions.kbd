;; "" SESSION_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (sessions_layer)
  $invert|keyb (t! invert_apps_sort $toggle_sessions_layer)
  spc             $action_sessions+spc
  $toggle         $action_sessions+toggle
  h               $action_sessions+h     ;; prev
  l               $action_sessions+l     ;; next
  n               $action_sessions+n     ;; new
  r               $action_sessions+r     ;; rename
  w               $action_sessions+w     ;; save and detach
  z               $action_sessions+z     ;; sleep
  bspc            $action_sessions+bspc  ;; kill

  0               $action_sessions+0
  1               $action_sessions+1
  2               $action_sessions+2
  3               $action_sessions+3
  4               $action_sessions+4
  5               $action_sessions+5
  6               $action_sessions+6
  7               $action_sessions+7
  8               $action_sessions+8
  9               $action_sessions+9

  ;; == SFT ======================
  $d|lsft         (t! th $action_sessions+d   $toggle_sessions+lsft_layer) ;; detach
  $k|rsft         (t! th _                    $toggle_sessions+rsft_layer) 
  lsft            (t! th _                    $toggle_sessions+lsft_layer)
  rsft            (t! th _                    $toggle_sessions+rsft_layer)
)
(deflayermap (sessions+lsft_layer)
  $invert|keyb (t! invert_apps_sort $toggle_sessions+lsft_layer)
  z               $action_sessions+lsft+z     ;; awake
  bspc            $action_sessions+lsft+bspc  ;; revive
)
(deflayermap (sessions+rsft_layer)
  $invert|keyb (t! invert_apps_sort $toggle_sessions+rsft_layer)
  z               $action_sessions+rsft+z     ;; awake
  bspc            $action_sessions+rsft+bspc  ;; revive
)

;; "" GROUPS LAYER """"""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (groups_layer)
  h     $action_groups+h
  left  $action_groups+h
  l     $action_groups+l
  right $action_groups+l
  j     $action_groups+j
  down  $action_groups+j
  up    $action_groups+k

  ;; == SFT ======================
  $d|lsft         (t! th _                    $toggle_groups+lsft_layer)
  $k|rsft         (t! th $action_groups+k     $toggle_groups+rsft_layer)
  lsft            (t! th _                    $toggle_groups+lsft_layer)
  rsft            (t! th _                    $toggle_groups+rsft_layer)
)

(deflayermap (groups+lsft_layer)
)

(deflayermap (groups+rsft_layer)
)


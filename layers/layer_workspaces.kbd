;; "" WORKSPACES LAYER """"""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (workspaces_layer)
  spc $action_workspaces+spc

  j $action_workspaces+j
  l $action_workspaces+l
  h $action_workspaces+h

  ;; == GUI ======================
  $move   (t! th _ $toggle_workspaces+move_layer)
  $toggle $action_workspaces+toggle

  ;; == SFT ======================
  $d|lsft         (t! th _                    $toggle_workspaces+lsft_layer)
  $k|rsft         (t! th $action_workspaces+k $toggle_workspaces+rsft_layer)
  lsft            (t! th _                    $toggle_workspaces+lsft_layer)
  rsft            (t! th _                    $toggle_workspaces+rsft_layer)
)

(deflayermap (workspaces+move_layer)
  j $action_workspaces+move+j
  k $action_workspaces+move+k
  l $action_workspaces+move+l
  h $action_workspaces+move+h
)
(deflayermap (workspaces+lsft_layer)
)
(deflayermap (workspaces+rsft_layer)
)

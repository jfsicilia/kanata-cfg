;; "" !LCTL_LAYER """""""""""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lctl&select_layer)
  (t! map_layers "$action_!lctl&select" "!lctl&select" ($<lalt $>lalt $<lmet $>lmet $lsft $rsft $!lalt $!lmet lsft rsft))
  (t! map_keys   "$action_!lctl&select"                ($<lalt $>lalt $<lmet $>lmet $lsft $rsft))
  spc $action_!lctl&select+spc
)

(deflayermap (!lctl&select+lsft_layer)
  (t! map_layers "$action_!lctl&select+lsft" "!lctl&select+lsft" ($<lalt $>lalt $<lmet $>lmet $!lalt $!lmet))
  (t! map_keys   "$action_!lctl&select+lsft"                     ($<lalt $>lalt $<lmet $>lmet ))
  spc $action_!lctl&select+lsft+spc
)

(deflayermap (!lctl&select+rsft_layer)
  (t! map_layers "$action_!lctl&select+rsft" "!lctl&select+rsft" ($<lalt $>lalt $<lmet $>lmet $!lalt $!lmet))
  (t! map_keys   "$action_!lctl&select+rsft"                     ($<lalt $>lalt $<lmet $>lmet ))
  spc $action_!lctl&select+rsft+spc
)

;; "" !LCTL+LALT_LAYER """"""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lctl&select+lalt_layer)
  (t! map_layers _ "!lctl&select+lalt" ($<lmet $>lmet $lsft $rsft $!lmet lsft rsft))
  (t! map_keys   _              ($<lmet $>lmet $lsft $rsft))
)

(deflayermap (!lctl&select+lalt+lsft_layer)
  (t! map_layers _ "!lctl&select+lalt+lsft" ($<lmet $>lmet $!lmet))
  (t! map_keys   _                   ($<lmet $>lmet))
)

(deflayermap (!lctl&select+lalt+rsft_layer)
  (t! map_layers _ "!lctl&select+lalt+rsft" ($<lmet $>lmet $!lmet))
  (t! map_keys   _                   ($<lmet $>lmet))
)

;; "" !LCTL+LMET_LAYER """"""""""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lctl&select+lmet_layer)
  (t! map_layers _ "!lctl&select+lmet" ($<lalt $>lalt $lsft $rsft $!lalt lsft rsft))
  (t! map_keys   _              ($<lalt $>lalt $lsft $rsft))
)

(deflayermap (!lctl&select+lmet+lsft_layer)
  (t! map_layers _ "!lctl&select+lmet+lsft" ($<lalt $>lalt $!lalt))
  (t! map_keys   _                   ($<lalt $>lalt))
)

(deflayermap (!lctl&select+lmet+rsft_layer)
  (t! map_layers _ "!lctl&select+lmet+rsft" ($<lalt $>lalt $!lalt))
  (t! map_keys   _                   ($<lalt $>lalt))
)

;; "" !LCTL+LALT+LMET_LAYER """""""""""""""""""""""""""""""""""""""""""""""""
(deflayermap (!lctl&select+lalt+lmet_layer)
  (t! map_layers _ "!lctl&select+lalt+lmet" ($lsft $rsft lsft rsft))
  (t! map_keys   _                   ($lsft $rsft))
) 

(deflayermap (!lctl&select+lalt+lmet+lsft_layer)
  (t! map_keys _ ())
)

(deflayermap (!lctl&select+lalt+lmet+rsft_layer)
  (t! map_keys _ ())
)


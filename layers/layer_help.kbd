(deflayermap (help_layer)
      $esc|opts      (t! 1x|2x (push-msg "OPEN_HELP:opts") (multi $CLOSE_HELP (layer-switch default)))

      $`|mod`        (push-msg "OPEN_HELP:mod`")
      $0|mod0        (push-msg "OPEN_HELP:mod0")
      $1|mod1        (push-msg "OPEN_HELP:mod1")
      $2|mod2        (push-msg "OPEN_HELP:mod2")
      $3|mod3        (push-msg "OPEN_HELP:mod3")
      $4|mod4        (push-msg "OPEN_HELP:mod4")
      $5|mod5        (push-msg "OPEN_HELP:mod5")
      $6|mod6        (push-msg "OPEN_HELP:mod6")
      $7|mod7        (push-msg "OPEN_HELP:mod7")
      $8|mod8        (push-msg "OPEN_HELP:mod8")
      $9|mod9        (push-msg "OPEN_HELP:mod9")
      $-|mod-        (push-msg "OPEN_HELP:mod-")
      $=|mod=        (push-msg "OPEN_HELP:mod=")

  ;; Upper row keys
    $tab|open        (push-msg "OPEN_HELP:open")
      $q|system      (push-msg "OPEN_HELP:system")
      $w|workflow    (push-msg "OPEN_HELP:workflow")
      $e|refactor    (push-msg "OPEN_HELP:refactor")
      $r|run         (push-msg "OPEN_HELP:run")
      $t|layouts     (push-msg "OPEN_HELP:layouts")
      $y|layouts     (push-msg "OPEN_HELP:layouts")
      $u|run         (push-msg "OPEN_HELP:run")
      $i|refactor    (push-msg "OPEN_HELP:refactor")
      $o|workflow    (push-msg "OPEN_HELP:workflow")
      $p|system      (push-msg "OPEN_HELP:system")
      $[|mod[        (push-msg "OPEN_HELP:mod[")
      $]|mod]        (push-msg "OPEN_HELP:mod]")
      $\|mod\        (push-msg "OPEN_HELP:mod\") ;;"

  ;; Medium row keys
    $esc|omni        (t! 1x|2x (push-msg "OPEN_HELP:omni") (multi $CLOSE_HELP (layer-switch default)))
      $a|lmet        (push-msg "OPEN_HELP:lmet")   
      $s|lalt        (push-msg "OPEN_HELP:lalt")
      $d|lsft        (push-msg "OPEN_HELP:lsft")
      $f|lctl        (push-msg "OPEN_HELP:lctl")
      $g|windows     (push-msg "OPEN_HELP:windows")
      $h|windows     (push-msg "OPEN_HELP:windows")
      $j|lctl        (push-msg "OPEN_HELP:lctl")
      $k|rsft        (push-msg "OPEN_HELP:rsft")
      $l|lalt        (push-msg "OPEN_HELP:lalt")
      $;|lmet        (push-msg "OPEN_HELP:lmet")
      $'|mod'        (push-msg "OPEN_HELP:mod'")

  ;; Lower row keys 
  lsft                (push-msg "OPEN_HELP:lsft")
  $keyb               (push-msg "OPEN_HELP:keyb")
      $z|workspaces   (push-msg "OPEN_HELP:workspaces")   
      $x|groups       (push-msg "OPEN_HELP:groups")
      $c|panes        (push-msg "OPEN_HELP:panes")
      $v|tabs         (push-msg "OPEN_HELP:tabs")
      $b|sessions     (push-msg "OPEN_HELP:sessions")
      $n|sessions     (push-msg "OPEN_HELP:sessions")
      $m|tabs         (push-msg "OPEN_HELP:tabs")
      $,|panes        (push-msg "OPEN_HELP:panes")
      $.|groups       (push-msg "OPEN_HELP:groups")
      $/|workspaces   (push-msg "OPEN_HELP:workspaces")
  rsft                (push-msg "OPEN_HELP:rsft")

  ;; Modifiers row.
    $!lmet|replace    (push-msg "OPEN_HELP:!lmet|replace")
    $!lalt|search     (push-msg "OPEN_HELP:!lalt|search")
    $!lctl|select     (push-msg "OPEN_HELP:!lctl|select")
      $spc|domains    (push-msg "OPEN_HELP:domains")
     $ralt|apps       (push-msg "OPEN_HELP:apps")
  $copilot|bookm      (push-msg "OPEN_HELP:bookmarks")
)

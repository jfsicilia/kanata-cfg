;; Actions
(deflayermap (domains+a_layer)
  a $action_modA+modA
  _ XX
)

;; Bookmarks
(deflayermap (domains+b_layer)
  b $action_modB+modB
  _ XX
)

;; Calendar
(deflayermap (domains+c_layer)
  c $action_modC+modC
  d $action_modC+modD
  y $action_modC+modY
  _ XX
)

;; Definitions
(deflayermap (domains+d_layer)
  d $action_modD+modD
  s $action_modD+modS
  _ XX
)

;; Explorer
(deflayermap (domains+e_layer)
  e $action_modE+modE
  f $action_modE+modF  
  r $action_modE+modR  
  _ XX
)

;; Filter
(deflayermap (domains+f_layer)
  f $action_modF+modF
  _ XX
)

;; Git
(deflayermap (domains+g_layer)
  g $action_modG+modG
  l $action_modG+modL
  _ XX
)

;; Hyperlinks
(deflayermap (domains+h_layer)
  h $action_modH+modH
  o $action_modH+modO
  _ XX
)

;; Info
(deflayermap (domains+i_layer)
  i $action_modI+modI
  _ XX
)

;; Jumps
(deflayermap (domains+j_layer)
  j $action_modJ+modJ
  _ XX
)

;; Keymaps
(deflayermap (domains+k_layer)
  k $action_modK+modK
  _ XX
)

;; Locations
(deflayermap (domains+l_layer)
  l $action_modL+modL
  _ XX
)

;; Mem
(deflayermap (domains+m_layer)
  m $action_modM+modM
  _ XX
)

;; Notebooks
(deflayermap (domains+n_layer)
  n $action_modN+modN
  _ XX
)

;; Output
(deflayermap (domains+o_layer)
  o $action_modO+modO
  _ XX
)

;; Properties
(deflayermap (domains+p_layer)
  p $action_modP+modP
  a $action_modP+modA
  _ XX
)

;; Quickfix
(deflayermap (domains+q_layer)
  q $action_modQ+modQ
  _ XX
)

;; References
(deflayermap (domains+r_layer)
  r $action_modR+modR
  i $action_modR+modI
  o $action_modR+modO
  _ XX
)

;; Symbols
(deflayermap (domains+s_layer)
  s $action_modS+modS
  w $action_modS+modW
  _ XX
)

;; Terminal
(deflayermap (domains+t_layer)
  t       $action_modT+modT
  $toggle $action_modT+toggle
  _ XX
)

;; UI
(deflayermap (domains+u_layer)
  u $action_modU+modU
  g $action_modU+modG
  _ XX
)

;; Virtualization
(deflayermap (domains+v_layer)
  v $action_modV+modV
  _ XX
)

;; Warnings
(deflayermap (domains+w_layer)
  w $action_modW+modW
  _ XX
)

;; Extensions
(deflayermap (domains+x_layer)
  x $action_modX+modX
  _ XX
)

;; History
(deflayermap (domains+y_layer)
  y $action_modY+modY

  $mod;      $action_modY+mod;
  $search    $action_modY+search
  _ XX
)

;; Tests
(deflayermap (domains+z_layer)
  z $action_modZ+modZ
  _ XX
)

;; Commands
(deflayermap (domains+;_layer)
  ; $action_mod;+mod;
  _ XX
)

;; Registries
(deflayermap (domains+'_layer)
  ' $action_mod'+mod'
  _ XX
)

;; Settings
(deflayermap (domains+,_layer)
  , $action_mod,+mod,
  _ XX
)

;; Tags
(deflayermap (domains+._layer)
  . $action_mod.+mod.
  _ XX
)

;; Help
(deflayermap (domains+/_layer)
  / $action_mod/+mod/
  _ XX
)

;; Compare
(deflayermap (domains+\_layer)
  \ (t! sft_switch $action_mod\+mod\ $action_mod\+lsft+mod\ $action_mod\+lsft+mod\)

  j $action_mod\+j
  k $action_mod\+k

  o $action_mod\+o
  p $action_mod\+p

  _ XX
) ;;""

;; Backlinks
(deflayermap (domains+[_layer)
  [ $action_mod[+mod[
  _ XX
) ;;""

;; Outlinks
(deflayermap (domains+]_layer)
  ] $action_mod]+mod]
  a $action_mod]+modA
  _ XX
) ;;""

;; 
(deflayermap (domains+`_layer)
  ` $action_mod`+mod`
  _ XX
)

;; 
(deflayermap (domains+-_layer)
  - $action_mod-+mod-
  _ XX
)

;; Format
(deflayermap (domains+=_layer)
  = $action_mod=+mod=
  _ XX
)


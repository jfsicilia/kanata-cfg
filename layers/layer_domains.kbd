;; Activates corresponding layer.
(deflayermap (domains_layer)
  a     $action_domains+a     
  b     $action_domains+b     
  c     $action_domains+c     
  d     $action_domains+d     
  e     $action_domains+e     
  f     $action_domains+f     
  g     $action_domains+g     
  h     $action_domains+h     
  i     $action_domains+i     
  j     $action_domains+j     
  k     $action_domains+k     
  l     $action_domains+l     
  m     $action_domains+m     
  n     $action_domains+n     
  o     $action_domains+o     
  p     $action_domains+p     
  q     $action_domains+q     
  r     $action_domains+r     
  s     $action_domains+s     
  t     $action_domains+t     
  u     $action_domains+u     
  v     $action_domains+v     
  w     $action_domains+w     
  x     $action_domains+x     
  y     $action_domains+y     
  z     $action_domains+z     
  ;     $action_domains+;     
  '     $action_domains+'     
  ,     $action_domains+,     
  .     $action_domains+.     
  /     $action_domains+/     
  \     $action_domains+\     
  [     $action_domains+[     
  ]     $action_domains+]     
  `     $action_domains+`     
  -     $action_domains+-     
  =     $action_domains+=     
  0     $action_domains+0     
  1     $action_domains+1     
  2     $action_domains+2     
  3     $action_domains+3     
  4     $action_domains+4     
  5     $action_domains+5     
  6     $action_domains+6     
  7     $action_domains+7     
  8     $action_domains+8     
  9     $action_domains+9     
  $omni $action_domains+omni  
) ;;""

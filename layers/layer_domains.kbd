;; Actions
(deflayermap (domains+a_layer)
  a $action_domains+a+a
  _ XX
)

;; Bookmarks
(deflayermap (domains+b_layer)
  b $action_domains+b+b
  _ XX
)

;; Calendar
(deflayermap (domains+c_layer)
  c $action_domains+c+c
  d $action_domains+c+d
  y $action_domains+c+y
  _ XX
)

;; Definitions
(deflayermap (domains+d_layer)
  d $action_domains+d+d
  s $action_domains+d+s
  _ XX
)

;; Explorer
(deflayermap (domains+e_layer)
  e $action_domains+e+e
  f $action_domains+e+f  
  r $action_domains+e+r  
  _ XX
)

;; Filter
(deflayermap (domains+f_layer)
  f $action_domains+f+f
  _ XX
)

;; Git
(deflayermap (domains+g_layer)
  g $action_domains+g+g
  l $action_domains+g+l
  _ XX
)

;; Hyperlinks
(deflayermap (domains+h_layer)
  h $action_domains+h+h
  o $action_domains+h+o
  _ XX
)

;; Info
(deflayermap (domains+i_layer)
  i $action_domains+i+i
  _ XX
)

;; Jumps
(deflayermap (domains+j_layer)
  j $action_domains+j+j
  _ XX
)

;; Keymaps
(deflayermap (domains+k_layer)
  k $action_domains+k+k
  _ XX
)

;; Locations
(deflayermap (domains+l_layer)
  l $action_domains+l+l
  _ XX
)

;; Mem
(deflayermap (domains+m_layer)
  m $action_domains+m+m
  _ XX
)

;; Notebooks
(deflayermap (domains+n_layer)
  n $action_domains+n+n
  _ XX
)

;; Output
(deflayermap (domains+o_layer)
  o $action_domains+o+o
  _ XX
)

;; Properties
(deflayermap (domains+p_layer)
  p $action_domains+p+p
  a $action_domains+p+a
  _ XX
)

;; Quickfix
(deflayermap (domains+q_layer)
  q $action_domains+q+q
  _ XX
)

;; References
(deflayermap (domains+r_layer)
  r $action_domains+r+r
  i $action_domains+r+i
  o $action_domains+r+o
  _ XX
)

;; Symbols
(deflayermap (domains+s_layer)
  s $action_domains+s+s
  w $action_domains+s+w
  _ XX
)

;; Terminal
(deflayermap (domains+t_layer)
  t       $action_domains+t+t
  $toggle $action_domains+t+toggle
  _ XX
)

;; UI
(deflayermap (domains+u_layer)
  u $action_domains+u+u
  g $action_domains+u+g
  _ XX
)

;; Virtualization
(deflayermap (domains+v_layer)
  v $action_domains+v+v
  _ XX
)

;; Warnings
(deflayermap (domains+w_layer)
  w $action_domains+w+w
  _ XX
)

;; Extensions
(deflayermap (domains+x_layer)
  x $action_domains+x+x
  _ XX
)

;; History
(deflayermap (domains+y_layer)
  y $action_domains+y+y

  $mod;      $action_domains+y+;
  $search    $action_domains+y+search
  _ XX
)

;; Tests
(deflayermap (domains+z_layer)
  z $action_domains+z+z
  _ XX
)

;; Commands
(deflayermap (domains+;_layer)
  ; $action_domains+;+;
  _ XX
)

;; Registries
(deflayermap (domains+'_layer)
  ' $action_domains+'+'
  _ XX
)

;; Settings
(deflayermap (domains+,_layer)
  , $action_domains+,+,
  _ XX
)

;; Tags
(deflayermap (domains+._layer)
  . $action_domains+.+.
  _ XX
)

;; Help
(deflayermap (domains+/_layer)
  / $action_domains+/+/
  _ XX
)

;; Compare
(deflayermap (domains+\_layer)
  \ (t! sft_switch $action_domains+\+\ $action_domains+\+lsft+\ $action_domains+\+lsft+\)

  j $action_domains+\+j
  k $action_domains+\+k

  o $action_domains+\+o
  p $action_domains+\+p

  _ XX
) ;;""

;; Backlinks
(deflayermap (domains+[_layer)
  [ $action_domains+[+[
  _ XX
) ;;""

;; Outlinks
(deflayermap (domains+]_layer)
  ] $action_domains+]+]
  a $action_domains+]+a
  _ XX
) ;;""

;; 
(deflayermap (domains+`_layer)
  ` $action_domains+`+`
  _ XX
)

;; 
(deflayermap (domains+-_layer)
  - $action_domains+-+-
  _ XX
)

;; Format
(deflayermap (domains+=_layer)
  = $action_domains+=+=
  _ XX
)


;; Actions
(deflayermap (domains+a_layer)
  a $action_domainA+A
  _ XX
)

;; Bookmarks
(deflayermap (domains+b_layer)
  b $action_domainB+B
  _ XX
)

;; Calendar
(deflayermap (domains+c_layer)
  c $action_domainC+C
  d $action_domainC+D
  y $action_domainC+Y
  _ XX
)

;; Definitions
(deflayermap (domains+d_layer)
  d $action_domainD+D
  s $action_domainD+S
  _ XX
)

;; Explorer
(deflayermap (domains+e_layer)
  e $action_domainE+E
  f $action_domainE+F  
  r $action_domainE+R  
  _ XX
)

;; Filter
(deflayermap (domains+f_layer)
  f $action_domainF+F
  _ XX
)

;; Git
(deflayermap (domains+g_layer)
  g $action_domainG+G
  l $action_domainG+L
  _ XX
)

;; Hyperlinks
(deflayermap (domains+h_layer)
  h $action_domainH+H
  o $action_domainH+O
  _ XX
)

;; Info
(deflayermap (domains+i_layer)
  i $action_domainI+I
  _ XX
)

;; Jumps
(deflayermap (domains+j_layer)
  j $action_domainJ+J
  _ XX
)

;; Keymaps
(deflayermap (domains+k_layer)
  k $action_domainK+K
  _ XX
)

;; Locations
(deflayermap (domains+l_layer)
  l $action_domainL+L
  _ XX
)

;; Mem
(deflayermap (domains+m_layer)
  m $action_domainM+M
  _ XX
)

;; Notebooks
(deflayermap (domains+n_layer)
  n $action_domainN+N
  _ XX
)

;; Output
(deflayermap (domains+o_layer)
  o $action_domainO+O
  _ XX
)

;; Properties
(deflayermap (domains+p_layer)
  p $action_domainP+P
  a $action_domainP+A
  _ XX
)

;; Quickfix
(deflayermap (domains+q_layer)
  q $action_domainQ+Q
  _ XX
)

;; References
(deflayermap (domains+r_layer)
  r $action_domainR+R
  i $action_domainR+I
  o $action_domainR+O
  _ XX
)

;; Symbols
(deflayermap (domains+s_layer)
  s $action_domainS+S
  w $action_domainS+W
  _ XX
)

;; Terminal
(deflayermap (domains+t_layer)
  t       $action_domainT+T
  $toggle $action_domainT+toggle
  _ XX
)

;; UI
(deflayermap (domains+u_layer)
  u $action_domainU+U
  g $action_domainU+G
  _ XX
)

;; Virtualization
(deflayermap (domains+v_layer)
  v $action_domainV+V
  _ XX
)

;; Warnings
(deflayermap (domains+w_layer)
  w $action_domainW+W
  _ XX
)

;; Extensions
(deflayermap (domains+x_layer)
  x $action_domainX+X
  _ XX
)

;; History
(deflayermap (domains+y_layer)
  y $action_domainY+Y

  $mod;      $action_domainY+;
  $search    $action_domainY+search
  _ XX
)

;; Tests
(deflayermap (domains+z_layer)
  z $action_domainZ+Z
  _ XX
)

;; Commands
(deflayermap (domains+;_layer)
  ; $action_domain;+;
  _ XX
)

;; Registries
(deflayermap (domains+'_layer)
  ' $action_domain'+'
  _ XX
)

;; Settings
(deflayermap (domains+,_layer)
  , $action_domain,+,
  _ XX
)

;; Tags
(deflayermap (domains+._layer)
  . $action_domain.+.
  _ XX
)

;; Help
(deflayermap (domains+/_layer)
  / $action_domain/+/
  _ XX
)

;; Compare
(deflayermap (domains+\_layer)
  \ (t! sft_switch $action_domain\+\ $action_domain\+lsft+\ $action_domain\+lsft+\)

  j $action_domain\+j
  k $action_domain\+k

  o $action_domain\+o
  p $action_domain\+p

  _ XX
) ;;""

;; Backlinks
(deflayermap (domains+[_layer)
  [ $action_domain[+[
  _ XX
) ;;""

;; Outlinks
(deflayermap (domains+]_layer)
  ] $action_domain]+]
  a $action_domain]+A
  _ XX
) ;;""

;; 
(deflayermap (domains+`_layer)
  ` $action_domain`+`
  _ XX
)

;; 
(deflayermap (domains+-_layer)
  - $action_domain-+-
  _ XX
)

;; Format
(deflayermap (domains+=_layer)
  = $action_domain=+=
  _ XX
)


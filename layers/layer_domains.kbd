  _ XX
)

;; 
(deflayermap (domains+5_layer)
  5 $action_mod5+mod5
  _ XX
)

;; 
(deflayermap (domains+6_layer)
  6 $action_mod6+mod6
  _ XX
)

;; 
(deflayermap (domains+7_layer)
  7 $action_mod7+mod7
  _ XX
)

;; 
(deflayermap (domains+8_layer)
  8 $action_mod8+mod8
  _ XX
)

;; 

  _ XX
)

;; 
(deflayermap (domains+omni_layer)
  $omni $action_omni+omni
  _ XX
)

;; Activates corresponding layer.
(deflayermap (domains_layer)
  a     (multi (on-press press-vkey vk_domains+A) (on-press tap-vkey vk_help_open))
  b     (multi (on-press press-vkey vk_domains+B) (on-press tap-vkey vk_help_open))
  c     (multi (on-press press-vkey vk_domains+C) (on-press tap-vkey vk_help_open))
  d     (multi (on-press press-vkey vk_domains+D) (on-press tap-vkey vk_help_open))
  e     (multi (on-press press-vkey vk_domains+E) (on-press tap-vkey vk_help_open))
  f     (multi (on-press press-vkey vk_domains+F) (on-press tap-vkey vk_help_open))
  g     (multi (on-press press-vkey vk_domains+G) (on-press tap-vkey vk_help_open))
  h     (multi (on-press press-vkey vk_domains+H) (on-press tap-vkey vk_help_open))
  i     (multi (on-press press-vkey vk_domains+I) (on-press tap-vkey vk_help_open))
  j     (multi (on-press press-vkey vk_domains+J) (on-press tap-vkey vk_help_open))
  k     (multi (on-press press-vkey vk_domains+K) (on-press tap-vkey vk_help_open))
  l     (multi (on-press press-vkey vk_domains+L) (on-press tap-vkey vk_help_open))
  m     (multi (on-press press-vkey vk_domains+M) (on-press tap-vkey vk_help_open))
  n     (multi (on-press press-vkey vk_domains+N) (on-press tap-vkey vk_help_open))
  o     (multi (on-press press-vkey vk_domains+O) (on-press tap-vkey vk_help_open))
  p     (multi (on-press press-vkey vk_domains+P) (on-press tap-vkey vk_help_open))
  q     (multi (on-press press-vkey vk_domains+Q) (on-press tap-vkey vk_help_open))
  r     (multi (on-press press-vkey vk_domains+R) (on-press tap-vkey vk_help_open))
  s     (multi (on-press press-vkey vk_domains+S) (on-press tap-vkey vk_help_open))
  t     (multi (on-press press-vkey vk_domains+T) (on-press tap-vkey vk_help_open))
  u     (multi (on-press press-vkey vk_domains+U) (on-press tap-vkey vk_help_open))
  v     (multi (on-press press-vkey vk_domains+V) (on-press tap-vkey vk_help_open))
  w     (multi (on-press press-vkey vk_domains+W) (on-press tap-vkey vk_help_open))
  x     (multi (on-press press-vkey vk_domains+X) (on-press tap-vkey vk_help_open))
  y     (multi (on-press press-vkey vk_domains+Y) (on-press tap-vkey vk_help_open))
  z     (multi (on-press press-vkey vk_domains+Z) (on-press tap-vkey vk_help_open))
  ;     (multi (on-press press-vkey vk_domains+;) (on-press tap-vkey vk_help_open))
  '     (multi (on-press press-vkey vk_domains+') (on-press tap-vkey vk_help_open))
  ,     (multi (on-press press-vkey vk_domains+,) (on-press tap-vkey vk_help_open))
  .     (multi (on-press press-vkey vk_domains+.) (on-press tap-vkey vk_help_open))
  /     (multi (on-press press-vkey vk_domains+/) (on-press tap-vkey vk_help_open))
  \     (multi (on-press press-vkey vk_domains+\) (on-press tap-vkey vk_help_open))
  [     (multi (on-press press-vkey vk_domains+[) (on-press tap-vkey vk_help_open))
  ]     (multi (on-press press-vkey vk_domains+]) (on-press tap-vkey vk_help_open))
  `     (multi (on-press press-vkey vk_domains+`) (on-press tap-vkey vk_help_open))
  -     (multi (on-press press-vkey vk_domains+-) (on-press tap-vkey vk_help_open))
  =     (multi (on-press press-vkey vk_domains+=) (on-press tap-vkey vk_help_open))
  0     (multi (on-press press-vkey vk_domains+0) (on-press tap-vkey vk_help_open))
  1     (multi (on-press press-vkey vk_domains+1) (on-press tap-vkey vk_help_open))
  2     (multi (on-press press-vkey vk_domains+2) (on-press tap-vkey vk_help_open))
  3     (multi (on-press press-vkey vk_domains+3) (on-press tap-vkey vk_help_open))
  4     (multi (on-press press-vkey vk_domains+4) (on-press tap-vkey vk_help_open))
  5     (multi (on-press press-vkey vk_domains+5) (on-press tap-vkey vk_help_open))
  6     (multi (on-press press-vkey vk_domains+6) (on-press tap-vkey vk_help_open))
  7     (multi (on-press press-vkey vk_domains+7) (on-press tap-vkey vk_help_open))
  8     (multi (on-press press-vkey vk_domains+8) (on-press tap-vkey vk_help_open))
  9     (multi (on-press press-vkey vk_domains+9) (on-press tap-vkey vk_help_open)) ;;""
  $omni (multi (on-press press-vkey vk_domains+omni) (on-press tap-vkey vk_help_open) (on-release tap-vkey vk_help_close)) 
) ;;""

(defvar
;; panes + h | panes + left
colab_action_panes+h                $colab_prev_cell 
;; panes + l | panes + right
colab_action_panes+l                $colab_next_cell
;; panes + k | panes + up
colab_action_panes+k                $colab_prev_cell
;; panes + j | panes + down
colab_action_panes+j                $colab_next_cell
;; == panes + move ======================================================
;; panes + move + h | panes + move + left
colab_action_panes_move_left        $colab_move_cell_up
;; panes + move + l | panes + move + right
colab_action_panes_move_right       $colab_move_cell_down
;; panes + move + k | panes + move + up
colab_action_panes_move_above       $colab_move_cell_up
;; panes + move + j | panes + move + down
colab_action_panes_move_below       $colab_move_cell_down
)

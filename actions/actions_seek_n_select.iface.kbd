(defvar

  ;; == seek_sel ========================================================
  ;; seek_sel + spc 
  action_seek+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_chrome)) $chrome_action_seek+spc break
    ((input virtual vk_zapzap)) $zapzap_action_seek+spc break
    ((input virtual vk_obsidian)) $obsidian_action_seek+spc break
    ((input virtual vk_dolphin)) $dolphin_action_seek+spc break
    ((input virtual vk_firefox)) $firefox_action_seek+spc break
    ((input virtual vk_foot)) $foot_action_seek+spc break
    ((input virtual vk_nvim)) $nvim_action_seek+spc break
    ((input virtual vk_tmux)) $tmux_action_seek+spc break
    () XX break
  ))
  ;; seek_sel + lsft + spc 
  action_seek+lsft+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_chrome)) $chrome_action_seek+lsft+spc break
    ((input virtual vk_obsidian)) $obsidian_action_seek+lsft+spc break
    ((input virtual vk_dolphin)) $dolphin_action_seek+lsft+spc break
    ((input virtual vk_firefox)) $firefox_action_seek+lsft+spc break
    ((input virtual vk_nvim)) $nvim_action_seek+lsft+spc break
    () XX break
  ))
  ;; seek_sel + rsft + spc 
  action_seek+rsft+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_dolphin)) $dolphin_action_seek+rsft+spc break
    () XX break
  ))
)

(defvar
;; This file is intended to be written by the user, and its action
;; dispatch is regenerated by the kanata_sync_apps.py script through the
;; Napp_action templates (see templates.kbd). The name of the action is
;; up to the user; to have the script keep it in sync with which apps
;; implement it, write it as:
;;
;;   (t! Napp_action <name> <default> <app1> <app2> ... <appN>)
;;
;; Example:
;;   (t! 2app_action action_lctl+a XX nvim obsidian)
;;
;; N is the number of apps that implement the action (0app_action for
;; none). <default> is the fallback used when no listed app is focused.
;; Each <appK> is an app name (matching its vk_<app> virtual key),
;; listed in priority order: when more than one app is focused at once
;; (e.g. nvim inside a tmux session), the first one in the list wins.
;; That priority order can be flipped live via the vk_apps_sort_desc
;; virtual key, which the template handles internally.
;;
;; Each app that wants its action autogenerated needs to define
;; <app>_action_<name> (same name as here, with the app prefix) in its
;; own actions/<app>/<app>_<iface>.kbd file. kanata_sync_apps.py scans
;; those files to build the <app1>...<appN> list for each action; the
;; default order of apps in the filename-less case is alphabetical, and
;; can be overridden with a numeric priority suffix on the per-app file
;; (e.g. action_nvim.1.kbd precedes action_chrome.10.kbd).

;; == omni ============================================================

;; ___TO_SET___ yazi_action_omni                   

yazi_action_omni+spc              $yazi_toggle_select

yazi_action_omni+ent              $yazi_pane_preview

yazi_action_omni+bspc             $yazi_remove

yazi_action_omni+a                $yazi_select_all
yazi_action_omni+lsft+a           $yazi_invert_selection
yazi_action_omni+rsft+a           $yazi_invert_selection

;; ___TO_SET___ yazi_action_omni+b                 

yazi_action_omni+c                $yazi_yank
yazi_action_omni+lsft+c           $yazi_copy_path
yazi_action_omni+rsft+c           $yazi_copy_path
yazi_action_omni+c+left           $yazi_pane_copy
yazi_action_omni+c+right          $yazi_pane_copy

yazi_action_omni+d                $yazi_duplicate

yazi_action_omni+e                $yazi_extract
yazi_action_omni+lsft+e           $yazi_compress

;; ___TO_SET___ yazi_action_omni+f                 

yazi_action_omni+g                $yazi_goto_interactive

;; ___TO_SET___ yazi_action_omni+h                 
;; ___TO_SET___ yazi_action_omni+lsft+h            
;; ___TO_SET___ yazi_action_omni+rsft+h            

yazi_action_omni+i                $yazi_spot

;; ___TO_SET___ yazi_action_omni+j                 
;; ___TO_SET___ yazi_action_omni+lsft+j            
;; ___TO_SET___ yazi_action_omni+rsft+j            

;; ___TO_SET___ yazi_action_omni+k                 
;; ___TO_SET___ yazi_action_omni+lsft+k            
;; ___TO_SET___ yazi_action_omni+rsft+k            

;; ___TO_SET___ yazi_action_omni+l                 
;; ___TO_SET___ yazi_action_omni+lsft+l            
;; ___TO_SET___ yazi_action_omni+rsft+l            

;; ___TO_SET___ yazi_action_omni+m                 

yazi_action_omni+n                $yazi_create
yazi_action_omni+lsft+n           $yazi_create_folder
yazi_action_omni+rsft+n           $yazi_bulk_create            

yazi_action_omni+o                $yazi_open 

yazi_action_omni+p                $yazi_parent 

;; ___TO_SET___ yazi_action_omni+q                 

yazi_action_omni+r                $yazi_rename

;; ___TO_SET___ yazi_action_omni+s                 
;; ___TO_SET___ yazi_action_omni+lsft+s            

yazi_action_omni+t                $yazi_new_tab
;; ___TO_SET___ yazi_action_omni+lsft+t            

;; ___TO_SET___ yazi_action_omni+u                 

yazi_action_omni+v                $yazi_paste

yazi_action_omni+w                $yazi_close_tab

yazi_action_omni+x                $yazi_cut
yazi_action_omni+x+left           $yazi_pane_move
yazi_action_omni+x+right          $yazi_pane_move

;; ___TO_SET___ yazi_action_omni+y                 

;; ___TO_SET___ yazi_action_omni+z                 
;; ___TO_SET___ yazi_action_omni+lsft+z            


;; ___TO_SET___ yazi_action_omni+0                 
yazi_action_omni+1                $yazi_tab_1
yazi_action_omni+2                $yazi_tab_2
yazi_action_omni+3                $yazi_tab_3
yazi_action_omni+4                $yazi_tab_4
yazi_action_omni+5                $yazi_tab_5
yazi_action_omni+6                $yazi_tab_6
yazi_action_omni+7                $yazi_tab_7
yazi_action_omni+8                $yazi_tab_8
yazi_action_omni+9                $yazi_tab_9

;; ___TO_SET___ yazi_action_omni+`                 

;; ___TO_SET___ yazi_action_omni+-                 

;; ___TO_SET___ yazi_action_omni+=                 

yazi_action_omni+]                $yazi_forward

yazi_action_omni+[                $yazi_back

;; ___TO_SET___ yazi_action_omni+\                 
;; ___TO_SET___ yazi_action_omni+lsft+\            
;; ___TO_SET___ yazi_action_omni+rsft+\            

;; ___TO_SET___ yazi_action_omni+;                 

yazi_action_omni+'                $yazi_filter

;; ___TO_SET___ yazi_action_omni+,                 

;; ___TO_SET___ yazi_action_omni+.                 

;; ___TO_SET___ yazi_action_omni+/                 

;; ___TO_SET___ yazi_action_omni+!lmet             

;; ___TO_SET___ yazi_action_omni+!lalt             

;; ___TO_SET___ yazi_action_omni+!lctl             

;; ___TO_SET___ yazi_action_omni+ralt              

;; ___TO_SET___ yazi_action_omni+copilot           
)

(defvar
  ;; == sessions =====================================================
  ;; sessions + spc
  action_sessions+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+spc break
    () XX break
  ))
  ;; sessions + toggle
  action_sessions+toggle  (t! unmod_all (switch ;;@iface@
    () XX break
  ))
  action_sessions+d  (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+d break
    () XX break
  ))
  action_sessions+h  (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+h break
    () XX break
  ))
  action_sessions+j  (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+j break
    () XX break
  ))
  action_sessions+k  (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+k break
    () XX break
  ))
  action_sessions+l  (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+l break
    () XX break
  ))
  action_sessions+w  (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+w break
    () XX break
  ))
  action_sessions+r (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_sessions+r break
    () XX break
  ))

)

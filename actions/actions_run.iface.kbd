(defvar
  ;; == run =================================================================
  ;; run + spc
  action_run+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      () (push-msg "NOTIFY: Run not implemented") break
    ) break
    () (switch 
      () (push-msg "NOTIFY: Run not implemented") break
    ) break
  ))
  ;; run + toggle
  action_run+toggle (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      () (push-msg "NOTIFY: Run not implemented") break
    ) break
    () (switch 
      () (push-msg "NOTIFY: Run not implemented") break
    ) break
  ))
)

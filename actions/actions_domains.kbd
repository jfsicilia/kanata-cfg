(defvar
  clipboard_history             M-v
  ai                            (push-msg "NOTIFY: AI")
  action_toggle_bare_layer      (multi (push-msg "OPEN_HELP:bare") (layer-switch bare_layer))  

  activate_domain_actions       (multi (on-press press-vkey vk_domains+a)    $POPUP_HELP)
  activate_domain_bookmarks     (multi (on-press press-vkey vk_domains+b)    $POPUP_HELP)
  activate_domain_calendar      (multi (on-press press-vkey vk_domains+c)    $POPUP_HELP)
  activate_domain_definitions   (multi (on-press press-vkey vk_domains+d)    $POPUP_HELP)
  activate_domain_explorer      (multi (on-press press-vkey vk_domains+e)    $POPUP_HELP)
  activate_domain_filter        (multi (on-press press-vkey vk_domains+f)    $POPUP_HELP)
  activate_domain_git           (multi (on-press press-vkey vk_domains+g)    $POPUP_HELP)
  activate_domain_hyperlinks    (multi (on-press press-vkey vk_domains+h)    $POPUP_HELP)
  activate_domain_info          (multi (on-press press-vkey vk_domains+i)    $POPUP_HELP)
  activate_domain_jumps         (multi (on-press press-vkey vk_domains+j)    $POPUP_HELP)
  activate_domain_keymaps       (multi (on-press press-vkey vk_domains+k)    $POPUP_HELP)
  activate_domain_locations     (multi (on-press press-vkey vk_domains+l)    $POPUP_HELP)
  activate_domain_mem           (multi (on-press press-vkey vk_domains+m)    $POPUP_HELP)
  activate_domain_notebooks     (multi (on-press press-vkey vk_domains+n)    $POPUP_HELP)
  activate_domain_output        (multi (on-press press-vkey vk_domains+o)    $POPUP_HELP)
  activate_domain_properties    (multi (on-press press-vkey vk_domains+p)    $POPUP_HELP)
  activate_domain_quickfix      (multi (on-press press-vkey vk_domains+q)    $POPUP_HELP)
  activate_domain_references    (multi (on-press press-vkey vk_domains+r)    $POPUP_HELP)
  activate_domain_symbols       (multi (on-press press-vkey vk_domains+s)    $POPUP_HELP)
  activate_domain_terminal      (multi (on-press press-vkey vk_domains+t)    $POPUP_HELP)
  activate_domain_UI            (multi (on-press press-vkey vk_domains+u)    $POPUP_HELP)
  activate_domain_virtualization(multi (on-press press-vkey vk_domains+v)    $POPUP_HELP)
  activate_domain_warnings      (multi (on-press press-vkey vk_domains+w)    $POPUP_HELP)
  activate_domain_extensions    (multi (on-press press-vkey vk_domains+x)    $POPUP_HELP)
  activate_domain_history       (multi (on-press press-vkey vk_domains+y)    $POPUP_HELP)
  activate_domain_tests         (multi (on-press press-vkey vk_domains+z)    $POPUP_HELP)
  activate_domain_commands      (multi (on-press press-vkey vk_domains+;)    $POPUP_HELP)
  activate_domain_registries    (multi (on-press press-vkey vk_domains+')    $POPUP_HELP)
  activate_domain_settings      (multi (on-press press-vkey vk_domains+,)    $POPUP_HELP)
  activate_domain_tags          (multi (on-press press-vkey vk_domains+.)    $POPUP_HELP)
  activate_domain_help          (multi (on-press press-vkey vk_domains+/)    $POPUP_HELP)
  activate_domain_compare       (multi (on-press press-vkey vk_domains+\)    $POPUP_HELP)
  activate_domain_backlinks     (multi (on-press press-vkey vk_domains+[)    $POPUP_HELP)
  activate_domain_outlinks      (multi (on-press press-vkey vk_domains+])    $POPUP_HELP)
  activate_domain_`             (multi (on-press press-vkey vk_domains+`)    $POPUP_HELP)
  activate_domain_-             (multi (on-press press-vkey vk_domains+-)    $POPUP_HELP)
  activate_domain_format        (multi (on-press press-vkey vk_domains+=)    $POPUP_HELP)
  activate_domain_0             (multi (on-press press-vkey vk_domains+0)    $POPUP_HELP)
  activate_domain_1             (multi (on-press press-vkey vk_domains+1)    $POPUP_HELP)
  activate_domain_2             (multi (on-press press-vkey vk_domains+2)    $POPUP_HELP)
  activate_domain_3             (multi (on-press press-vkey vk_domains+3)    $POPUP_HELP)
  activate_domain_4             (multi (on-press press-vkey vk_domains+4)    $POPUP_HELP)
  activate_domain_5             (multi (on-press press-vkey vk_domains+5)    $POPUP_HELP)
  activate_domain_6             (multi (on-press press-vkey vk_domains+6)    $POPUP_HELP)
  activate_domain_7             (multi (on-press press-vkey vk_domains+7)    $POPUP_HELP)
  activate_domain_8             (multi (on-press press-vkey vk_domains+8)    $POPUP_HELP)
  activate_domain_9             (multi (on-press press-vkey vk_domains+9)    $POPUP_HELP) ;;""
  activate_domain_AI            (multi (on-press press-vkey vk_domains+omni) $POPUP_HELP) 
  
)
(defvar
  action_domains+a    $activate_domain_actions 
  action_domains+b    $activate_domain_bookmarks
  action_domains+c    $activate_domain_calendar
  action_domains+d    $activate_domain_definitions
  action_domains+e    $activate_domain_explorer
  action_domains+f    $activate_domain_filter
  action_domains+g    $activate_domain_git
  action_domains+h    $activate_domain_hyperlinks
  action_domains+i    $activate_domain_info
  action_domains+j    $activate_domain_jumps
  action_domains+k    $activate_domain_keymaps
  action_domains+l    $activate_domain_locations
  action_domains+m    $activate_domain_mem
  action_domains+n    $activate_domain_notebooks
  action_domains+o    $activate_domain_output
  action_domains+p    $activate_domain_properties
  action_domains+q    $activate_domain_quickfix
  action_domains+r    $activate_domain_references
  action_domains+s    $activate_domain_symbols
  action_domains+t    $activate_domain_terminal
  action_domains+u    $activate_domain_UI
  action_domains+v    $activate_domain_virtualization
  action_domains+w    $activate_domain_warnings
  action_domains+x    $activate_domain_extensions
  action_domains+y    $activate_domain_history
  action_domains+z    $activate_domain_tests
  action_domains+;    $activate_domain_commands
  action_domains+'    $activate_domain_registries
  action_domains+,    $activate_domain_settings
  action_domains+.    $activate_domain_tags
  action_domains+/    $activate_domain_help
  action_domains+\    $activate_domain_compare
  action_domains+[    $activate_domain_backlinks
  action_domains+]    $activate_domain_outlinks
  action_domains+`    $activate_domain_`
  action_domains+-    $activate_domain_-
  action_domains+=    $activate_domain_format
  action_domains+0    $activate_domain_0
  action_domains+1    $activate_domain_1
  action_domains+2    $activate_domain_2
  action_domains+3    $activate_domain_3
  action_domains+4    $activate_domain_4
  action_domains+5    $activate_domain_5
  action_domains+6    $activate_domain_6
  action_domains+7    $activate_domain_7
  action_domains+8    $activate_domain_8
  action_domains+9    $activate_domain_9
  action_domains+omni $activate_domain_AI

  (t! 1app_action action_domains+a+a (push-msg "NOTIFY: Actions not implemented") nvim)

  (t! 2app_action action_domains+b+b (push-msg "NOTIFY: Bookmarks not implemented") nvim obsidian)

  (t! 1app_action action_domains+c+c (push-msg "NOTIFY: Calendar not implemented") obsidian)
  (t! 1app_action action_domains+c+d (push-msg "NOTIFY: Calendar (Day) not implemented") obsidian)
  (t! 1app_action action_domains+c+y (push-msg "NOTIFY: Calendar (Daily) not implemented") obsidian)

  (t! 1app_action action_domains+d+d (push-msg "NOTIFY: Definitions not implemented") nvim)
  (t! 1app_action action_domains+d+s (push-msg "NOTIFY: Definition (Source) not implemented") nvim)
 
  (t! 3app_action action_domains+e+e (push-msg "NOTIFY: Explorer not implemented") dolphin nvim obsidian)
  (t! 1app_action action_domains+e+r (push-msg "NOTIFY: Explorer (Recents) not implemented") obsidian)
  (t! 1app_action action_domains+e+f (push-msg "NOTIFY: Explorer (Find/Focus) not implemented") obsidian)

  (t! 0app_action action_domains+f+f (push-msg "NOTIFY: Filters not implemented"))

  (t! 2app_action action_domains+g+g (push-msg "NOTIFY: Git not implemented") foot nvim)
  (t! 2app_action action_domains+g+l (push-msg "NOTIFY: Git (Lazygit) not implemented") foot nvim)

  (t! 0app_action action_domains+h+h (push-msg "NOTIFY: Hyperlinks not implemented"))
  (t! 2app_action action_domains+h+o (push-msg "NOTIFY: OutLine not implemented") nvim obsidian)

  (t! 1app_action action_domains+i+i (push-msg "NOTIFY: Info not implemented") dolphin)

  (t! 1app_action action_domains+j+j (push-msg "NOTIFY: Jumps not implemented") nvim)

  (t! 6app_action action_domains+k+k (push-msg "NOTIFY: Keymaps not implemented") yazi chrome dolphin firefox nvim tmux)

  (t! 1app_action action_domains+l+l (push-msg "NOTIFY: Locations not implemented") nvim)

  (t! 0app_action action_domains+m+m $clipboard_history)

  (t! 0app_action action_domains+n+n (push-msg "NOTIFY: notebooks not implemented"))

  (t! 0app_action action_domains+o+o (push-msg "NOTIFY: Output not implemented"))

  (t! 1app_action action_domains+p+p (push-msg "NOTIFY: Properties not implemented") obsidian)
  (t! 1app_action action_domains+p+a (push-msg "NOTIFY: Properties All not implemented") obsidian)
  
  (t! 1app_action action_domains+q+q (push-msg "NOTIFY: Quickfix not implemented") nvim)

  (t! 1app_action action_domains+r+r (push-msg "NOTIFY: References not implemented") nvim)
  (t! 1app_action action_domains+r+i (push-msg "NOTIFY: References (Incoming) not implemented") nvim)
  (t! 1app_action action_domains+r+o (push-msg "NOTIFY: References (Outgoing) not implemented") nvim)
  (t! 1app_action action_domains+r+s (push-msg "NOTIFY: Source not implemented") nvim)

  (t! 2app_action action_domains+s+s (push-msg "NOTIFY: Symbols not implemented") nvim obsidian)
  (t! 1app_action action_domains+s+w (push-msg "NOTIFY: Symbols (Workspace) not implemented") nvim)

  (t! 2app_action action_domains+t+t (push-msg "NOTIFY: Terminal not implemented") dolphin nvim)
  (t! 1app_action action_domains+t+toggle (push-msg "NOTIFY: Toggle Terminal not implemented") nvim)

  (t! 0app_action action_domains+u+u (push-msg "NOTIFY: UI not implemented"))
  (t! 1app_action action_domains+u+g (push-msg "NOTIFY: UI Graph not implemented") obsidian)

  (t! 0app_action action_domains+v+v (push-msg "NOTIFY: Virtualization not implemented"))

  (t! 0app_action action_domains+w+w (push-msg "NOTIFY: Warnings not implemented"))

  (t! 0app_action action_domains+x+x (push-msg "NOTIFY: Extensions not implemented"))

  (t! 1app_action action_domains+y+y (push-msg "NOTIFY: History not implemented") nvim)
  (t! 1app_action action_domains+y+; (push-msg "NOTIFY: History (commands) not implemented") nvim)
  (t! 1app_action action_domains+y+search (push-msg "NOTIFY: History search not implemented") nvim)

  (t! 0app_action action_domains+z+z (push-msg "NOTIFY: Tests not implemented"))

  (t! 0app_action action_domains+`+` (push-msg "NOTIFY: mod` not implemented"))

  (t! 0app_action action_domains+-+- (push-msg "NOTIFY: mod- not implemented"))

  (t! 0app_action action_domains+=+= (push-msg "NOTIFY: Format not implemented"))

  (t! 1app_action action_domains+[+[ (push-msg "NOTIFY: Backlinks not implemented") obsidian)

  (t! 1app_action action_domains+]+] (push-msg "NOTIFY: Outlinks not implemented") obsidian)
  (t! 1app_action action_domains+]+a (push-msg "NOTIFY: Outlinks All not implemented") obsidian)

  (t! 2app_action action_domains+\+\ (push-msg "NOTIFY: Toggle compare files not implemented") foot nvim)
  (t! 1app_action action_domains+\+lsft+\ (push-msg "NOTIFY: Toggle compare folders not implemented") foot)
  (t! 1app_action action_domains+\+j (push-msg "NOTIFY: Compare next not implemented") nvim)
  (t! 1app_action action_domains+\+k (push-msg "NOTIFY: Compare before not implemented") nvim)
  (t! 1app_action action_domains+\+o (push-msg "NOTIFY: Compare obtain not implemented") nvim)
  (t! 1app_action action_domains+\+p (push-msg "NOTIFY: Compare push not implemented") nvim)

  (t! 4app_action action_domains+;+; (push-msg "NOTIFY: Commands not implemented") colab nvim obsidian tmux)

  (t! 1app_action action_domains+'+' (push-msg "NOTIFY: Registries not implemented") nvim)

  (t! 8app_action action_domains+,+, (push-msg "NOTIFY: Settings not implemented") whatsapp yazi chrome dolphin firefox nvim obsidian zapzap)
  (t! 1app_action action_domains+,+r (push-msg "NOTIFY: Reload Settings not implemented") tmux)

  (t! 2app_action action_domains+.+. (push-msg "NOTIFY: Tags not implemented") dolphin nvim)

  (t! 3app_action action_domains+/+/ (push-msg "NOTIFY: Help not implemented") yazi dolphin nvim)
  action_domains+/+k $action_toggle_bare_layer 

  (t! 0app_action action_domains+0+0 (push-msg "NOTIFY: mod0 not implemented"))

  (t! 0app_action action_domains+1+1 (push-msg "NOTIFY: mod1 not implemented"))

  (t! 0app_action action_domains+2+2 (push-msg "NOTIFY: mod2 not implemented"))

  (t! 0app_action action_domains+3+3 (push-msg "NOTIFY: mod3 not implemented"))

  (t! 0app_action action_domains+4+4 (push-msg "NOTIFY: mod4 not implemented"))

  (t! 0app_action action_domains+5+5 (push-msg "NOTIFY: mod5 not implemented"))

  (t! 0app_action action_domains+6+6 (push-msg "NOTIFY: mod6 not implemented"))

  (t! 0app_action action_domains+7+7 (push-msg "NOTIFY: mod7 not implemented"))

  (t! 0app_action action_domains+8+8 (push-msg "NOTIFY: mod8 not implemented"))

  (t! 0app_action action_domains+9+9 (push-msg "NOTIFY: mod9 not implemented"))

  (t! 1app_action action_domains+omni+omni $ai nvim)
  (t! 1app_action action_domains+omni+a (push-msg "NOTIFY: Sidekick select agent not implemented") nvim)
  (t! 1app_action action_domains+omni+c (push-msg "NOTIFY: Sidekick toggle Claude not implemented") nvim)
  (t! 1app_action action_domains+omni+s (push-msg "NOTIFY: Sidekick send selection not implemented") nvim)
  (t! 1app_action action_domains+omni+f (push-msg "NOTIFY: Sidekick send file not implemented") nvim)
  (t! 1app_action action_domains+omni+p (push-msg "NOTIFY: Sidekick prompt not implemented") nvim)
  (t! 1app_action action_domains+omni+d (push-msg "NOTIFY: Sidekick close CLI session not implemented") nvim)
)

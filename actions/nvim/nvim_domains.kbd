(defvar
;; modD + modS
nvim_action_modD+modS                $nvim_source
;; modR + modS
nvim_action_modR+modS                 $nvim_source
;; modA + modA
nvim_action_modA+modA                $nvim_autocommands
;; modB + modB
nvim_action_modB+modB                $nvim_bookmarks
;; modD + modD
nvim_action_modD+modD                $nvim_definitions
;; modE + modE
nvim_action_modE+modE                $nvim_file_explorer  
;; modG + modG
nvim_action_modG+modG                $nvim_git  ;;""
;; modG + modL
nvim_action_modG+modL                $nvim_lazygit
;; modJ + modJ
nvim_action_modJ+modJ                $nvim_jumps
;; modK + modK
nvim_action_modK+modK                $nvim_keymaps
;; modL + modL
nvim_action_modL+modL                $nvim_locations
;; modQ + modQ
nvim_action_modQ+modQ                 $nvim_quickfix
;; modR + modR
nvim_action_modR+modR                 $nvim_references
;; modR + modI
nvim_action_modR+modI                 $nvim_references_incoming
;; modR + modO
nvim_action_modR+modO                 $nvim_references_outgoing
;; modS + modS
nvim_action_modS+modS                 $nvim_symbols
;; modS + modW
nvim_action_modS+modW                 $nvim_symbols_workspace
;; modT + modT
nvim_action_modT+modT                 $nvim_terminal 
;; modT + toggle
nvim_action_modT+toggle               $nvim_terminal
;; modY + modY
nvim_action_modY+modY                $nvim_history  ;;""
;; modY + mod;
nvim_action_modY+mod;          $nvim_history_commands  ;;""
;; modY + search
nvim_action_modY+search         $nvim_history_search  ;;""
;; mod\ + mod\
nvim_action_mod\+mod\                   $nvim_compare_toggle 
;; mod\ + j
nvim_action_mod\+j                 $nvim_compare_next
;; mod\ + k
nvim_action_mod\+k                 $nvim_compare_prev  ;;""
;; mod\ + o
nvim_action_mod\+o                 $nvim_compare_obtain  ;; Obtain changes from the other file.
;; mod\ + p
nvim_action_mod\+p                 $nvim_compare_push  ;; Push changes to the other file.""
;; mod; + mod;
nvim_action_mod;+mod;              $nvim_commands   ;;""
;; mod' + mod'
nvim_action_mod'+mod'              $nvim_registers
;; mod, + mod,
nvim_action_mod,+mod,              $nvim_settings
;; mod. + mod.
nvim_action_mod.+mod.              $nvim_tags  ;;""
;; mod/ + mod/
nvim_action_mod/+mod/              $nvim_help
)

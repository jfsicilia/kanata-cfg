(defvar
;; tabs + spc
nvim_action_tabs+spc                       $nvim_open_buffers 
;; tabs + l | tabs + right | lsft + rsft | 2x rsft | !lmet + tab
;; If not implemented, defaults to: C-tab
nvim_action_tabs_next                      $nvim_tabs_next 
;; tabs + h | tabs + left | rsft + lsft | 2x lsft | !lmet + sft + tab
;; If not implemented, defaults to: C-S-tab
nvim_action_tabs_prev                      $nvim_tabs_prev 
;; tabs + w
;; If not implemented, defaults to: C-w
;; tabs + v
nvim_action_tabs_close                      $nvim_close_tab
;; == tabs go by number ==================================================
;; tabs + 1
;; If not implemented, defaults to: C-1
nvim_action_tabs_goto_1                     $nvim_tab_1
;; tabs + 2
;; If not implemented, defaults to: C-2
nvim_action_tabs_goto_2                     $nvim_tab_2
;; tabs + 3
;; If not implemented, defaults to: C-3
nvim_action_tabs_goto_3                     $nvim_tab_3
;; tabs + 4
;; If not implemented, defaults to: C-4
nvim_action_tabs_goto_4                     $nvim_tab_4
;; tabs + 5
;; If not implemented, defaults to: C-5
nvim_action_tabs_goto_5                     $nvim_tab_5
;; tabs + 6
;; If not implemented, defaults to: C-6
nvim_action_tabs_goto_6                     $nvim_tab_6
;; tabs + 7
;; If not implemented, defaults to: C-7
nvim_action_tabs_goto_7                     $nvim_tab_7
;; tabs + 8
;; If not implemented, defaults to: C-8
nvim_action_tabs_goto_8                     $nvim_tab_8
;; tabs + 9
;; If not implemented, defaults to: C-9
;; nvim_action_tabs_goto_last                  `{esc}:blast{ent}`
nvim_action_tabs_goto_last                  $nvim_tab_9 
;; == tabs + toggle =====================================================
;; tabs + toggle | 2x !lctl
;; == tab + toggle =====================================================
nvim_action_tabs+toggle                     $nvim_toggle_tab
)

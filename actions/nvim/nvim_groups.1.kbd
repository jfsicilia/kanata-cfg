(defvar
;; groups + spc
nvim_action_groups+spc                  $nvim_action_tabs                  
;; groups + l | groups + right
nvim_action_groups+l             $nvim_action_tabs+l             
;; groups + h | groups + left
nvim_action_groups+h             $nvim_action_tabs+h             
;; groups + w
nvim_action_groups+w            $nvim_action_tabs+w            
;; == groups go by number ==================================================
;; groups + 1
nvim_action_groups+1           $nvim_action_tabs+1           
;; groups + 2
nvim_action_groups+2           $nvim_action_tabs+2           
;; groups + 3
nvim_action_groups+3           $nvim_action_tabs+3           
;; groups + 4
nvim_action_groups+4           $nvim_action_tabs+4           
;; groups + 5
nvim_action_groups+5           $nvim_action_tabs+5           
;; groups + 6
nvim_action_groups+6           $nvim_action_tabs+6           
;; groups + 7
nvim_action_groups+7           $nvim_action_tabs+7           
;; groups + 8
nvim_action_groups+8           $nvim_action_tabs+8           
;; groups + 9
nvim_action_groups+9        $nvim_action_tabs+9        
;; == groups + toggle =====================================================
;; groups + toggle
nvim_action_groups+toggle           $nvim_action_tabs+toggle           
)

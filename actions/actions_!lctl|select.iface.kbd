(defvar
  ;; == !LCTL|SELECT actions ==========================================================

  ;; !lctl|select + spc 
  action_!lctl|select+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_tmux)) $tmux_action_!lctl|select+spc break
      ((input virtual vk_nvim)) $nvim_action_!lctl|select+spc break
      ((input virtual vk_foot)) $foot_action_!lctl|select+spc break
      ((input virtual vk_firefox)) $firefox_action_!lctl|select+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lctl|select+spc break
      ((input virtual vk_obsidian)) $obsidian_action_!lctl|select+spc break
      ((input virtual vk_zapzap)) $zapzap_action_!lctl|select+spc break
      ((input virtual vk_chrome)) $chrome_action_!lctl|select+spc break
      ((input virtual vk_whatsapp)) $whatsapp_action_!lctl|select+spc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_whatsapp)) $whatsapp_action_!lctl|select+spc break
      ((input virtual vk_chrome)) $chrome_action_!lctl|select+spc break
      ((input virtual vk_zapzap)) $zapzap_action_!lctl|select+spc break
      ((input virtual vk_obsidian)) $obsidian_action_!lctl|select+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lctl|select+spc break
      ((input virtual vk_firefox)) $firefox_action_!lctl|select+spc break

  ))

  ;; omni + r
  action_omni+r (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+r break
    ((input virtual vk_dolphin)) $dolphin_action_omni+r break
    ((input virtual vk_nvim)) $nvim_action_omni+r break
    ((input virtual vk_tmux)) $tmux_action_omni+r break
    () XX break
  ))

  ;; omni + s
  action_omni+s (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+s break
    ((input virtual vk_nvim)) $nvim_action_omni+s break
    ((input virtual vk_tmux)) $tmux_action_omni+s break
    () XX break
  ))
  ;; omni + lsft + s | omni + rsft + s
  action_omni+lsft+s (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+lsft+s break
    ((input virtual vk_nvim)) $nvim_action_omni+lsft+s break
    ((input virtual vk_tmux)) $tmux_action_omni+lsft+s break
    () XX break
  ))

  ;; omni + t
  ;; If not implemented, defaults to: action_tabs+t
  action_omni+t (t! unmod_all (switch ;;@iface@

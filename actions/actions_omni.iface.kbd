  ))
  ;; omni + 4
  ;; If not implemented, defaults to: C-4
  action_omni+4 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zapzap)) $zapzap_action_omni+4 break
    ((input virtual vk_dolphin)) $dolphin_action_omni+4 break
    ((input virtual vk_nvim)) $nvim_action_omni+4 break
    ((input virtual vk_tmux)) $tmux_action_omni+4 break

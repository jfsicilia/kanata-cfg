  ;; omni + 1
  ;; If not implemented, defaults to: C-1
  action_omni+1 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zapzap)) $zapzap_action_omni+1 break
    ((input virtual vk_dolphin)) $dolphin_action_omni+1 break
    ((input virtual vk_nvim)) $nvim_action_omni+1 break

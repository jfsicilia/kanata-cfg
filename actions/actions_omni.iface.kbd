  ))
  ;; omni + lsft + t
  ;; If not implemented, defaults to: action_tabs+lsft+t
  action_omni+lsft+t (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+lsft+t break
    ((input virtual vk_nvim)) $nvim_action_omni+lsft+t break
    ((input virtual vk_tmux)) $tmux_action_omni+lsft+t break
    () $action_tabs+lsft+t break
  ))

  ;; omni + u
  action_omni+u (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+u break
    ((input virtual vk_nvim)) $nvim_action_omni+u break
    ((input virtual vk_tmux)) $tmux_action_omni+u break

(defvar
  ;; Navigation / Edit
  cancel          esc
  space           spc
  delete          del
  page_up         pgup
  page_down       pgdn
  nav_left        left
  nav_down        down
  nav_up          up
  nav_right       right
  nav_next        right
  nav_prev        left
  undo            C-z
  redo            C-S-z
  ;; Clipboard
  copy            C-c
  copy_path       C-S-c
  paste           C-v
  cut             C-x
  ;; Other operations
  window_close    $windows_close
  settings        $action_domain,+,
  tags            $action_domain.+.
  help            $action_domain/+/
  panes_toggle    $action_panes+toggle
  tabs_toggle     $action_tabs+toggle
  apps_toggle     $windows_toggle 
  groups_toggle   $~action_groups+toggle
  sessions_toggle $action_sessions+toggle
)

(defvar
  ;; This file is intended to be written by the user, and some parts of it
  ;; can be autogenerated by the kananta_sync_actions.py script. The name
  ;; of the action is up to the user, but if you want the script to
  ;; autogenerate some parts, the action must follow the following format:
  ;;
  ;; [!| ]action_<name_of_action> ... (switch  ;;@iface@
  ;;   ...
  ;; [)]+
  ;;
  ;; Example:
  ;; action_lctl+a (switch ;;@iface@ 
  ;;   ;; Next 2 lines will be deleted and autogenerated by kanata_sync_actions.py
  ;;   ((input virtual vk_nvim)) $nvim_action_lctl+a break
  ;;   ((input virtual vk_obsidian)) $obsidian_action_lctl+a break
  ;;   () _ break
  ;; )
  ;;
  ;; The goal of autogenerated action content is to create the conditions
  ;; of a switch statement to dynamically determine which action to issue,
  ;; depending on the active application. When an app gains focus, kanata
  ;; will receive a message to press a virtual key; each app has its own
  ;; virtual key (e.g. vk_chrome).
  ;; NOTE: ;;@iface@ is the tag required to autogenerate the
  ;; switch conditions. Without it, nothing will be autogenerated
  ;; for the action.
  ;;
  ;; Each app that wants its actions to be autogenerated needs to define
  ;; an action_<app>.kbd file in the actions folder. There, it defines each
  ;; action with the same name as in this file, but with the app prefix. The
  ;; file will have the following content:
  ;;
  ;; (defvar
  ;; <app>_action_<name_of_action1>
  ;; <app>_action_<name_of_action2>
  ;; ...
  ;; )
  ;;
  ;; kanata can receive more than one active application at the same time,
  ;; pressing more than one app virtual key (e.g. nvim inside a tmux session
  ;; could press vk_nvim and vk_tmux, depending on the software communicating
  ;; with kanata).
  ;;
  ;; When executing an action, the first app virtual key that matches in the
  ;; switch statement will run its action. The default order of apps is
  ;; alphabetical. To change the default order, an order index can be set
  ;; in the app action file (action_<app>.<index>.kbd). For example:
  ;;
  ;;   action_chrome.10.kbd
  ;;   action_nvim.1.kbd
  ;;
  ;; In this case, nvim will precede chrome in the switch statements.
  ;;
  ;; Sometimes you may want to have an alternate behavior, giving the
  ;; opposite precedence to the apps. In order to achieve that, you can
  ;; reverse the order of the autogenerated conditions.
  ;; Prefixing actions with ! (think of ! as "alternate"), in an autogen-
  ;; marked action, will reverse the order of the conditions.
  ;;
  ;; This will allow, for example, the following use case:
  ;;
  ;; You have a terminal running nvim inside tmux. You would like
  ;; to bind a combo for selecting a pane. Both tmux and nvim support
  ;; panes. You want a combo to work with both apps when they are not active
  ;; at the same time, and when they are active at the same time, the usual
  ;; combo will work for one, and an alternate combo will work for the other.
  ;;
  ;; action_pane+h (t! unmod_all (switch ;;@iface@
  ;;   ((input virtual vk_nvim)) $nvim_action_pane+h break
  ;;   ((input virtual vk_tmux)) $tmux_action_pane+h break
  ;;   () XX break
  ;; ))
  ;; ~action_pane+h (t! unmod_all (switch ;;@iface@
  ;;   ((input virtual vk_tmux)) $tmux_action_pane+h break
  ;;   ((input virtual vk_nvim)) $nvim_action_pane+h break
  ;;   () XX break
  ;; ))
  ;;
  ;; The default combo will be bound to action_..., working when apps are
  ;; activated separately and giving precedence to one when both are activated
  ;; at the same time. The alternate combo will be bound to ~action_...,
  ;; giving precedence to the other app when both apps are active.


  ;; == omni ============================================================

  ;; omni
  ;; If not implemented, defaults to: esc
  action_omni (t! unmod_all (switch ;;@iface@
    ((input virtual vk_colab)) $colab_action_omni break
    () $cancel break
  ))

  ;; omni + spc
  ;; If not implemented, defaults to: spc
  action_omni+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+spc break
    ((input virtual vk_dolphin)) $dolphin_action_omni+spc break
    ((input virtual vk_nvim)) $nvim_action_omni+spc break
    ((input virtual vk_tmux)) $tmux_action_omni+spc break
    () $space break
  ))

  ;; omni + ent
  action_omni+ent (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+ent break
    ((input virtual vk_nvim)) $nvim_action_omni+ent break
    ((input virtual vk_tmux)) $tmux_action_omni+ent break
    () XX break
  ))

  ;; omni + bcsp
  action_omni+bcsp (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+bcsp break
    ((input virtual vk_colab)) $colab_action_omni+bcsp break
    () $delete break
  ))

  ;; omni + a
  action_omni+a (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+a break
    ((input virtual vk_dolphin)) $dolphin_action_omni+a break
    ((input virtual vk_nvim)) $nvim_action_omni+a break
    ((input virtual vk_tmux)) $tmux_action_omni+a break
    () XX break
  ))
  ;; omni + lsft + a
  action_omni+lsft+a (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+lsft+a break
    ((input virtual vk_dolphin)) $dolphin_action_omni+lsft+a break
    ((input virtual vk_nvim)) $nvim_action_omni+lsft+a break
    ((input virtual vk_tmux)) $tmux_action_omni+lsft+a break
    () XX break
  ))
  ;; omni + rsft + a
  action_omni+rsft+a (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+rsft+a break
    ((input virtual vk_dolphin)) $dolphin_action_omni+rsft+a break
    ((input virtual vk_nvim)) $nvim_action_omni+rsft+a break
    ((input virtual vk_tmux)) $tmux_action_omni+rsft+a break
    () XX break
  ))

  ;; omni + b
  ;; If not implemented, defaults to: pgup
  action_omni+b (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+b break
    ((input virtual vk_nvim)) $nvim_action_omni+b break
    ((input virtual vk_tmux)) $tmux_action_omni+b break
    ((input virtual vk_foot)) $foot_action_omni+b break
    () $page_up break
  ))

  ;; omni + c
  ;; If not implemented, defaults to: C-c
  action_omni+c (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+c break
    ((input virtual vk_dolphin)) $dolphin_action_omni+c break
    ((input virtual vk_nvim)) $nvim_action_omni+c break
    ((input virtual vk_tmux)) $tmux_action_omni+c break
    ((input virtual vk_foot)) $foot_action_omni+c break
    () $copy break
  ))
  ;; omni + lsft + c
  ;; If not implemented, defaults to: C-S-c
  action_omni+lsft+c (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+lsft+c break
    ((input virtual vk_nvim)) $nvim_action_omni+lsft+c break
    ((input virtual vk_tmux)) $tmux_action_omni+lsft+c break
    () $copy_path break
  ))
  ;; omni + rsft + c
  ;; If not implemented, defaults to: C-S-c
  action_omni+rsft+c (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+rsft+c break
    ((input virtual vk_nvim)) $nvim_action_omni+rsft+c break
    ((input virtual vk_tmux)) $tmux_action_omni+rsft+c break
    () $copy_path break
  ))
  ;; omni + c + left
  action_omni+c+left (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+c+left break
    ((input virtual vk_nvim)) $nvim_action_omni+c+left break
    ((input virtual vk_tmux)) $tmux_action_omni+c+left break
    () XX break
  ))
  ;; omni + c + right
  action_omni+c+right (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+c+right break
    ((input virtual vk_nvim)) $nvim_action_omni+c+right break
    ((input virtual vk_tmux)) $tmux_action_omni+c+right break
    () XX break
  ))

  ;; omni + d
  action_omni+d (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+d break
    ((input virtual vk_dolphin)) $dolphin_action_omni+d break
    ((input virtual vk_nvim)) $nvim_action_omni+d break
    ((input virtual vk_tmux)) $tmux_action_omni+d break
    () XX break
  ))

  ;; omni + e
  action_omni+e (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+e break
    ((input virtual vk_nvim)) $nvim_action_omni+e break
    ((input virtual vk_tmux)) $tmux_action_omni+e break
    ((input virtual vk_foot)) $foot_action_omni+e break
    () XX break
  ))
  ;; omni + lsft + e
  action_omni+lsft+e (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+lsft+e break
    ((input virtual vk_nvim)) $nvim_action_omni+lsft+e break
    ((input virtual vk_tmux)) $tmux_action_omni+lsft+e break
    ((input virtual vk_foot)) $foot_action_omni+lsft+e break

  ;; omni + i
  action_omni+i (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+i break
    ((input virtual vk_nvim)) $nvim_action_omni+i break
    ((input virtual vk_tmux)) $tmux_action_omni+i break
    () XX break
  ))

  ;; omni + j
  ;; If not implemented, defaults to: down
  action_omni+j (switch ;;@iface@

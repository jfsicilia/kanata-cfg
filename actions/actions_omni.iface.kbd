    ((input virtual vk_nvim)) $nvim_action_omni+x+left break
    ((input virtual vk_tmux)) $tmux_action_omni+x+left break
    () XX break
  ))
  ;; omni + x + right
  action_omni+x+right (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+x+right break
    ((input virtual vk_nvim)) $nvim_action_omni+x+right break
    ((input virtual vk_tmux)) $tmux_action_omni+x+right break
    () XX break
  ))
  
  ;; omni + y
  action_omni+y (t! unmod_all (switch ;;@iface@

    ((input virtual vk_dolphin)) $dolphin_action_omni+p break
    ((input virtual vk_nvim)) $nvim_action_omni+p break
    ((input virtual vk_tmux)) $tmux_action_omni+p break
    () $nav_prev break
  ))

  ;; omni + q
  ;; If not implemented, defaults to: action_windows_close
  action_omni+q (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zapzap)) $zapzap_action_omni+q break
    ((input virtual vk_nvim)) $nvim_action_omni+q break

  action_omni+l (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_omni+l break
    () $nav_right break
  )

  ;; omni + m
  ;; If not implemented, defaults to: action_domainM+M
  action_omni+m (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_omni+m break
    () $clipboard_history break
  ))

  ;; omni + n
  action_omni+n (t! unmod_all (switch ;;@iface@
    ((input virtual vk_chrome)) $chrome_action_omni+n break
    ((input virtual vk_zapzap)) $zapzap_action_omni+n break
    ((input virtual vk_obsidian)) $obsidian_action_omni+n break
    ((input virtual vk_dolphin)) $dolphin_action_omni+n break
    ((input virtual vk_firefox)) $firefox_action_omni+n break
    ((input virtual vk_colab)) $colab_action_omni+n break
    ((input virtual vk_nvim)) $nvim_action_omni+n break
    ((input virtual vk_tmux)) $tmux_action_omni+n break
    () XX break
  ))
  ;; omni + lsft + n
  action_omni+lsft+n (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zapzap)) $zapzap_action_omni+lsft+n break
    ((input virtual vk_obsidian)) $obsidian_action_omni+lsft+n break
    ((input virtual vk_dolphin)) $dolphin_action_omni+lsft+n break
    ((input virtual vk_colab)) $colab_action_omni+lsft+n break
    ((input virtual vk_nvim)) $nvim_action_omni+lsft+n break
    ((input virtual vk_tmux)) $tmux_action_omni+lsft+n break
    () XX break
  ))
  ;; omni + rsft + n
  action_omni+rsft+n (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zapzap)) $zapzap_action_omni+rsft+n break
    ((input virtual vk_obsidian)) $obsidian_action_omni+rsft+n break
    ((input virtual vk_dolphin)) $dolphin_action_omni+rsft+n break
    ((input virtual vk_colab)) $colab_action_omni+rsft+n break
    ((input virtual vk_nvim)) $nvim_action_omni+rsft+n break
    ((input virtual vk_tmux)) $tmux_action_omni+rsft+n break

  action_omni+3 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zapzap)) $zapzap_action_omni+3 break
    ((input virtual vk_dolphin)) $dolphin_action_omni+3 break
    ((input virtual vk_nvim)) $nvim_action_omni+3 break

    ((input virtual vk_tmux)) $tmux_action_omni+z break
    () $undo break
  ))
  ;; omni + lsft + z
  ;; If not implemented, defaults to: C-S-z
  action_omni+lsft+z (t! unmod_all (switch ;;@iface@

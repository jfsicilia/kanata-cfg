  ))

  ;; omni + f
  ;; If not implemented, defaults to: pgdn
  action_omni+f (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_omni+f break
    ((input virtual vk_nvim)) $nvim_action_omni+f break
    ((input virtual vk_tmux)) $tmux_action_omni+f break
    ((input virtual vk_foot)) $foot_action_omni+f break
    () $page_down break
  ))

  ;; omni + g
  action_omni+g (t! unmod_all (switch ;;@iface@
    ((input virtual vk_chrome)) $chrome_action_omni+g break
    ((input virtual vk_zapzap)) $zapzap_action_omni+g break
    ((input virtual vk_obsidian)) $obsidian_action_omni+g break
    ((input virtual vk_dolphin)) $dolphin_action_omni+g break
    ((input virtual vk_firefox)) $firefox_action_omni+g break
    ((input virtual vk_nvim)) $nvim_action_omni+g break
    ((input virtual vk_tmux)) $tmux_action_omni+g break

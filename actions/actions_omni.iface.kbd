  ;; omni + 0
  ;; If not implemented, defaults to: C-0
  action_omni+0 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_omni+0 break
    ((input virtual vk_nvim)) $nvim_action_omni+0 break

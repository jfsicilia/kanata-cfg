(defvar
  action_help+d (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_help+d break
    () XX break
  ))
  action_help+i (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_help+i break
    () XX break
  ))
  action_help+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_help+spc break
    () XX break
  ))
)

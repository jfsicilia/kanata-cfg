(defvar
;; omni + g
zapzap_action_omni+g                 $zapzap_omni_search
;; omni + n
zapzap_action_omni+n                 $zapzap_new_chat
;; omni + lsft + n
zapzap_action_omni+lsft+n            $zapzap_new_group
;; omni + rsft + n
zapzap_action_omni+rsft+n            $zapzap_new_group
;; omni + q
;; If not implemented, defaults to: action_windows_close
zapzap_action_omni+q                 $zapzap_quit
;; omni + 1
;; If not implemented, defaults to: C-1
zapzap_action_omni+1                 $zapzap_tabs_goto_1
;; omni + 2
;; If not implemented, defaults to: C-2
zapzap_action_omni+2                 $zapzap_tabs_goto_2
;; omni + 3
;; If not implemented, defaults to: C-3
zapzap_action_omni+3                 $zapzap_tabs_goto_3
;; omni + 4
;; If not implemented, defaults to: C-4
zapzap_action_omni+4                 $zapzap_tabs_goto_4
;; omni + 5
;; If not implemented, defaults to: C-5
zapzap_action_omni+5                 $zapzap_tabs_goto_5
;; omni + 6
;; If not implemented, defaults to: C-6
zapzap_action_omni+6                 $zapzap_tabs_goto_6
;; omni + 7
;; If not implemented, defaults to: C-7
zapzap_action_omni+7                 $zapzap_tabs_goto_7
;; omni + 8
;; If not implemented, defaults to: C-8
zapzap_action_omni+8                 $zapzap_tabs_goto_8
;; omni + 9
;; If not implemented, defaults to: C-9
zapzap_action_omni+9                 $zapzap_tabs_goto_9
;; omni + ,
;; If not implemented, defaults to: action_domain,+,
zapzap_action_omni+,                 $zapzap_settings
)

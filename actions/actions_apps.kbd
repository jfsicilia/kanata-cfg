  action_apps+lsft+q       $apps_not_bound
  action_apps+lsft+r       $apps_not_bound
  action_apps+lsft+s       $apps_not_bound
  action_apps+lsft+t       $apps_telegram
  action_apps+lsft+lsft+t  $apps_not_bound
  action_apps+lsft+rsft+t  $apps_not_bound

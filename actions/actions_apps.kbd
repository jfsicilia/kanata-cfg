(defvar
  apps_app_finder      (t! unmod_all RA-spc)
  apps_recent_files    (t! unmod_all (cmd recent_files.sh))

  apps_chrome_misc     (t! unmod_all (push-msg "APP:chromeMisc"))
  apps_chrome_mgmt     (t! unmod_all (push-msg "APP:chromeMgmt"))
  apps_chrome_cloud    (t! unmod_all (push-msg "APP:chromeCloud"))
  apps_chrome_ai       (t! unmod_all (push-msg "APP:chromeAI"))
  apps_chrome_banks    (t! unmod_all (push-msg "APP:chromeBanks"))
  apps_chrome_misc1    (t! unmod_all (push-msg "APP:chromeMisc1"))
  apps_chrome_misc2    (t! unmod_all (push-msg "APP:chromeMisc2"))
  apps_chrome_misc3    (t! unmod_all (push-msg "APP:chromeMisc3"))
  apps_chrome_misc4    (t! unmod_all (push-msg "APP:chromeMisc4"))
  apps_chrome_whatsapp (t! unmod_all (push-msg "APP:chromeWhatsapp"))
  apps_chrome_colab    (t! unmod_all (push-msg "APP:chromeColab"))
  apps_claude_code     (t! unmod_all (push-msg "APP:claude_code"))
  apps_fileexplorer    (t! unmod_all (push-msg "APP:fileexplorer"))
  apps_firefox         (t! unmod_all (push-msg "APP:firefox"))
  apps_keepassxc       (t! unmod_all (push-msg "APP:keepassxc"))
  apps_chrome          (t! unmod_all (push-msg "APP:chrome"))
  apps_obsidian        (t! unmod_all (push-msg "APP:obsidian"))
  apps_sketchup        (t! unmod_all (push-msg "APP:sketchup"))
  apps_terminal        (t! unmod_all (push-msg "APP:terminal"))
  apps_nvim            (t! unmod_all (push-msg "APP:nvim"))
  apps_zapzap          (t! unmod_all (push-msg "APP:zapzap"))
  apps_tmux            (t! unmod_all (push-msg "APP:tmux"))
  apps_firefox_misc    (t! unmod_all (push-msg "APP:firefoxMisc"))
  apps_firefox_mgmt    (t! unmod_all (push-msg "APP:firefoxMgmt"))
  apps_firefox_cloud   (t! unmod_all (push-msg "APP:firefoxCloud"))
  apps_firefox_ai      (t! unmod_all (push-msg "APP:firefoxAI"))
  apps_firefox_banks   (t! unmod_all (push-msg "APP:firefoxBanks"))
  apps_firefox_colab   (t! unmod_all (push-msg "APP:firefoxColab"))
  apps_fusion360       (t! unmod_all (push-msg "APP:fusion360"))
  apps_okular          (t! unmod_all (push-msg "APP:okular"))
  apps_onlyoffice      (t! unmod_all (push-msg "APP:onlyoffice"))
  apps_telegram        (t! unmod_all (push-msg "APP:telegram"))
  apps_orcaslicer      (t! unmod_all (push-msg "APP:orcaslicer"))

  apps_not_bound       (t! unmod_all (push-msg "NOTIFY:No app bound"))
)

(defvar
  action_apps+spc          $apps_app_finder
  action_apps+!lctl        $apps_recent_files

  action_apps+0            $apps_chrome_misc
  action_apps+1            $apps_chrome_mgmt
  action_apps+2            $apps_chrome_cloud
  action_apps+3            $apps_chrome_ai
  action_apps+4            $apps_chrome_banks
  action_apps+5            $apps_chrome_misc1
  action_apps+6            $apps_chrome_misc2
  action_apps+7            $apps_chrome_misc3
  action_apps+8            $apps_chrome_misc4
  action_apps+9            $apps_chrome_colab

  action_apps+a            $apps_not_bound
  action_apps+b            $apps_not_bound
  action_apps+c            $apps_claude_code
  action_apps+d            $apps_not_bound
  action_apps+e            $apps_fileexplorer

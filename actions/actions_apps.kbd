  action_apps+lsft+c       $apps_not_bound
  action_apps+lsft+d       $apps_not_bound
  action_apps+lsft+e       $apps_not_bound
  action_apps+lsft+f       $apps_fusion360
  action_apps+lsft+g       $apps_not_bound
  action_apps+lsft+h       $apps_not_bound
  action_apps+lsft+i       $apps_not_bound
  action_apps+lsft+j       $apps_not_bound
  action_apps+lsft+k       $apps_okular
  action_apps+lsft+l       $apps_not_bound
  action_apps+lsft+m       $apps_not_bound
  action_apps+lsft+n       $apps_not_bound
  action_apps+lsft+o       $apps_onlyoffice

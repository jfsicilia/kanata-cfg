(defvar
  ;; Leaf vars — label source for generate_help
  set_quiet_profile       (multi (push-msg "NOTIFY: Quiet profile")       (cmd asusctl profile set Quiet))
  set_balanced_profile    (multi (push-msg "NOTIFY: Balanced profile")    (cmd asusctl profile set Balanced))
  set_performance_profile (multi (push-msg "NOTIFY: Performance profile") (cmd asusctl profile set Performance))
  restart_kwanata         (t! unmod_all (macro RA-spc 300 s y s t e m c t l spc - - u s e r spc r e s t a r t spc k w a n a t a 300 ent))
  restart_system          (multi (push-msg "NOTIFY: Rebooting...")        (cmd systemctl reboot))
  shutdown_system         (multi (push-msg "NOTIFY: Shutting down...")    (cmd systemctl shutdown))
  print_screen            prnt
  print_window            S-prnt
  sync_and_reload_kanata  (multi (cmd kanata_sync.sh) (push-msg "RELOAD:") lrld)
  reload_kanata           lrld
  debug_message           (push-msg "DEBUG: This is a DEBUG message to check communication")
  sleep_system            (multi (push-msg "NOTIFY: Sleeping...")         (cmd systemctl suspend))
  toggle_verbose          (multi (push-msg "NOTIFY: Toggle verbosity...") (push-msg "SET:!verbose"))
)

(defvar
  ;; == opts ==============================================================
  action_opts+1         $set_quiet_profile
  action_opts+2         $set_balanced_profile
  action_opts+3         $set_performance_profile
  action_opts+rsft+k    $restart_kwanata
  action_opts+lsft+q    $restart_system
  action_opts+rsft+q    $shutdown_system
  action_opts+p         $print_screen
  action_opts+lsft+p    $print_window
  action_opts+lsft+k    $sync_and_reload_kanata
  action_opts+k         $reload_kanata
  action_opts+d         $debug_message
  action_opts+q         $sleep_system
  action_opts+v         $toggle_verbose
)

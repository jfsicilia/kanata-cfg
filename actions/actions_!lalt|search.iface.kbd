(defvar
  ;; == !lalt|search actions ==========================================================

  ;; !lalt|search + spc 
  action_!lalt|search+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_nvim)) $nvim_action_!lalt|search+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lalt|search+spc break
      ((input virtual vk_obsidian)) $obsidian_action_!lalt|search+spc break
      ((input virtual vk_zapzap)) $zapzap_action_!lalt|search+spc break
      ((input virtual vk_chrome)) $chrome_action_!lalt|search+spc break
      ((input virtual vk_whatsapp)) $whatsapp_action_!lalt|search+spc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_whatsapp)) $whatsapp_action_!lalt|search+spc break
      ((input virtual vk_chrome)) $chrome_action_!lalt|search+spc break
      ((input virtual vk_zapzap)) $zapzap_action_!lalt|search+spc break
      ((input virtual vk_obsidian)) $obsidian_action_!lalt|search+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lalt|search+spc break
      ((input virtual vk_nvim)) $nvim_action_!lalt|search+spc break
      () XX break
    ) break
  ))

(defvar

  ;; == groups =============================================================

  ;; groups + spc
  action_groups+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_zellij)) $zellij_action_groups+spc break
      ((input virtual vk_tmux)) $tmux_action_groups+spc break
      ((input virtual vk_firefox)) $firefox_action_groups+spc break
      ((input virtual vk_obsidian)) $obsidian_action_groups+spc break
      ((input virtual vk_chrome)) $chrome_action_groups+spc break
      ((input virtual vk_nvim)) $nvim_action_groups+spc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_nvim)) $nvim_action_groups+spc break
      ((input virtual vk_chrome)) $chrome_action_groups+spc break
      ((input virtual vk_obsidian)) $obsidian_action_groups+spc break
      ((input virtual vk_firefox)) $firefox_action_groups+spc break
      ((input virtual vk_tmux)) $tmux_action_groups+spc break
      ((input virtual vk_zellij)) $zellij_action_groups+spc break
      () XX break
    ) break
  ))

  ;; groups + l | groups + right  
  action_groups+l (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_zellij)) $zellij_action_groups+l break
      ((input virtual vk_tmux)) $tmux_action_groups+l break
      ((input virtual vk_firefox)) $firefox_action_groups+l break
      ((input virtual vk_obsidian)) $obsidian_action_groups+l break
      ((input virtual vk_chrome)) $chrome_action_groups+l break
      ((input virtual vk_nvim)) $nvim_action_groups+l break
      () C-tab break
    ) break
    () (switch 
      ((input virtual vk_nvim)) $nvim_action_groups+l break
      ((input virtual vk_chrome)) $chrome_action_groups+l break
      ((input virtual vk_obsidian)) $obsidian_action_groups+l break
      ((input virtual vk_firefox)) $firefox_action_groups+l break
      ((input virtual vk_tmux)) $tmux_action_groups+l break
      ((input virtual vk_zellij)) $zellij_action_groups+l break
      () C-tab break
    ) break
  )) 

(defvar

  ;; == !tabs/groups =====================================================

  ;; !tabs + spc
  action_!tabs+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_!tabs+spc break
    ((input virtual vk_chrome)) $chrome_action_!tabs+spc break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+spc break
    ((input virtual vk_firefox)) $firefox_action_!tabs+spc break
    ((input virtual vk_tmux)) $tmux_action_!tabs+spc break
    ((input virtual vk_zellij)) $zellij_action_!tabs+spc break
    () XX break
  ))

  ;; !tabs + l | !tabs + right  
  ~action_!tabs+l (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zellij)) $zellij_action_!tabs+l break
    ((input virtual vk_tmux)) $tmux_action_!tabs+l break
    ((input virtual vk_firefox)) $firefox_action_!tabs+l break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+l break
    ((input virtual vk_chrome)) $chrome_action_!tabs+l break
    ((input virtual vk_nvim)) $nvim_action_!tabs+l break
    () C-tab break
  )) 
  ;; !tabs + h | !tabs + left  
  ~action_!tabs+h (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zellij)) $zellij_action_!tabs+h break
    ((input virtual vk_tmux)) $tmux_action_!tabs+h break
    ((input virtual vk_firefox)) $firefox_action_!tabs+h break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+h break
    ((input virtual vk_chrome)) $chrome_action_!tabs+h break
    ((input virtual vk_nvim)) $nvim_action_!tabs+h break
    () C-S-tab break
  ))
  ;; !tabs + j | !tabs + down
  ~action_!tabs+j  (t! unmod_all (switch ;;@iface@
    () XX break
  ))
  ;; !tabs + k | !tabs + up
  ~action_!tabs+k  (t! unmod_all (switch ;;@iface@
    () XX break
  ))

  ;; !tabs + t 
  ~action_!tabs+t (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+t break
    ((input virtual vk_firefox)) $firefox_action_!tabs+t break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+t break
    ((input virtual vk_chrome)) $chrome_action_!tabs+t break
    () XX break
  ))
  ;; !tabs + w
  ~action_!tabs+w (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+w break
    ((input virtual vk_firefox)) $firefox_action_!tabs+w break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+w break
    ((input virtual vk_chrome)) $chrome_action_!tabs+w break
    ((input virtual vk_nvim)) $nvim_action_!tabs+w break
    () XX break
  ))
  ;; !tabs + lsft + t 
  ~action_!tabs+lsft+t (t! unmod_all (switch ;;@iface@
    ((input virtual vk_firefox)) $firefox_action_!tabs+lsft+t break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+lsft+t break
    ((input virtual vk_chrome)) $chrome_action_!tabs+lsft+t break
    () XX break
  ))

  ;; == !tabs go by number ==================================================
  ;; !tabs + 1
  ~action_!tabs+1 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+1 break
    ((input virtual vk_firefox)) $firefox_action_!tabs+1 break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+1 break
    ((input virtual vk_chrome)) $chrome_action_!tabs+1 break

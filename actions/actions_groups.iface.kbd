    ((input virtual vk_tmux)) $tmux_action_!tabs+5 break
    ((input virtual vk_firefox)) $firefox_action_!tabs+5 break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+5 break
    ((input virtual vk_chrome)) $chrome_action_!tabs+5 break
    ((input virtual vk_nvim)) $nvim_action_!tabs+5 break
    () XX break
  ))
  ;; !tabs + 6
  ~action_!tabs+6 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+6 break
    ((input virtual vk_firefox)) $firefox_action_!tabs+6 break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+6 break
    ((input virtual vk_chrome)) $chrome_action_!tabs+6 break
    ((input virtual vk_nvim)) $nvim_action_!tabs+6 break
    () XX break
  ))
  ;; !tabs + 7
  ~action_!tabs+7 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+7 break
    ((input virtual vk_firefox)) $firefox_action_!tabs+7 break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+7 break
    ((input virtual vk_chrome)) $chrome_action_!tabs+7 break
    ((input virtual vk_nvim)) $nvim_action_!tabs+7 break
    () XX break
  ))
  ;; !tabs + 8
  ~action_!tabs+8 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+8 break
    ((input virtual vk_firefox)) $firefox_action_!tabs+8 break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+8 break
    ((input virtual vk_chrome)) $chrome_action_!tabs+8 break
    ((input virtual vk_nvim)) $nvim_action_!tabs+8 break
    () XX break
  ))
  ;; !tabs + 9
  ~action_!tabs+9 (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+9 break
    ((input virtual vk_firefox)) $firefox_action_!tabs+9 break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+9 break
    ((input virtual vk_chrome)) $chrome_action_!tabs+9 break
    ((input virtual vk_nvim)) $nvim_action_!tabs+9 break
    () XX break
  ))

  ;; == !tabs + toggle =====================================================
  ;; !tabs + toggle
  ~action_!tabs+toggle (t! unmod_all (switch ;;@iface@
    ((input virtual vk_zellij)) $zellij_action_!tabs+toggle break
    ((input virtual vk_tmux)) $tmux_action_!tabs+toggle break
    ((input virtual vk_firefox)) $firefox_action_!tabs+toggle break
    ((input virtual vk_obsidian)) $obsidian_action_!tabs+toggle break
    ((input virtual vk_chrome)) $chrome_action_!tabs+toggle break
    ((input virtual vk_nvim)) $nvim_action_!tabs+toggle break
    () XX break
  ))

  ;; == !tabs + move =====================================================
  ;; !tabs + move + h | !tabs + move + left
  ~action_!tabs+move+h (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+move+h break
    () XX break
  ))
  ;; !tabs + move + l | !tabs + move + right
  ~action_!tabs+move+l (t! unmod_all (switch ;;@iface@
    ((input virtual vk_tmux)) $tmux_action_!tabs+move+l break
    () XX break
  ))
  ;; !tabs + move + k | !tabs + move + up
  ~action_!tabs+move+j (t! unmod_all (switch ;;@iface@
    () XX break
  ))
  ;; !tabs + move + j | !tabs + move + down
  ~action_!tabs+move+k (t! unmod_all (switch ;;@iface@
    () XX break
  ))

)

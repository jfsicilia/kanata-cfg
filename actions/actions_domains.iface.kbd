    ((input virtual vk_nvim)) $nvim_action_domains+j+j break
    () (push-msg "NOTIFY: Jumps not implemented") break
  ))

  ;; domains+k + k
  action_domains+k+k (t! unmod_all (switch ;;@iface@
    ((input virtual vk_chrome)) $chrome_action_domains+k+k break
    ((input virtual vk_dolphin)) $dolphin_action_domains+k+k break
    ((input virtual vk_firefox)) $firefox_action_domains+k+k break
    ((input virtual vk_nvim)) $nvim_action_domains+k+k break
    () (push-msg "NOTIFY: Keymaps not implemented") break

  action_domains+v+v (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: Virtualization not implemented") break
  ))

  ;; domains+w + w
  action_domains+w+w (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: Warnings not implemented") break
  ))

  ;; domains+x + x
  action_domains+x+x (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: Extensions not implemented") break
  ))

  ;; domains+y + y
  action_domains+y+y (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+y+y break
    () (push-msg "NOTIFY: History not implemented") break
  ))
  ;; domains+y + ;
  action_domains+y+; (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+y+; break
    () (push-msg "NOTIFY: History (commands) not implemented") break
  )) ;;""
  ;; domains+y + search 
  action_domains+y+search (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+y+search break
    () (push-msg "NOTIFY: History search not implemented") break
  ))

  ;; domains+z + z
  action_domains+z+z (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: Tests not implemented") break
  ))

  ;; domains+` + `
  action_domains+`+` (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: mod` not implemented") break
  ))

  ;; domains+- + -
  action_domains+-+- (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: mod- not implemented") break
  ))

  ;; domains+= + =
  action_domains+=+= (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: Format not implemented") break
  )) ;;""

  ;; domains+[ + [
  action_domains+[+[ (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_obsidian)) $obsidian_action_domains+[+[ break
    () (push-msg "NOTIFY: Backlinks not implemented") break
  )) ;;""

  ;; domains+] + ]
  action_domains+]+] (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+]+] break
    () (push-msg "NOTIFY: Outlinks not implemented") break
  )) ;;""
  ;; domains+] + a
  action_domains+]+a (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+]+a break
    () (push-msg "NOTIFY: Outlinks All not implemented") break
  )) ;;""

  ;; domains+\ + \
  action_domains+\+\ (t! unmod_all (switch ;;@iface@
    ((input virtual vk_foot)) $foot_action_domains+\+\ break
    ((input virtual vk_nvim)) $nvim_action_domains+\+\ break
    () (push-msg "NOTIFY: Toggle compare files not implemented") break
  )) ;;""
  ;; domains+\ + lsft + \
  action_domains+\+lsft+\ (t! unmod_all (switch ;;@iface@
    ((input virtual vk_foot)) $foot_action_domains+\+lsft+\ break
    () (push-msg "NOTIFY: Toggle compare folders not implemented") break

    ((input virtual vk_nvim)) $nvim_action_domains+l+l break
    () (push-msg "NOTIFY: Locations not implemented") break
  ))

  ;; domains+m + m
  action_domains+m+m (t! unmod_all (switch ;;@iface@
    ;; () (push-msg "NOTIFY: Memory not implemented") break
    ()                      $clipboard_history break  ;; Clipboard history
  ))

  ;; domains+n + n
  action_domains+n+n (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: notebooks not implemented") break
  ))

  ;; domains+o + o
  action_domains+o+o (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: Output not implemented") break
  ))

  ;; domains+p + p
  action_domains+p+p (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+p+p break
    () (push-msg "NOTIFY: Properties not implemented") break
  ))
  ;; domains+p + a
  action_domains+p+a (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+p+a break
    () (push-msg "NOTIFY: Properties All not implemented") break
  ))
  
  ;; domains+q + q
  action_domains+q+q (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+q+q break
    () (push-msg "NOTIFY: Quickfix not implemented") break
  ))

  ;; domains+r + r
  action_domains+r+r (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+r+r break
    () (push-msg "NOTIFY: References not implemented") break
  ))
  ;; domains+r + i
  action_domains+r+i (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+r+i break
    () (push-msg "NOTIFY: References (Incoming) not implemented") break
  ))
  ;; domains+r + o
  action_domains+r+o (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+r+o break
    () (push-msg "NOTIFY: References (Outgoing) not implemented") break
  ))
  ;; domains+r + s
  action_domains+r+s (t! unmod_all (switch ;;@ifaceS
    () (push-msg "NOTIFY: Source not implemented") break
  ))

  ;; domains+s + s
  action_domains+s+s (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+s+s break
    ((input virtual vk_nvim)) $nvim_action_domains+s+s break
    () (push-msg "NOTIFY: Symbols not implemented") break
  ))
  ;; domains+s + w
  action_domains+s+w (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+s+w break
    () (push-msg "NOTIFY: Symbols (Workspace) not implemented") break
  ))

  ;; domains+t + t
  action_domains+t+t (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_domains+t+t break
    ((input virtual vk_nvim)) $nvim_action_domains+t+t break
    () (push-msg "NOTIFY: Terminal not implemented") break
  ))
  ;; domains+t + toggle
  action_domains+t+toggle (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+t+toggle break
    () (push-msg "NOTIFY: Toggle Terminal not implemented") break
  ))

  ;; domains+u + u
  action_domains+u+u (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: UI not implemented") break
  ))
  ;; domains+u + g
  action_domains+u+g (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+u+g break
    () (push-msg "NOTIFY: UI Graph not implemented") break
  ))


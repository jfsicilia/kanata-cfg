    ((input virtual vk_nvim)) $nvim_action_domains+d+d break
    () (push-msg "NOTIFY: Definitions not implemented") break
  ))
  ;; domains+d + s
  action_domains+d+s (t! unmod_all (switch ;;@ifaceS
    () (push-msg "NOTIFY: Definition (Source) not implemented") break
  ))
 
  ;; domains+e + e
  action_domains+e+e (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+e+e break
    ((input virtual vk_dolphin)) $dolphin_action_domains+e+e break
    ((input virtual vk_nvim)) $nvim_action_domains+e+e break
    () (push-msg "NOTIFY: Explorer not implemented") break
  ))
  ;; domains+e + r
  action_domains+e+r (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+e+r break
    () (push-msg "NOTIFY: Explorer (Recents) not implemented") break
  ))
  ;; domains+e + f
  action_domains+e+f (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_domains+e+f break

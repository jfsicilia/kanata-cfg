    ((input virtual vk_nvim)) $nvim_action_domains+g+g break
    () (push-msg "NOTIFY: Git not implemented") break
  ))
  ;; domains+g + l
  action_domains+g+l (t! unmod_all (switch ;;@iface@
    ((input virtual vk_foot)) $foot_action_domains+g+l break
    ((input virtual vk_nvim)) $nvim_action_domains+g+l break

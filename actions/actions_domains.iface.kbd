  action_domains+'+' (t! unmod_all (switch ;;@iface@
    ((input virtual vk_nvim)) $nvim_action_domains+'+' break
    () (push-msg "NOTIFY: Registries not implemented") break
  ))

  ;; domains+, + ,
  action_domains+,+, (t! unmod_all (switch ;;@iface@
    ((input virtual vk_chrome)) $chrome_action_domains+,+, break
    ((input virtual vk_zapzap)) $zapzap_action_domains+,+, break
    ((input virtual vk_obsidian)) $obsidian_action_domains+,+, break
    ((input virtual vk_dolphin)) $dolphin_action_domains+,+, break

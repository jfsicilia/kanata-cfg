  ))

  ;; domains+9 + 9
  action_domains+9+9 (t! unmod_all (switch ;;@iface@
    () (push-msg "NOTIFY: mod9 not implemented") break
  ))

  ;; omni + omni
  action_domains+omni+omni (t! unmod_all (switch ;;@iface@
    () $ai break
  ))
 

)

(defvar
  tab_next        C-tab
  tab_prev        C-S-tab
  tab_new         C-t
  tab_close       C-w
  tab_undo_close  C-S-t
  ;; Tabs by number
  tab_goto_0      C-0
  tab_goto_1      C-1
  tab_goto_2      C-2
  tab_goto_3      C-3
  tab_goto_4      C-4
  tab_goto_5      C-5
  tab_goto_6      C-6
  tab_goto_7      C-7
  tab_goto_8      C-8
  tab_goto_9      C-9
  tab_goto_last   C-9
)

(defvar
  ;; == tabs ===============================================================

  (t! 7app_action action_tabs+spc (push-msg "NOTIFY: Select tabs not implemented") yazi chrome dolphin firefox nvim obsidian tmux)

  (t! 9app_action action_tabs+l $tab_next whatsapp yazi chrome firefox nvim obsidian tmux zapzap zellij)
  (t! 9app_action action_tabs+h $tab_prev whatsapp yazi chrome firefox nvim obsidian tmux zapzap zellij)
  (t! 6app_action action_tabs+j $tab_goto_1 yazi chrome dolphin firefox nvim obsidian)
  (t! 6app_action action_tabs+k $tab_goto_last yazi chrome dolphin firefox nvim obsidian)
  (t! 2app_action action_tabs+r XX yazi tmux)
  (t! 7app_action action_tabs+n $tab_new yazi chrome dolphin firefox nvim obsidian tmux)
  (t! 1app_action action_tabs+v (push-msg "NOTIFY: Tabs Vertical not implemented") obsidian)
  (t! 6app_action action_tabs+w $tab_close yazi chrome firefox nvim obsidian tmux)
  (t! 6app_action action_tabs+bspc $tab_close yazi chrome firefox nvim obsidian tmux)
  (t! 5app_action action_tabs+lsft+n $tab_undo_close yazi chrome dolphin firefox obsidian)

  ;; == tabs go by number ==================================================
  (t! 9app_action action_tabs+1 $tab_goto_1 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+2 $tab_goto_2 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+3 $tab_goto_3 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+4 $tab_goto_4 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+5 $tab_goto_5 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+6 $tab_goto_6 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+7 $tab_goto_7 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 9app_action action_tabs+8 $tab_goto_8 whatsapp yazi chrome dolphin firefox nvim obsidian tmux zapzap)
  (t! 7app_action action_tabs+9 $tab_goto_last yazi chrome dolphin firefox nvim obsidian tmux)

  ;; == tabs + toggle =====================================================
  (t! 8app_action action_tabs+toggle (push-msg "NOTIFY: Toggle recent tab not implemented") yazi chrome dolphin firefox nvim obsidian tmux zellij)

  ;; == tabs + move =====================================================
  (t! 5app_action action_tabs+move+h (push-msg "NOTIFY: Move tab left not implemented") yazi chrome dolphin firefox tmux)
  (t! 5app_action action_tabs+move+l (push-msg "NOTIFY: Move tab right not implemented") yazi chrome dolphin firefox tmux)
  (t! 4app_action action_tabs+move+j (push-msg "NOTIFY: Move tab first not implemented") yazi chrome dolphin firefox)
  (t! 4app_action action_tabs+move+k (push-msg "NOTIFY: Move tab last not implemented") yazi chrome dolphin firefox)
)

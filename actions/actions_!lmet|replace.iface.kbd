  ;; == !LMET|REPLACE actions ==========================================================

  ;; !lmet|replace + spc 
  action_!lmet|replace+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_nvim)) $nvim_action_!lmet|replace+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lmet|replace+spc break
      ((input virtual vk_obsidian)) $obsidian_action_!lmet|replace+spc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_obsidian)) $obsidian_action_!lmet|replace+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lmet|replace+spc break
      ((input virtual vk_nvim)) $nvim_action_!lmet|replace+spc break
      () XX break
    ) break
  ))
  ;; !lmet|replace + lsft + spc 
  action_!lmet|replace+lsft+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_apps_sort_desc)) (switch 
      ((input virtual vk_nvim)) $nvim_action_!lmet|replace+lsft+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lmet|replace+lsft+spc break
      ((input virtual vk_obsidian)) $obsidian_action_!lmet|replace+lsft+spc break
      () XX break
    ) break
    () (switch 
      ((input virtual vk_obsidian)) $obsidian_action_!lmet|replace+lsft+spc break
      ((input virtual vk_dolphin)) $dolphin_action_!lmet|replace+lsft+spc break
      ((input virtual vk_nvim)) $nvim_action_!lmet|replace+lsft+spc break
      () XX break
    ) break
  ))

  ;; == replace actions =================================================

  ;; == replace ==========================================================
  ;; replace + spc 
  action_replace+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_replace+spc break
    ((input virtual vk_dolphin)) $dolphin_action_replace+spc break
    ((input virtual vk_nvim)) $nvim_action_replace+spc break
    () XX break
  ))
  ;; replace + lsft + spc 
  action_replace+lsft+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_replace+lsft+spc break
    ((input virtual vk_dolphin)) $dolphin_action_replace+lsft+spc break
    ((input virtual vk_nvim)) $nvim_action_replace+lsft+spc break
    () XX break
  ))
  ;; replace + rsft + spc 
  action_replace+rsft+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_replace+rsft+spc break
    () XX break
  ))

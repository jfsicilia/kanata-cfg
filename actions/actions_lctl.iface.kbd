(defvar
  ;; Virtual key vk_lalt is "pressed" on first tab pressed and will be
  ;; "released" when lclt is released.
  walk_through_apps (switch 
    ((input virtual vk_lalt)) (unmod (lctl) tab) break
    () (multi (on-press press-vkey vk_lalt) lalt (unmod (lctl) tab)) break
  )
  ;; Virtual key vk_lalt is "pressed" on first ` pressed and will be
  ;; "released" when lclt is released.
  walk_through_same_app (switch 
    ((input virtual vk_lalt)) (unmod (lctl) grv) break
    () (multi (on-press press-vkey vk_lalt) lalt (unmod (lctl) grv)) break
  )

  ;; == LCTL actions ==========================================================
  action_lctl+tab    $walk_through_apps
  action_lctl+`      $walk_through_same_app
  action_lctl+a (t! unmod_all (switch ;;@iface@ 
    () C-a break
  ))
  action_lctl+b (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_obsidian)) $obsidian_action_lctl+b break
    () C-b break
  ))
  action_lctl+c  (t! unmod_all (switch ;;@iface@ 
    () C-c  break
  ))
  action_lctl+d (t! unmod_all (switch ;;@iface@ 

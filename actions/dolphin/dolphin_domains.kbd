(defvar
;; domains+e + e
dolphin_action_domains+e+e                 $dolphin_toggle_left_sidebar            
;; domains+i + i
dolphin_action_domains+i+i                    $dolphin_info
;; domains+k + k
dolphin_action_domains+k+k                  $dolphin_keymaps 
;; domains+t + t
dolphin_action_domains+t+t                    $dolphin_terminal
;; domains+, + ,
dolphin_action_domains+,+,                    $dolphin_settings 
;; domains+. + .
dolphin_action_domains+.+.                    $dolphin_tags
;; domains+/ + /
dolphin_action_domains+/+/                    $dolphin_help 
)

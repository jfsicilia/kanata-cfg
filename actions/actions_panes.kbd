(defvar
  ;; == panes =============================================================
  (t! 0app_action action_panes+spc (push-msg "NOTIFY:Show panes not implemented!"))

  (t! 6app_action action_panes+ent (push-msg "NOTIFY:Maximize pane not implemented!") dolphin herdr nvim obsidian tmux zellij)


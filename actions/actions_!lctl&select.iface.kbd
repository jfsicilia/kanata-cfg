  ;; == select actions ==================================================

  ;; == select ========================================================
  ;; select + spc 
  action_select+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_chrome)) $chrome_action_select+spc break
    ((input virtual vk_zapzap)) $zapzap_action_select+spc break
    ((input virtual vk_obsidian)) $obsidian_action_select+spc break
    ((input virtual vk_dolphin)) $dolphin_action_select+spc break
    ((input virtual vk_firefox)) $firefox_action_select+spc break
    ((input virtual vk_foot)) $foot_action_select+spc break
    ((input virtual vk_nvim)) $nvim_action_select+spc break
    ((input virtual vk_tmux)) $tmux_action_select+spc break
    () XX break
  ))
  ;; select + lsft + spc 
  action_select+lsft+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_chrome)) $chrome_action_select+lsft+spc break
    ((input virtual vk_obsidian)) $obsidian_action_select+lsft+spc break
    ((input virtual vk_dolphin)) $dolphin_action_select+lsft+spc break
    ((input virtual vk_firefox)) $firefox_action_select+lsft+spc break
    ((input virtual vk_nvim)) $nvim_action_select+lsft+spc break
    () XX break
  ))
  ;; select + rsft + spc 
  action_select+rsft+spc (t! unmod_all (switch ;;@iface@ 
    ((input virtual vk_dolphin)) $dolphin_action_select+rsft+spc break
    () XX break
  ))
)

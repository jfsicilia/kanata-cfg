(defvar
zellij_pane_maximize     (macro C-g p f ret)
zellij_pane_left         (macro C-g p h ret)
zellij_pane_right        (macro C-g p l ret)
zellij_pane_above        (macro C-g p k ret)
zellij_pane_below        (macro C-g p j ret)
;; panes + ent
zellij_action_panes+ent                   $zellij_pane_maximize
;; panes + h | panes + left
zellij_action_panes+h                     $zellij_pane_left
;; panes + l | panes + right
zellij_action_panes+l                     $zellij_pane_right
;; panes + k | panes + up
zellij_action_panes+k                     $zellij_pane_above
;; panes + j | panes + down
zellij_action_panes+j                     $zellij_pane_below
)

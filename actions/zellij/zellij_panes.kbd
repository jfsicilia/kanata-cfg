(defvar
;; panes + ent
zellij_action_panes+ent                   $zellij_pane_maximize
;; panes + h | panes + left
zellij_action_panes+h                     $zellij_pane_left
;; panes + l | panes + right
zellij_action_panes+l                     $zellij_pane_right
;; panes + k | panes + up
zellij_action_panes+k                     $zellij_pane_above
;; panes + j | panes + down
zellij_action_panes+j                     $zellij_pane_below
)

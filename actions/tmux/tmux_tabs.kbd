(defvar
tmux_action_tabs+r             $tmux_rename_tab
;; tabs + spc
tmux_action_tabs+spc           $tmux_select_tab 
;; tabs + l | tabs + right | lsft + rsft | 2x rsft | !lmet + tab
;; If not implemented, defaults to: C-tab
tmux_action_tabs+l             $tmux_right_tab          
;; tabs + h | tabs + left | rsft + lsft | 2x lsft | !lmet + sft + tab
;; If not implemented, defaults to: C-S-tab
tmux_action_tabs+h             $tmux_left_tab          
;; tabs + t
;; If not implemented, defaults to: C-t
tmux_action_tabs+t             $tmux_new_tab 
;; tabs + w
;; If not implemented, defaults to: C-w
;; tabs + v
tmux_action_tabs+w             $tmux_close_tab         
;; == tabs go by number ==================================================
;; tabs + 1
;; If not implemented, defaults to: C-1
tmux_action_tabs+1             $tmux_go_tab_1
;; tabs + 2
;; If not implemented, defaults to: C-2
tmux_action_tabs+2             $tmux_go_tab_2
;; tabs + 3
;; If not implemented, defaults to: C-3
tmux_action_tabs+3             $tmux_go_tab_3
;; tabs + 4
;; If not implemented, defaults to: C-4
tmux_action_tabs+4             $tmux_go_tab_4
;; tabs + 5
;; If not implemented, defaults to: C-5
tmux_action_tabs+5             $tmux_go_tab_5 
;; tabs + 6
;; If not implemented, defaults to: C-6
tmux_action_tabs+6             $tmux_go_tab_6 
;; tabs + 7
;; If not implemented, defaults to: C-7
tmux_action_tabs+7             $tmux_go_tab_7
;; tabs + 8
;; If not implemented, defaults to: C-8
tmux_action_tabs+8             $tmux_go_tab_8
;; tabs + 9
;; If not implemented, defaults to: C-9
tmux_action_tabs+9             $tmux_go_tab_9 
;; == tabs + toggle =====================================================
;; tabs + toggle | 2x !lctl
tmux_action_tabs+toggle        $tmux_toggle_tab  
;; == tabs + move =====================================================
;; tabs + move + h | tabs + move + left
tmux_action_tabs+move+h        $tmux_move_tab_left
;; tabs + move + l | tabs + move + right
tmux_action_tabs+move+l        $tmux_move_tab_right
)

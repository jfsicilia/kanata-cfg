(defvar

tmux_prefix                  A-b
_tmux:                       ($tmux_prefix S-; 100) 
_tmux_popup                  (d i s p l a y - p o p u p spc - d spc S-' S-3 S-[ p a n e S-- c u r r e n t S-- p a t h S-] S-' spc - S-e spc S-' S-' left)
_tmux_run                    (r u n - s h e l l spc S-' S-' left)
_tmux_float                  (n e w - p a n e spc - c spc S-' S-3 S-[ p a n e S-- c u r r e n t S-- p a t h S-] S-' ent 100)
_tmux_confirm                (c o n f i r m - b e f o r e spc - p spc S-' S-' left)


tmux_commands                (macro $_tmux:)
tmux_keybindings             (macro $tmux_prefix S-/)
tmux_reload_config           (macro $tmux_prefix S-; 100 s o u r c e - f i l e spc S-` / . c o n f i g / t m u x / t m u x . c o n f ent) 
tmux_file_picker             (macro $_tmux: $_tmux_popup t m u x - f i l e - p i c k e r ent)
tmux_folder_picker           (macro $_tmux: $_tmux_popup t m u x - f i l e - p i c k e r spc - d ent)

;;""
;;== omni ================================================================
tmux_pgup                    (macro $tmux_prefix pgup)
tmux_copy                    (macro $tmux_prefix [)
tmux_pgdn                    C-f
tmux_paste                   (macro $tmux_prefix ])
tmux_change_layout           (macro $tmux_prefix spc)

;;""
;;== Windows =============================================================
tmux_window_new              (macro $tmux_prefix c)
tmux_window_rename           (macro $tmux_prefix ,)

;;""
;;== pane ================================================================
tmux_pane_maximize           (macro $tmux_prefix z)
tmux_pane_left               (macro $tmux_prefix left)
tmux_pane_right              (macro $tmux_prefix right)
tmux_pane_above              (macro $tmux_prefix up)
tmux_pane_below              (macro $tmux_prefix down)
tmux_pane_h_split            (macro $tmux_prefix S-')
tmux_pane_v_split            (macro $tmux_prefix S-5)
tmux_pane_close              (macro $tmux_prefix x)
tmux_pane_toggle             (macro $tmux_prefix ;)  
tmux_pane_sidebar            (macro $_tmux: $_tmux_run w o r k m u x spc s i d e b a r ent)
tmux_move_pane_right         (macro $tmux_prefix S-]) 
tmux_move_pane_left          (macro $tmux_prefix S-[) 
tmux_move_pane_up            (macro $tmux_prefix S-; 100 s e l e c t - p a n e spc - S-u spc ; spc s w a p - p a n e spc - S-u ent) 
tmux_move_pane_down          (macro $tmux_prefix S-; 100 s e l e c t - p a n e spc - S-d spc ; spc s w a p - p a n e spc - S-d ent)
tmux_resize_pane_right       (macro $tmux_prefix C-right) 
tmux_resize_pane_left        (macro $tmux_prefix C-left) 
tmux_resize_pane_up          (macro $tmux_prefix C-up)
tmux_resize_pane_down        (macro $tmux_prefix C-down)

;;""
;;== tabs ================================================================
tmux_rename_tab              (macro $tmux_prefix ,)
tmux_select_tab              (macro $tmux_prefix w) ;; prefix + w (choose window) 
tmux_right_tab               (macro $tmux_prefix n) 
tmux_left_tab                (macro $tmux_prefix p) 
tmux_new_tab                 (macro $tmux_prefix c) 
tmux_close_tab               (macro $tmux_prefix S-7) ;; prefix + & (kill window) 
tmux_go_tab_1                (macro $tmux_prefix Digit1) 
tmux_go_tab_2                (macro $tmux_prefix Digit2)  
tmux_go_tab_3                (macro $tmux_prefix Digit3)  
tmux_go_tab_4                (macro $tmux_prefix Digit4)  
tmux_go_tab_5                (macro $tmux_prefix Digit5)  
tmux_go_tab_6                (macro $tmux_prefix Digit6)  
tmux_go_tab_7                (macro $tmux_prefix Digit7)  
tmux_go_tab_8                (macro $tmux_prefix Digit8)  
tmux_go_tab_9                (macro $tmux_prefix Digit9)  
tmux_toggle_tab              (macro $tmux_prefix l)        
tmux_move_tab_right          (macro $tmux_prefix S-; 100 s w a p - w i n d o w spc - t spc - Digit1 ; s e l e c t - w i n d o w spc - t spc - Digit1 ent) 
tmux_move_tab_left           (macro $tmux_prefix S-; 100 s w a p - w i n d o w spc - t spc S-= Digit1 ; s e l e c t - w i n d o w spc - t spc S-= Digit1 ent) 

;;""
;;== sessions ============================================================
tmux_session_select          (macro $tmux_prefix S-s spc)
tmux_session_next            (macro $tmux_prefix S-0)
tmux_session_prev            (macro $tmux_prefix S-9)
tmux_session_toggle          (macro $tmux_prefix S-s t)

tmux_session_rename          (macro $tmux_prefix S-4)

tmux_session_new             (macro $tmux_prefix S-s n)

;; NOTE: tmux_prefix + A-w (turns off sidebar)
;; tmux_session_detach          (macro $tmux_prefix A-w $tmux_prefix S-s d)
;; tmux_session_save_and_detach (macro $tmux_prefix A-w $tmux_prefix S-s w)
tmux_session_detach          (macro $tmux_prefix S-s d)
tmux_session_save_and_detach (macro $tmux_prefix S-s w)
tmux_session_save            (macro $tmux_prefix S-s s)

tmux_session_sleep           (macro $tmux_prefix S-s z)
tmux_session_awake           (macro $tmux_prefix S-s S-z)
tmux_session_delete          (macro $tmux_prefix S-s k)
tmux_session_revive          (macro $tmux_prefix S-s S-k)


tmux_session_select_0        XX
tmux_session_select_1        (macro $tmux_prefix S-s Digit1)
tmux_session_select_2        (macro $tmux_prefix S-s Digit2)
tmux_session_select_3        (macro $tmux_prefix S-s Digit3)
tmux_session_select_4        (macro $tmux_prefix S-s Digit4)
tmux_session_select_5        (macro $tmux_prefix S-s Digit5)
tmux_session_select_6        (macro $tmux_prefix S-s Digit6)
tmux_session_select_7        (macro $tmux_prefix S-s Digit7)
tmux_session_select_8        (macro $tmux_prefix S-s Digit8)
tmux_session_select_9        (macro $tmux_prefix S-s Digit9)

;;""
;;== agents ==============================================================
tmux_agent_select          (macro $tmux_prefix S-a spc)

tmux_agent_done            (macro $tmux_prefix S-a d)
tmux_agent_toggle          (macro $tmux_prefix S-a a)
                                 
tmux_agent_select_1        (macro $tmux_prefix S-a spc 50 Digit1)
tmux_agent_select_2        (macro $tmux_prefix S-a spc 50 Digit2)
tmux_agent_select_3        (macro $tmux_prefix S-a spc 50 Digit3)
tmux_agent_select_4        (macro $tmux_prefix S-a spc 50 Digit4)
tmux_agent_select_5        (macro $tmux_prefix S-a spc 50 Digit5)
tmux_agent_select_6        (macro $tmux_prefix S-a spc 50 Digit6)
tmux_agent_select_7        (macro $tmux_prefix S-a spc 50 Digit7)
tmux_agent_select_8        (macro $tmux_prefix S-a spc 50 Digit8)
tmux_agent_select_9        (macro $tmux_prefix S-a spc 50 Digit9)
                                
tmux_agent_next            (macro $tmux_prefix S-a l)
tmux_agent_prev            (macro $tmux_prefix S-a h)

;;""
;;== worktree ============================================================
tmux_worktree_select       (macro $tmux_prefix S-w spc)
tmux_worktree_select_1     (macro $tmux_prefix S-w spc 50 Digit1)
tmux_worktree_select_2     (macro $tmux_prefix S-w spc 50 Digit2)
tmux_worktree_select_3     (macro $tmux_prefix S-w spc 50 Digit3)
tmux_worktree_select_4     (macro $tmux_prefix S-w spc 50 Digit4)
tmux_worktree_select_5     (macro $tmux_prefix S-w spc 50 Digit5)
tmux_worktree_select_6     (macro $tmux_prefix S-w spc 50 Digit6)
tmux_worktree_select_7     (macro $tmux_prefix S-w spc 50 Digit7)
tmux_worktree_select_8     (macro $tmux_prefix S-w spc 50 Digit8)
tmux_worktree_select_9     (macro $tmux_prefix S-w spc 50 Digit9)
                                 
tmux_worktree_new          (macro $tmux_prefix S-w n)
tmux_worktree_rename       (macro $tmux_prefix S-w r)
tmux_worktree_merge        (macro $tmux_prefix S-w m)
tmux_worktree_delete       (macro $tmux_prefix S-w k)
tmux_worktree_rebase       (macro $tmux_prefix S-w b)
tmux_worktree_close        (macro $tmux_prefix S-w w)
)

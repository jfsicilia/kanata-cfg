(defvar
;; groups + spc
tmux_action_groups+spc         $tmux_action_tabs+spc
;; groups + l | groups + right
tmux_action_groups+l           $tmux_action_tabs+l             
;; groups + h | groups + left
tmux_action_groups+h           $tmux_action_tabs+h             
;; groups + t
tmux_action_groups+t           $tmux_action_tabs+t              
;; groups + w
tmux_action_groups+w           $tmux_action_tabs+w            
;; == groups go by number ==================================================
;; groups + 1
tmux_action_groups+1           $tmux_action_tabs+1           
;; groups + 2
tmux_action_groups+2           $tmux_action_tabs+2           
;; groups + 3
tmux_action_groups+3           $tmux_action_tabs+3           
;; groups + 4
tmux_action_groups+4           $tmux_action_tabs+4           
;; groups + 5
tmux_action_groups+5           $tmux_action_tabs+5           
;; groups + 6
tmux_action_groups+6           $tmux_action_tabs+6           
;; groups + 7
tmux_action_groups+7           $tmux_action_tabs+7           
;; groups + 8
tmux_action_groups+8           $tmux_action_tabs+8           
;; groups + 9
tmux_action_groups+9           $tmux_action_tabs+9        
;; == groups + toggle =====================================================
;; groups + toggle
tmux_action_groups+toggle      $tmux_action_tabs+toggle           
;; == groups + move =====================================================
;; groups + move + h | groups + move + left
tmux_action_groups+move+h      $tmux_action_tabs+move+h        
;; groups + move + l | groups + move + right
tmux_action_groups+move+l      $tmux_action_tabs+move+l       
)

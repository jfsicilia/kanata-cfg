(defvar
;; !tabs + spc
tmux_action_!tabs+spc                  $tmux_action_tabs+spc
;; !tabs + l | !tabs + right
tmux_action_!tabs+l             $tmux_action_tabs+l             
;; !tabs + h | !tabs + left
tmux_action_!tabs+h             $tmux_action_tabs+h             
;; !tabs + t
tmux_action_!tabs+t              $tmux_action_tabs+t              
;; !tabs + w
tmux_action_!tabs+w            $tmux_action_tabs+w            
;; == !tabs go by number ==================================================
;; !tabs + 1
tmux_action_!tabs+1           $tmux_action_tabs+1           
;; !tabs + 2
tmux_action_!tabs+2           $tmux_action_tabs+2           
;; !tabs + 3
tmux_action_!tabs+3           $tmux_action_tabs+3           
;; !tabs + 4
tmux_action_!tabs+4           $tmux_action_tabs+4           
;; !tabs + 5
tmux_action_!tabs+5           $tmux_action_tabs+5           
;; !tabs + 6
tmux_action_!tabs+6           $tmux_action_tabs+6           
;; !tabs + 7
tmux_action_!tabs+7           $tmux_action_tabs+7           
;; !tabs + 8
tmux_action_!tabs+8           $tmux_action_tabs+8           
;; !tabs + 9
tmux_action_!tabs+9        $tmux_action_tabs+9        
;; == !tabs + toggle =====================================================
;; !tabs + toggle
tmux_action_!tabs+toggle           $tmux_action_tabs+toggle           
;; == !tabs + move =====================================================
;; !tabs + move + h | !tabs + move + left
tmux_action_!tabs+move+h        $tmux_action_tabs+move+h        
;; !tabs + move + l | !tabs + move + right
tmux_action_!tabs+move+l       $tmux_action_tabs+move+l       
)

(defvar
;; omni + b
;; If not implemented, defaults to: pgup
foot_action_omni+b                        $foot_pgup
;; omni + c
;; If not implemented, defaults to: C-c
;; == omni edit ======================================================""
foot_action_omni+c                 $foot_copy
;; omni + e
;; foot_action_omni+e                 `{esc}dditar -xaf <file>{esc}vF<`
foot_action_omni+e                 $foot_extract
;; omni + lsft + e
;; foot_action_omni+lsft+e            `{esc}dditar -czf <zipfile> <files and/or folders>{esc}vF<;`
foot_action_omni+lsft+e            $foot_compress
;; omni + f
;; If not implemented, defaults to: pgdn
foot_action_omni+f                        $foot_pgdn
;; omni + v
;; If not implemented, defaults to: C-v
foot_action_omni+v                 $foot_paste
;; omni + y
foot_action_omni+y                 $foot_history   ;; shell history
;; omni + \
;; foot_action_omni+\                `{esc}ddinvim -d <file1> <file2>{esc}vF<;`
foot_action_omni+\                $foot_compare
;; omni + lsft + \
;; foot_action_omni+lsft+\           `{esc}ddinvim -c "DirDiff <dir1> <dir2>"{esc}hvF<;`
foot_action_omni+lsft+\           $foot_compare_dirs
)

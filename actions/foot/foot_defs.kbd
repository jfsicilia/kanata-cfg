(defvar
  foot_pgup                 S-pgup
  foot_copy                 C-S-c
  foot_extract              (macro C-u t a r spc - x a f spc S-, f i l e S-. esc v S-f S-,)
  foot_compress             (macro C-u t a r spc - c z f spc S-, z i p f i l e S-. spc S-, f i l e s spc a n d / o r spc f o l d e r s S-. esc v S-f S-, ;)
  foot_pgdn                 S-pgdn
  foot_paste                C-S-v
  foot_select_history       C-r
  foot_compare              (macro C-u n v i m spc - d spc S-, f i l e Digit1 S-. spc S-, f i l e Digit2 S-. esc v b b b b b)
  foot_compare_dirs         (macro C-u n v i m spc - c spc S-' S-d i r S-d i f f spc S-, d i r Digit1 S-. spc S-, d i r Digit2 S-. S-' esc h v S-f S-, ;)
  foot_lazygit              (macro C-u l a z y g i t ent)
  foot_git_status           (macro C-u g i t spc s t a t u s ent)
  foot_force_new_line       (macro \ ent)
  foot_select_file          C-f   ;; ver .zshrc
  foot_select_folder        A-c   ;; ver .zshrc

  foot_goto_trash           (macro C-u c d spc $folder_trash ent)
  foot_goto_bookcase        (macro C-u c d spc $folder_bookcase ent)
  foot_goto_config          (macro C-u c d spc $folder_config ent)
  foot_goto_downloads       (macro C-u c d spc $folder_downloads ent)
  foot_goto_enaire          (macro C-u c d spc $folder_enaire ent)
  foot_goto_photos          (macro C-u c d spc $folder_photos ent)
  foot_goto_guacimara       (macro C-u c d spc $folder_guacimara ent)
  foot_goto_home            (macro C-u c d spc $folder_home ent)
  foot_goto_inbox           (macro C-u c d spc $folder_inbox ent)
  foot_goto_projects        (macro C-u c d spc $folder_projects ent)
  foot_goto_kanata          (macro C-u c d spc $folder_kanata ent)
  foot_goto_main            (macro C-u c d spc $folder_main ent)
  foot_goto_scans           (macro C-u c d spc $folder_scans ent)
  foot_goto_screenshots     (macro C-u c d spc $folder_screenshots ent)
  foot_goto_personal        (macro C-u c d spc $folder_personal ent)
  foot_goto_resources       (macro C-u c d spc $folder_resources ent)
  foot_goto_settings        (macro C-u c d spc $folder_settings ent)
  foot_goto_tmp             (macro C-u c d spc $folder_tmp ent)
  foot_goto_dev             (macro C-u c d spc $folder_dev ent)
  foot_goto_workarea        (macro C-u c d spc $folder_workarea ent)
  foot_goto_root            (macro C-u c d spc $folder_root ent)

  foot_autocomplete         C-spc
  foot_edit_command         C-e
  foot_previous_command     C-p
  foot_next_command         C-n
  foot_fuzzy_complete       C-i
  foot_delete_char          C-h
  foot_delete_word          C-w
  foot_delete_whole_prompt  C-u
  foot_clear_terminal       C-l
  foot_close_terminal       C-d
  foot_run_command          C-m
  foot_copy_terminal_text   C-S-c
  foot_paste_terminal_text  C-S-v
)

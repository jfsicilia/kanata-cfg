(defvar
;; groups + spc
firefox_action_groups+spc              $firefox_action_tabs+spc                  
;; groups + l | groups + right
firefox_action_groups+l             $firefox_action_tabs+l             
;; groups + h | groups + left
firefox_action_groups+h             $firefox_action_tabs+h             
;; groups + t
firefox_action_groups+t              $firefox_action_tabs+t              
;; groups + w
firefox_action_groups+w            $firefox_action_tabs+w            
;; groups + lsft + t
firefox_action_groups+lsft+t       $firefox_action_tabs+lsft+t       
;; == groups go by number ==================================================
;; groups + 1
firefox_action_groups+1           $firefox_action_tabs+1           
;; groups + 2
firefox_action_groups+2           $firefox_action_tabs+2           
;; groups + 3
firefox_action_groups+3           $firefox_action_tabs+3           
;; groups + 4
firefox_action_groups+4           $firefox_action_tabs+4           
;; groups + 5
firefox_action_groups+5           $firefox_action_tabs+5           
;; groups + 6
firefox_action_groups+6           $firefox_action_tabs+6           
;; groups + 7
firefox_action_groups+7           $firefox_action_tabs+7           
;; groups + 8
firefox_action_groups+8           $firefox_action_tabs+8           
;; groups + 9
firefox_action_groups+9        $firefox_action_tabs+9        
;; == groups + toggle =====================================================
;; groups + toggle
firefox_action_groups+toggle           $firefox_action_tabs+toggle           
)

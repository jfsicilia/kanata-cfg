(defvar
;; omni + g
firefox_action_omni+g                             $firefox_go
;; omni + n
firefox_action_omni+n               $firefox_new
;; omni + ]
firefox_action_omni+]                      $firefox_forward
;; omni + [
firefox_action_omni+[                      $firefox_back
;; omni + ,
;; If not implemented, defaults to: action_domain,+,
firefox_action_omni+,                 $firefox_settings
)

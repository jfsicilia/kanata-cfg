(defvar
;; == !LCTL actions ==========================================================
obsidian_action_!lctl|select+a                        $obsidian_select_all_text
obsidian_action_!lctl|select+b                        $obsidian_bold_text
obsidian_action_!lctl|select+e                        $obsidian_toggle_edit_mode
obsidian_action_!lctl|select+p                        $obsidian_action_select_files
obsidian_action_!lctl|select+r                        $obsidian_toggle_source_mode
obsidian_action_!lctl|select+,                        $obsidian_action_setting
obsidian_action_!lctl|select+lsft+p                   $obsidian_commands
;; == select ========================================================
;; select + spc
obsidian_action_!lctl|select+spc                   $obsidian_select_file
;; select + lsft + spc
obsidian_action_!lctl|select+lsft+spc              $obsidian_select_folder
)

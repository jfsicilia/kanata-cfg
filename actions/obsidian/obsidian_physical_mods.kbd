(defvar
obsidian_action_lctl+b                         $obsidian_action_page_up
obsidian_action_lctl+f                         $obsidian_action_page_down
obsidian_action_lctl+t                         $obsidian_new_tab
obsidian_action_lctl+,                         $obsidian_action_setting
obsidian_action_lctl+;                         $obsidian_vimola
obsidian_action_lctl+[                         $obsidian_forward
obsidian_action_lctl+]                         $obsidian_backward
obsidian_action_lctl+lsft+t                    $obsidian_undo_close_tab
;; == !LCTL actions ==========================================================
obsidian_action_!lctl+a                        $obsidian_select_all_text
obsidian_action_!lctl+b                        $obsidian_bold_text
obsidian_action_!lctl+e                        $obsidian_toggle_edit_mode
obsidian_action_!lctl+p                        $obsidian_action_select_files
obsidian_action_!lctl+r                        $obsidian_toggle_source_mode
obsidian_action_!lctl+,                        $obsidian_action_setting
obsidian_action_!lctl+lsft+p                   $obsidian_commands
)

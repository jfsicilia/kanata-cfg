(defvar
;; tabs + spc
obsidian_action_tabs+spc            $obsidian_select_tab
;; tabs + l | tabs + right | lsft + rsft | 2x rsft | !lmet + tab
;; If not implemented, defaults to: C-tab
obsidian_action_tabs+l              $obsidian_right_tab
;; tabs + h | tabs + left | rsft + lsft | 2x lsft | !lmet + sft + tab
;; If not implemented, defaults to: C-S-tab
obsidian_action_tabs+h              $obsidian_left_tab
;; tabs + t
;; If not implemented, defaults to: C-t
obsidian_action_tabs+t              $obsidian_new_tab
;; tabs + v
obsidian_action_tabs+v              $obsidian_vertical_tabs
;; tabs + w
;; If not implemented, defaults to: C-w
;; tabs + v
obsidian_action_tabs+w              $obsidian_close_tab
;; tabs + lsft + t
;; If not implemented, defaults to: C-S-t
obsidian_action_tabs+lsft+t         $obsidian_undo_close_tab
;; == tabs go by number ==================================================
;; tabs + 1
;; If not implemented, defaults to: C-1
obsidian_action_tabs+1              $obsidian_go_tab_1
;; tabs + 2
;; If not implemented, defaults to: C-2
obsidian_action_tabs+2              $obsidian_go_tab_2 
;; tabs + 3
;; If not implemented, defaults to: C-3
obsidian_action_tabs+3              $obsidian_go_tab_3 
;; tabs + 4
;; If not implemented, defaults to: C-4
obsidian_action_tabs+4              $obsidian_go_tab_4 
;; tabs + 5
;; If not implemented, defaults to: C-5
obsidian_action_tabs+5              $obsidian_go_tab_5 
;; tabs + 6
;; If not implemented, defaults to: C-6
obsidian_action_tabs+6              $obsidian_go_tab_6 
;; tabs + 7
;; If not implemented, defaults to: C-7
obsidian_action_tabs+7              $obsidian_go_tab_7 
;; tabs + 8
;; If not implemented, defaults to: C-8
obsidian_action_tabs+8              $obsidian_go_tab_8 
;; tabs + 9
;; If not implemented, defaults to: C-9
obsidian_action_tabs+9              $obsidian_go_tab_9 
;; == tabs + toggle =====================================================
;; tabs + toggle | 2x !lctl
obsidian_action_tabs+toggle         $obsidian_toggle_tab
)

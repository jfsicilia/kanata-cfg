(defvar
;; domains+b + b
obsidian_action_domains+b+b              $obsidian_bookmarks
;; domains+c + c
obsidian_action_domains+c+c              $obsidian_calendar
;; domains+c + d
;; domains+c + y
obsidian_action_domains+c+d              $obsidian_daily_shift
;; domains+c + y
obsidian_action_domains+c+y              $obsidian_daily
;; domains+e + e
obsidian_action_domains+e+e              $obsidian_file_explorer
;; domains+e + r
obsidian_action_domains+e+r              $obsidian_recent
;; domains+e + f
obsidian_action_domains+e+f              $obsidian_file_explorer_reveal
;; domains+h + o
obsidian_action_domains+h+o             $obsidian_outline 
;; domains+p + p
obsidian_action_domains+p+p             $obsidian_properties
;; domains+p + a
obsidian_action_domains+p+a             $obsidian_properties_all
;; domains+s + s
obsidian_action_domains+s+s             $obsidian_symbols
;; domains+u + g
obsidian_action_domains+u+g             $obsidian_graph
;; domains+[ + [
obsidian_action_domains+[+[             $obsidian_backlinks
;; domains+] + ]
obsidian_action_domains+]+]             $obsidian_outlinks ;;""
;; domains+] + a
obsidian_action_domains+]+a             $obsidian_outlinks_all ;;""
;; domains+; + ;
obsidian_action_domains+;+;             $obsidian_commands
;; domains+, + ,
obsidian_action_domains+,+,             $obsidian_settings
)

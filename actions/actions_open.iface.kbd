(defvar

  ;; == open =============================================================
  ;; open + spc
  action_open+spc (t! unmod_all (switch ;;@iface@
    ((input virtual vk_dolphin)) $dolphin_action_open+spc break
    () XX break
  ))
  ;; open + m
  action_open+m (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_open+m break
    ((input virtual vk_dolphin)) $dolphin_action_open+m break
    () XX break
  ))
  ;; open + t
  action_open+t (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_open+t break
    ((input virtual vk_dolphin)) $dolphin_action_open+t break
    () XX break
  ))
  ;; open + v
  action_open+v (t! unmod_all (switch ;;@iface@
    ((input virtual vk_obsidian)) $obsidian_action_open+v break
    ((input virtual vk_dolphin)) $dolphin_action_open+v break
    () XX break
  ))
)

(defvar
  ;; Navigation / Edit
  cancel            esc
  space             spc
  delete            del

  page_up           pgup
  page_down         pgdn

  nav_left          left
  nav_down          down
  nav_up            up
  nav_right         right

  shift+nav_left    S-left
  shift+nav_down    S-down
  shift+nav_up      S-up
  shift+nav_right   S-right

  nav_next          right
  nav_prev          left
  undo              C-z
  redo              C-S-z
  ;; Clipboard
  copy              C-c
  copy_path         C-S-c
  paste             C-v
  cut               C-x
  ;; Other operations
  settings          $action_domains+,+,
  tags              $action_domains+.+.
  help              $action_domains+/+/
  panes_toggle      $action_panes+toggle
  tabs_toggle       $action_tabs+toggle
  apps_toggle       $windows_toggle
  sessions_toggle   $action_sessions+toggle
)

(defvar
  ;; This file is intended to be written by the user, and its action
  ;; dispatch is regenerated by the kanata_sync_apps.py script through the
  ;; Napp_action templates (see templates.kbd). The name of the action is
  ;; up to the user; to have the script keep it in sync with which apps
  ;; implement it, write it as:
  ;;
  ;;   (t! Napp_action <name> <default> <app1> <app2> ... <appN>)
  ;;
  ;; Example:
  ;;   (t! 2app_action action_lctl+a XX nvim obsidian)
  ;;
  ;; N is the number of apps that implement the action (0app_action for
  ;; none). <default> is the fallback used when no listed app is focused.
  ;; Each <appK> is an app name (matching its vk_<app> virtual key),
  ;; listed in priority order: when more than one app is focused at once
  ;; (e.g. nvim inside a tmux session), the first one in the list wins.
  ;; That priority order can be flipped live via the vk_apps_sort_desc
  ;; virtual key, which the template handles internally.
  ;;
  ;; Each app that wants its action autogenerated needs to define
  ;; <app>_action_<name> (same name as here, with the app prefix) in its
  ;; own actions/<app>/<app>_<iface>.kbd file. kanata_sync_apps.py scans
  ;; those files to build the <app1>...<appN> list for each action; the
  ;; default order of apps in the filename-less case is alphabetical, and
  ;; can be overridden with a numeric priority suffix on the per-app file
  ;; (e.g. action_nvim.1.kbd precedes action_chrome.10.kbd).

  ;; == omni ============================================================

  (t! 2app_action action_omni $cancel nvim colab)

  (t! 5app_action action_omni+spc $action_lctl+spc nvim yazi tmux dolphin obsidian)

  (t! 3app_action action_omni+ent XX yazi tmux dolphin)

  (t! 3app_action action_omni+bspc $delete yazi colab dolphin)

  (t! 5app_action action_omni+a XX nvim yazi tmux dolphin obsidian)
  (t! 5app_action action_omni+lsft+a XX nvim yazi tmux dolphin obsidian)
  (t! 5app_action action_omni+rsft+a XX nvim yazi tmux dolphin obsidian)

  (t! 5app_action action_omni+b $page_up nvim yazi tmux foot obsidian)

  (t! 6app_action action_omni+c $copy nvim yazi tmux foot dolphin obsidian)
  (t! 4app_action action_omni+lsft+c $copy_path nvim yazi tmux dolphin)
  (t! 4app_action action_omni+rsft+c $copy_path nvim yazi tmux dolphin)
  (t! 4app_action action_omni+c+left XX nvim yazi tmux dolphin)
  (t! 4app_action action_omni+c+right XX nvim yazi tmux dolphin)

  (t! 5app_action action_omni+d XX nvim yazi tmux dolphin obsidian)

  (t! 5app_action action_omni+e XX nvim yazi tmux foot dolphin)
  (t! 5app_action action_omni+lsft+e XX nvim yazi tmux foot dolphin)

  (t! 5app_action action_omni+f $page_down nvim yazi tmux foot obsidian)

  (t! 9app_action action_omni+g XX whatsapp nvim yazi tmux chrome dolphin firefox obsidian zapzap)

  (t! 1app_action action_omni+h $nav_left nvim)
  (t! 0app_action action_omni+lsft+h $shift+nav_left)
  (t! 0app_action action_omni+rsft+h $shift+nav_left)

  (t! 4app_action action_omni+i XX nvim yazi tmux dolphin)

  (t! 1app_action action_omni+j $nav_down nvim)
  (t! 0app_action action_omni+lsft+j $shift+nav_down)
  (t! 0app_action action_omni+rsft+j $shift+nav_down)

  (t! 1app_action action_omni+k $nav_up nvim)
  (t! 0app_action action_omni+lsft+k $shift+nav_up)
  (t! 0app_action action_omni+rsft+k $shift+nav_up)

  (t! 1app_action action_omni+l $nav_right nvim)
  (t! 0app_action action_omni+lsft+l $shift+nav_right)
  (t! 0app_action action_omni+rsft+l $shift+nav_right)

  (t! 1app_action action_omni+m $clipboard_history nvim)

  (t! 10app_action action_omni+n XX whatsapp nvim yazi tmux chrome colab dolphin firefox obsidian zapzap)
  (t! 8app_action action_omni+lsft+n XX whatsapp nvim yazi tmux colab dolphin obsidian zapzap)
  (t! 8app_action action_omni+rsft+n XX whatsapp nvim yazi tmux colab dolphin obsidian zapzap)

  (t! 5app_action action_omni+o $nav_next nvim yazi tmux dolphin obsidian)

  (t! 5app_action action_omni+p $nav_prev nvim yazi tmux dolphin obsidian)

  (t! 4app_action action_omni+q $windows_close whatsapp nvim tmux zapzap)

  (t! 5app_action action_omni+r XX nvim yazi tmux dolphin obsidian)

  (t! 4app_action action_omni+s XX nvim yazi tmux dolphin)
  (t! 4app_action action_omni+lsft+s XX nvim yazi tmux dolphin)

  (t! 4app_action action_omni+t $action_tabs+n nvim yazi tmux dolphin)
  (t! 3app_action action_omni+lsft+t $action_tabs+lsft+n nvim tmux dolphin)

  (t! 4app_action action_omni+u XX nvim yazi tmux dolphin)

  (t! 6app_action action_omni+v $paste nvim yazi tmux foot dolphin obsidian)

  (t! 4app_action action_omni+w $action_tabs+w nvim yazi tmux dolphin)

  (t! 5app_action action_omni+x $cut nvim yazi tmux dolphin obsidian)
  (t! 4app_action action_omni+x+left XX nvim yazi tmux dolphin)
  (t! 4app_action action_omni+x+right XX nvim yazi tmux dolphin)
  
  (t! 4app_action action_omni+y XX nvim tmux foot dolphin)

  (t! 3app_action action_omni+z $undo nvim tmux dolphin)
  (t! 3app_action action_omni+lsft+z $redo nvim tmux dolphin)


  (t! 3app_action action_omni+0 $tab_goto_0 nvim tmux dolphin)
  (t! 6app_action action_omni+1 $tab_goto_1 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+2 $tab_goto_2 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+3 $tab_goto_3 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+4 $tab_goto_4 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+5 $tab_goto_5 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+6 $tab_goto_6 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+7 $tab_goto_7 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+8 $tab_goto_8 whatsapp nvim yazi tmux dolphin zapzap)
  (t! 6app_action action_omni+9 $tab_goto_9 whatsapp nvim yazi tmux dolphin zapzap)

  (t! 3app_action action_omni+` XX nvim tmux dolphin)

  (t! 3app_action action_omni+- XX nvim tmux dolphin)

  (t! 3app_action action_omni+= XX nvim tmux dolphin)

  (t! 8app_action action_omni+] XX nvim yazi tmux chrome dolphin firefox kiwix obsidian)

  (t! 8app_action action_omni+[ XX nvim yazi tmux chrome dolphin firefox kiwix obsidian)

  (t! 5app_action action_omni+\ XX nvim yazi tmux foot dolphin)
  (t! 3app_action action_omni+lsft+\ XX nvim tmux foot)
  (t! 2app_action action_omni+rsft+\ XX nvim tmux)

  (t! 3app_action action_omni+; XX nvim tmux dolphin)

  (t! 4app_action action_omni+' XX nvim yazi tmux dolphin)

  (t! 6app_action action_omni+, $settings whatsapp nvim tmux chrome firefox zapzap)

  (t! 3app_action action_omni+. $tags nvim tmux dolphin)
  
  (t! 2app_action action_omni+/ $help nvim tmux)

  (t! 2app_action action_omni+!lmet $desktops_toggle nvim tmux)

  (t! 2app_action action_omni+!lalt $panes_toggle nvim tmux)

  (t! 2app_action action_omni+!lctl $tabs_toggle nvim tmux)

  (t! 2app_action action_omni+ralt $apps_toggle nvim tmux)

  (t! 3app_action action_omni+copilot $sessions_toggle nvim tmux dolphin)
)

# Omni - dolphin (actions/dolphin/dolphin_omni.kbd)
**omni + omni**     -- Cancel (esc)
**omni + spc**      -- Select (spc)
**omni + ent**      -- Preview (f11)
**omni + bcsp**     -- Bcsp
**omni + a**        -- Select All (C-a)
**omni + lsft + a** -- Invert Selection (C-S-a)
**omni + rsft + a** -- Invert Selection (C-S-a)
**omni + b**        -- Page Up (pgup)
**omni + c**        -- Copy (C-c)
**omni + lsft + c** -- Copy Path (C-A-c)
**omni + rsft + c** -- Copy Path (C-A-c)
**omni + c + h**    -- Copy To Other Pane (S-f5)
**omni + c + l**    -- Copy To Other Pane (S-f5)
**omni + d**        -- Duplicate (C-d)
**omni + e**        -- Extract (S-f10 [10ms] [up] [up] [right] [down] [down] [ent])
**omni + lsft + e** -- Compress (S-f10 [10ms] [up] [up] [up] [right] [down] [down] [ent])
**omni + f**        -- Page Down (pgdn)
**omni + g**        -- Go (C-l)
**omni + h**        -- Nav Left (left)
**omni + i**        -- Info (A-ret)
**omni + j**        -- Nav Down (down)
**omni + k**        -- Nav Up (up)
**omni + l**        -- Nav Right (right)
**omni + m**        -- Clipboard History (M-v)
**omni + n**        -- New (A-S-n)
**omni + lsft + n** -- New Folder (C-S-n)
**omni + rsft + n** -- New Window (C-n)
**omni + o**        -- Open (ent)
**omni + p**        -- Parent (A-up)
**omni + q**        -- Window Close (A-f4)
**omni + r**        -- Rename (f2)
**omni + s**        -- Toggle Sort By
**omni + lsft + s** -- Sort Order Toggle
**omni + t**        -- New Tab (C-t)
**omni + lsft + t** -- Undo Tab (C-S-t)
**omni + u**        -- Cycle View
**omni + v**        -- Paste (C-v)
**omni + w**        -- Close Tab (C-w)
**omni + x**        -- Cut (C-x)
**omni + x + h**    -- Move To Other Pane (S-f6)
**omni + x + l**    -- Move To Other Pane (S-f6)
**omni + z**        -- Undo (C-z)
**omni + lsft + z** -- Redo (C-S-z)
**omni + 0**        -- Zoom Reset (C-0)
**omni + 1**        -- Tab 1 (A-1)
**omni + 2**        -- Tab 2 (A-2)
**omni + 3**        -- Tab 3 (A-3)
**omni + 4**        -- Tab 4 (A-4)
**omni + 5**        -- Tab 5 (A-5)
**omni + 6**        -- Tab 6 (A-6)
**omni + 7**        -- Tab 7 (A-7)
**omni + 8**        -- Tab 8 (A-8)
**omni + 9**        -- Tab 9 (A-9)
**omni + -**        -- Zoomout (C--)
**omni + =**        -- Zoomin (C-=)
**omni + ]**        -- Forward (A-right)
**omni + [**        -- Back (A-left)
**omni + \**        -- Vimdiff
**omni + '**        -- Filter (C-i)
**omni + .**        -- Tags (S-f10 [10ms] [down] [down] [down] [down] [down] [down] [down] [down] [down] [down] [30ms] [ent] [30ms] [ent])
**omni + !lmet**    -- Desktops Toggle
**omni + ralt**     -- Apps Toggle (M-tab)

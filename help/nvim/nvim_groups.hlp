# Groups - nvim (actions/nvim/nvim_groups.1.kbd)
**groups + spc**    -- Tabs
**groups + l**      -- Tabs Next ([esc] :bnext [ret])
**groups + h**      -- Tabs Prev ([esc] :bprevious [ret])
**groups + w**      -- Close Tab ([esc] :bdelete [ent])
**groups + 1**      -- Tab 1 ([esc] :lua require('bufferline').go_to_buffer(1,true) [ent])
**groups + 2**      -- Tab 2 ([esc] :lua require('bufferline').go_to_buffer(2,true) [ent])
**groups + 3**      -- Tab 3 ([esc] :lua require('bufferline').go_to_buffer(3,true) [ent])
**groups + 4**      -- Tab 4 ([esc] :lua require('bufferline').go_to_buffer(4,true) [ent])
**groups + 5**      -- Tab 5 ([esc] :lua require('bufferline').go_to_buffer(5,true) [ent])
**groups + 6**      -- Tab 6 ([esc] :lua require('bufferline').go_to_buffer(6,true) [ent])
**groups + 7**      -- Tab 7 ([esc] :lua require('bufferline').go_to_buffer(7,true) [ent])
**groups + 8**      -- Tab 8 ([esc] :lua require('bufferline').go_to_buffer(8,true) [ent])
**groups + 9**      -- Tab 9 ([esc] :lua require('bufferline').go_to_buffer(0,true) [ent])
**groups + toggle** -- Toggle Tab ([esc] :b# [ret])

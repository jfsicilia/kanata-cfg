# Omni - nvim (actions/nvim/nvim_omni.kbd)
**omni + omni**     -- Cancel (esc)
**omni + spc**      -- Select ([esc] :Telescope find_files [ret])
**omni + bcsp**     -- Delete (del)
**omni + a**        -- Select All ([esc] ggVG)
**omni + b**        -- Pgup (C-b)
**omni + c**        -- Copy (y)
**omni + lsft + c** -- Copy Path (C-S-c)
**omni + rsft + c** -- Copy Path (C-S-c)
**omni + d**        -- Duplicate ([esc] :saveas %:r_copy.%:e)
**omni + f**        -- Pgdn (C-f)
**omni + h**        -- Cursor Left (left)
**omni + j**        -- Cursor Down (down)
**omni + k**        -- Cursor Up (up)
**omni + l**        -- Cursor Right (right)
**omni + m**        -- Clipboard History (M-v)
**omni + n**        -- New ([esc] :tabnew [ent] :e )
**omni + lsft + n** -- New Folder ([esc] :!mkdir -p )
**omni + o**        -- Tag Follow (C-])
**omni + p**        -- Tag Back (C-t)
**omni + q**        -- Quit ([esc] :qa [ent])
**omni + r**        -- Rename ([esc] :saveas )
**omni + s**        -- Sort (:sort [ent])
**omni + lsft + s** -- Sort Reverse (:sort! [ent])
**omni + t**        -- New Tab ([esc] :tabnew [ent])
**omni + lsft + t** -- Undo Tab
**omni + u**        -- Remove Duplicates (:%!awk 'seen[$0]++ == 0' [ent])
**omni + v**        -- Paste (C-S-v)
**omni + w**        -- Close Tab ([esc] :bdelete [ent])
**omni + x**        -- Cut (d)
**omni + y**        -- History Commands ([esc] :Telescope command_history [ret])
**omni + z**        -- Undo (u)
**omni + lsft + z** -- Redo (C-r)
**omni + 0**        -- Tab Goto 0 (C-0)
**omni + 1**        -- Tab 1 ([esc] :lua require('bufferline').go_to_buffer(1,true) [ent])
**omni + 2**        -- Tab 2 ([esc] :lua require('bufferline').go_to_buffer(2,true) [ent])
**omni + 3**        -- Tab 3 ([esc] :lua require('bufferline').go_to_buffer(3,true) [ent])
**omni + 4**        -- Tab 4 ([esc] :lua require('bufferline').go_to_buffer(4,true) [ent])
**omni + 5**        -- Tab 5 ([esc] :lua require('bufferline').go_to_buffer(5,true) [ent])
**omni + 6**        -- Tab 6 ([esc] :lua require('bufferline').go_to_buffer(6,true) [ent])
**omni + 7**        -- Tab 7 ([esc] :lua require('bufferline').go_to_buffer(7,true) [ent])
**omni + 8**        -- Tab 8 ([esc] :lua require('bufferline').go_to_buffer(8,true) [ent])
**omni + 9**        -- Tab 9 ([esc] :lua require('bufferline').go_to_buffer(0,true) [ent])
**omni + ]**        -- Forward (C-i)
**omni + [**        -- Back (C-o)
**omni + \**        -- Compare Toggle
**omni + ;**        -- Comment ([esc] gcc)
**omni + ,**        -- Settings ([esc] :Telescope vim_options [ret])
**omni + .**        -- Tags ([esc] :Telescope tags [ret])
**omni + /**        -- Help ([esc] :help [ret])
**omni + !lmet**    -- Desktops Toggle
**omni + ralt**     -- Apps Toggle (M-tab)

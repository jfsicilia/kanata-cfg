;; SETUP.KBD - Keyboard Layout & Default Layer Configuration
;; ===========================================================
;;
;; This file defines:
;;   - Variable mappings for all physical keys
;;   - The default layer with tap-hold behaviors
;;   - Virtual keys for fast-typing detection, language alternatives, and alt+tab
;;     emulation
;;
;; Fast-typing configuration from:
;; https://github.com/jtroo/kanata/discussions/1656#discussioncomment-14382030
;;
;; PHYSICAL KEY REMAPPING (Mac-like layout)
;; ----------------------------------------
;; Physical keyboard keys are remapped to create a Mac-like modifier layout:
;;   Physical lctl → lmet (like Cmd key)
;;   Physical lmet → lalt (like Opt key)
;;   Physical lalt → lctl (like Ctrl key)
;;
;; HOMEROW MODS (fast-typing aware)
;; --------------------------------
;; Home row keys act as modifiers when held and as letters when tapped:
;;
;;   a    s    d    f              j    k    l    ;
;;  lmet lalt lsft lctl           lctl rsft lalt lmet
;;
;; Fast-typing detection prevents accidental modifier activation when typing 
;; quickly.
;;
;; DUAL MODIFIER SYSTEM
;; --------------------
;; Two sets of modifiers provide different functionality in vim-mode applications:
;;   - Homerow mods (lctl, lalt, lmet) - used for vim-mode commands
;;   - Physical mods (!lctl, !lalt, !lmet) - used for app-native commands
;; In non-vim applications, both sets have the same functionality.
;;
;; FIRST CLASS CITIZENS: GUI ELEMENTS
;; ---------------------------------
;; Windows, workspaces (desktops/monitors), panes, tabs, sessions, agents and
;; worktrees are first-class citizens: each has its own mod key, reachable with
;; either hand.
;;
;;   citizen       left    right     row
;;   workspaces     z        /       lower  (pinky)
;;   sessions       x        .       lower  (ring)
;;   panes          b        n       lower  (middle)
;;   tabs           v        m       lower  (index, inner)
;;   rev_tabs       c        ,       lower  (index, outer)   also keyb+v / keyb+m
;;   windows        g        h       home   (index)
;;   rev_panes      t        y       upper  (index)
;;   agents         e        i       upper  (inner)
;;   worktrees      w        o       upper  (ring)
;;
;; The lower row mirrors around its centre:
;;
;;        z      x      c      v       b    |    n       m      ,      .      /
;;      wksp   sess  rev_tabs tabs   panes  |  panes    tabs rev_tabs sess   wksp
;;
;; rev_tabs / rev_panes open the tabs / panes layer with the app-priority sort
;; flipped — use them to act on the *other* app when two are stacked (e.g. tmux
;; under nvim).
;;
;; MOD LAYERS
;; ----------
;; Holding a key turns it into a mod: it opens that key's layer for as long as
;; it stays down. Tapping still types the letter (fast-typing aware). The upper
;; row mirrors the same way the lower row does.
;;
;; UPPER ROW
;; ---------
;; tab     → tap: tab           hold: open_layer
;; q / p   → tap: q / p         hold: system_layer
;; w / o   → tap: w / o         hold: worktrees_layer
;; e / i   → tap: e / i         hold: agents_layer
;; r / u   → tap: r / u         hold: run_layer
;; t / y   → tap: t / y         hold: rev_panes_layer
;; [ ] \   → tap: [ ] \         hold: (nothing yet — void_layer)
;;
;; MIDDLE ROW
;; ----------
;; The homerow mods. a/s/d/f and their mirrors j/k/l/; are letters when tapped
;; and real modifiers when held, so they double as mods without costing a key.
;;
;; caps    → tap: esc           hold: omni_layer (fast access editing/file operations)
;; a / ;   → tap: a / ;         hold: lmet_layer
;; s / l   → tap: s / l         hold: lalt_layer
;; d       → tap: d             hold: lsft_layer
;; k       → tap: k             hold: rsft_layer
;; f / j   → tap: f / j         hold: lctl_layer (also releases vk_lalt, the
;;                                    alt+tab emulation — see defvirtualkeys)
;; g / h   → tap: g / h         hold: windows_layer
;; '       → tap: '             hold: (nothing yet — void_layer)
;;
;; LOWER ROW
;; ---------
;; lsft    → tap: 2x tab_prev       hold: lsft_layer
;; keyb    → tap: invert apps sort  hold: keyb_layer  (< > key on Spanish kbd;
;;                                        Spanish chars, ES/US toggle, numpad,
;;                                        emojis, rev_tabs / rev_panes)
;; z / /   → tap: z / /             hold: workspaces_layer
;; x / .   → tap: x / .             hold: sessions_layer
;; c / ,   → tap: c / ,             hold: rev_tabs_layer  (tabs, sort flipped)
;; v / m   → tap: v / m             hold: tabs_layer
;; b / n   → tap: b / n             hold: panes_layer  
;; rsft    → tap: 2x tab_next       hold: rsft_layer
;;
;; MODIFIER ROW
;; ------------
;; !lmet   → tap: 2x last desktop   hold: !lmet_layer  (+spc → replace; physical lctl)
;; !lalt   → tap: 2x last pane      hold: !lalt_layer  (+spc → search;  physical lmet)
;; !lctl   → tap: 2x last tab       hold: !lctl_layer  (+spc → select;  physical lalt)
;; spc     → tap: space             hold: domains_layer
;; ralt    → tap: 2x last app       hold: apps_layer
;; prnt    → tap: 2x last session   hold: bookmarks_layer
;; copilot → tap: last session      hold: bookmarks_layer  (physical F23)
;; esc     → tap: esc               hold: opts_layer
;; (rctl is not present on this keyboard)
;;
;; STACKED MODS: !lctl / !lalt / !lmet are two things at once
;; ----------------------------------------------------------
;; Holding one of the physical modifiers pushes two layers in a single go
;; (see layers_toggle/toggles_!lctl|select.kbd and its siblings):
;;
;;   hold !lctl  →  lctl_layer + !lctl|select_layer
;;
;; so while it is held you get both things at the same time:
;;   - !lctl|select+ behaviour if combo is defined. If not, it tries to find
;;     if the combo is defined  lctl
;;
;;   !lctl + spc → select   (seek & select: files, buffers, …)
;;   !lalt + spc → search
;;   !lmet + spc → replace
;;
;; This is why select/search/replace have no layer file of their own: they
;; live in the file of the modifier they ride on (layer_!lctl|select.kbd, …).
;; Kanata only ever reports the topmost layer as active, so their help is
;; folded into the !mod help pages too.
;;
;; DOMAIN LAYERS (spc + key)
;; -------------------------
;; "Domain" means one thing only: the spc+ system. Holding spc opens
;; domains_layer, a second level where each key opens its own sub-domain —
;; spc+t terminal, spc+g git, spc+q quickfix, spc+r references, spc+s symbols,
;; spc+u UI, … Every other thing you hold is a mod, not a domain.
;;
;; SPANISH CHARACTERS
;; -----------------
;; Two ways to type accents:
;;   - Hold keyb, tap a/e/i/o/u → á é í ó ú ; keyb+n → ñ
;;   - keyb+l toggles a sticky ES/US mode (vk_alt_chars); while ES is on,
;;     double-tap a vowel → accent, double-tap n → ñ, triple-tap e → €,
;;     triple-tap u → ü
;; keyb+k toggles the numpad overlay (vk_numpad). keyb+spc → emoji picker.
;;
;; =============================================================================
;;

;; Virtual Keys ============================================================
(defvirtualkeys
  vk_lalt           lalt ;; Used to mimic lalt+tab with lctl+tab.

  vk_alt_chars      XX ;; Used to toggle alternative character layout for other
                       ;; languages.
  vk_numpad         XX ;; Used to toggle alternative keyboard: normal vs numpad.

  vk_apps_sort_desc  XX  ;; Used to toggle apps sort order (asc/desc) in the apps layer.
  vk_apps_show_sort $APPS_SHOW_SORT      ;; Triggers trayicon update to show current sort order (asc/desc).
  vk_apps_sort_toggle $APPS_SORT_TOGGLE  ;; Toggles apps sort order (asc/desc) and triggers trayicon update to show current sort order (asc/desc).

  vk_fast_typing    XX ;; Used to allow fast typing without triggering modifier
                       ;; combos with homerowmod.

  ;; Domains (see spc+letter combos)
  vk_domains+a (layer-while-held domains+a_layer) 
  vk_domains+b (layer-while-held domains+b_layer) 
  vk_domains+c (layer-while-held domains+c_layer) 
  vk_domains+d (layer-while-held domains+d_layer) 
  vk_domains+e (layer-while-held domains+e_layer) 
  vk_domains+f (layer-while-held domains+f_layer) 
  vk_domains+g (layer-while-held domains+g_layer) 
  vk_domains+h (layer-while-held domains+h_layer) 
  vk_domains+i (layer-while-held domains+i_layer) 
  vk_domains+j (layer-while-held domains+j_layer) 
  vk_domains+k (layer-while-held domains+k_layer) 
  vk_domains+l (layer-while-held domains+l_layer) 
  vk_domains+m (layer-while-held domains+m_layer) 
  vk_domains+n (layer-while-held domains+n_layer) 
  vk_domains+o (layer-while-held domains+o_layer) 
  vk_domains+p (layer-while-held domains+p_layer) 
  vk_domains+q (layer-while-held domains+q_layer) 
  vk_domains+r (layer-while-held domains+r_layer) 
  vk_domains+s (layer-while-held domains+s_layer) 
  vk_domains+t (layer-while-held domains+t_layer)
  vk_domains+u (layer-while-held domains+u_layer) 
  vk_domains+v (layer-while-held domains+v_layer) 
  vk_domains+w (layer-while-held domains+w_layer) 
  vk_domains+x (layer-while-held domains+x_layer) 
  vk_domains+y (layer-while-held domains+y_layer) 
  vk_domains+z (layer-while-held domains+z_layer) 
  vk_domains+; (layer-while-held domains+;_layer) 
  vk_domains+' (layer-while-held domains+'_layer) 
  vk_domains+, (layer-while-held domains+,_layer) 
  vk_domains+. (layer-while-held domains+._layer) 
  vk_domains+/ (layer-while-held domains+/_layer) 
  vk_domains+\ (layer-while-held domains+\_layer) 
  vk_domains+[ (layer-while-held domains+[_layer) 
  vk_domains+] (layer-while-held domains+]_layer) 
  vk_domains+` (layer-while-held domains+`_layer) 
  vk_domains+- (layer-while-held domains+-_layer) 
  vk_domains+= (layer-while-held domains+=_layer) 
  vk_domains+0 (layer-while-held domains+0_layer) 
  vk_domains+1 (layer-while-held domains+1_layer) 
  vk_domains+2 (layer-while-held domains+2_layer) 
  vk_domains+3 (layer-while-held domains+3_layer) 
  vk_domains+4 (layer-while-held domains+4_layer) 
  vk_domains+5 (layer-while-held domains+5_layer) 
  vk_domains+6 (layer-while-held domains+6_layer) 
  vk_domains+7 (layer-while-held domains+7_layer) 
  vk_domains+8 (layer-while-held domains+8_layer) 
  vk_domains+9 (layer-while-held domains+9_layer) ;;""
  vk_domains+omni (layer-while-held domains+omni_layer) ;;""
)

;; Releases domains virtual keys
(deftemplate release_domains ()
    (on-release release-vkey vk_domains+a)
    (on-release release-vkey vk_domains+b)
    (on-release release-vkey vk_domains+c)
    (on-release release-vkey vk_domains+d)
    (on-release release-vkey vk_domains+e)
    (on-release release-vkey vk_domains+f)
    (on-release release-vkey vk_domains+g)
    (on-release release-vkey vk_domains+h)
    (on-release release-vkey vk_domains+i)
    (on-release release-vkey vk_domains+j)
    (on-release release-vkey vk_domains+k)
    (on-release release-vkey vk_domains+l)
    (on-release release-vkey vk_domains+m) 
    (on-release release-vkey vk_domains+n)
    (on-release release-vkey vk_domains+o)
    (on-release release-vkey vk_domains+p)
    (on-release release-vkey vk_domains+q)
    (on-release release-vkey vk_domains+r)
    (on-release release-vkey vk_domains+s)
    (on-release release-vkey vk_domains+t)
    (on-release release-vkey vk_domains+u)
    (on-release release-vkey vk_domains+v)
    (on-release release-vkey vk_domains+w)
    (on-release release-vkey vk_domains+x)
    (on-release release-vkey vk_domains+y)
    (on-release release-vkey vk_domains+z)
    (on-release release-vkey vk_domains+;)
    (on-release release-vkey vk_domains+')
    (on-release release-vkey vk_domains+,)
    (on-release release-vkey vk_domains+.)
    (on-release release-vkey vk_domains+/)
    (on-release release-vkey vk_domains+\)
    (on-release release-vkey vk_domains+[)
    (on-release release-vkey vk_domains+])
    (on-release release-vkey vk_domains+`)
    (on-release release-vkey vk_domains+-)
    (on-release release-vkey vk_domains+=)
    (on-release release-vkey vk_domains+0)
    (on-release release-vkey vk_domains+1)
    (on-release release-vkey vk_domains+2)
    (on-release release-vkey vk_domains+3)
    (on-release release-vkey vk_domains+4)
    (on-release release-vkey vk_domains+5)
    (on-release release-vkey vk_domains+6)
    (on-release release-vkey vk_domains+7)
    (on-release release-vkey vk_domains+8)
    (on-release release-vkey vk_domains+9)
    (on-release release-vkey vk_domains+omni)
) ;;""


;; Variables ===============================================================
(defvar
  ;; Time config
  RETAP_TIME  200
  HOLD_TIME 160
  FAST_TYPE_TIME 55

  POPUP_HELP  (push-msg "POPUP_HELP")  ;; Send message to open help.

  ;; Show current apps sort order in trayicon (asc/desc)
  APPS_SHOW_SORT (switch ((input virtual vk_apps_sort_desc)) (push-msg "SET:invert")   break 
                         ()                                  (push-msg "UNSET:invert") break)
  ;; Toggle apps sort order (asc/desc) and show current sort order in trayicon.
  APPS_SORT_TOGGLE (macro (on-press toggle-vkey vk_apps_sort_desc) 100 (on-press tap-vkey vk_apps_show_sort))
  ;; Set apps sort order to ascending and show current sort order in trayicon.
  APPS_SORT_ASC (macro (on-release release-vkey vk_apps_sort_desc) 100 (on-release tap-vkey vk_apps_show_sort))  

  ;; Number row keys.
      `|mod`                `          ;; Tap: `,                Hold:
      1|mod1                1          ;; Tap: 1,                Hold:
      2|mod2                2          ;; Tap: 2,                Hold:
      3|mod3                3          ;; Tap: 3,                Hold:
      4|mod4                4          ;; Tap: 4,                Hold:
      5|mod5                5          ;; Tap: 5,                Hold:
      6|mod6                6          ;; Tap: 6,                Hold:
      7|mod7                7          ;; Tap: 7,                Hold:
      8|mod8                8          ;; Tap: 8,                Hold:
      9|mod9                9          ;; Tap: 9,                Hold:
      0|mod0                0          ;; Tap: 0,                Hold:
      -|mod-                -          ;; Tap: -,                Hold:
      =|mod=                =          ;; Tap: =,                Hold:

  ;; Upper row keys.
    tab|open                tab        ;; Tap: Tab,              Hold: open_with_layer
      q|system              q          ;; Tap: q,                Hold: system_layer
      w|worktrees           w          ;; Tap: w,                Hold: worktrees_layer 
      e|agents              e          ;; Tap: e,                Hold: agents_layer 
      r|run                 r          ;; Tap: r,                Hold: run_layer 
      t|rev_panes           t          ;; Tap: t,                Hold: rev_panes_layer 
      y|rev_panes           y          ;; Tap: y,                Hold: rev_panes_layer
      u|run                 u          ;; Tap: u,                Hold: run_layer 
      i|agents              i          ;; Tap: i,                Hold: agents_layer 
      o|worktrees           o          ;; Tap: o,                Hold: worktrees_layer 
      p|system              p          ;; Tap: p,                Hold: system_layer 
      [|mod[                [          ;; Tap: [,                Hold: 
      ]|mod]                ]          ;; Tap: ],                Hold:
      \|mod\                \          ;; Tap: \,                Hold: ""
  
                                 
  ;; Medium row keys.
    esc|omni                caps       ;; Tap: esc,              Hold: omni_layer
      a|lmet                a          ;; Tap: a,                Hold: lmet_layer 
      s|lalt                s          ;; Tap: s,                Hold: lalt_layer 
      d|lsft                d          ;; Tap: d,                Hold: lsft_layer 
      f|lctl                f          ;; Tap: f,                Hold: lctl_layer 
      g|windows             g          ;; Tap: g,                Hold: windows_layer
      h|windows             h          ;; Tap: h,                Hold: windows_layer
      j|lctl                j          ;; Tap: j,                Hold: lctl_layer 
      k|rsft                k          ;; Tap: k,                Hold: rsft_layer 
      l|lalt                l          ;; Tap: l,                Hold: lalt_layer 
      ;|lmet                ;          ;; Tap: ;,                Hold: lmet_layer 
      '|mod'                '          ;; Tap: ',                Hold:

  ;; Low row keys. 
 invert|keyb                lsgt       ;; Tap: Invert apps sort, Hold: keyb_layer
      z|workspaces          z          ;; Tap: z,                Hold: workspaces_layer
      x|sessions            x          ;; Tap: x,                Hold: sessions_layer
      c|rev_tabs            c          ;; Tap: c,                Hold: panes_layer 
      v|tabs                v          ;; Tap: v,                Hold: tabs_layer 
      b|panes               b          ;; Tap: b,                Hold: rev(tabs_layer)
      n|panes               n          ;; Tap: n,                Hold: rev(tabs_layer)
      m|tabs                m          ;; Tap: m,                Hold: tabs_layer 
      ,|rev_tabs            ,          ;; Tap: ,,                Hold: panes_layer 
      .|sessions            .          ;; Tap: .,                Hold: sessions_layer
      /|workspaces          /          ;; Tap: /,                Hold: workspaces_layer
  
  ;; Modifiers row
  !lmet|replace             $!lmet     ;; 2xTap: Last desktop,   Hold: !lmet_layer     Hold+spc: replace_layer 
  !lalt|search              $!lalt     ;; 2xTap: Last pane,      Hold: !lalt_layer     Hold+spc: search_layer
  !lctl|select              $!lctl     ;; 2xTap: Last tab,       Hold: !lclt_layer     Hold+spc: select_layer  
    spc|domains             spc        ;; Tap: spacebar,         Hold: domains_layer 
   ralt|apps                ralt       ;; 2xTap: Last app,       Hold: apps_layer
   prnt|bookm               prnt       ;; 2xTab: Last session,   Hold: bookmarks_layer
copilot|bookm               $copilot   ;; 2xTab: Last session,   Hold: bookmarks_layer
   ;; rctl|opts                rctl       ;; 2xTab: (unassigned),   Hold: opts_layer
    esc|opts                esc        ;; Tap: esc,              Hold: opts_layer

  ;; Omni + modifiers row
  !lmet|desktops     $!lmet            ;; Omni+: Last desktop
  !lalt|panes        $!lalt            ;; Omni+: Last pane
  !lctl|tabs         $!lctl            ;; Omni+: Last tab
;; ralt|apps         ralt              ;; Omni+: Last app
copilot|sessions     $copilot          ;; Omni+: Last session
   ;; rctl|worktrees    rctl              ;; Omni+: Last worktree

  ;; Standard modifiers
  <lctl              f          
  >lctl              j         
  <lalt              s          
  >lalt              l          
  <lmet              a          
  >lmet              ;          
  lsft               d 
  rsft               k 
  !lmet              lctl       ;; Physical lctl is used as lmet
  !lalt              lmet       ;; Physical lmet is used as lalt
  !lctl              lalt       ;; Physical lalt is used as lctl

  ;; Fixed modifiers.
  omni               caps       ;; Physical caps key will be used for omni layer when hold.
  open               tab        ;; Physical tab key will be used for open with layer when hold.
  domains            spc        ;; Physical spc key will be used for domains layer when hold.
  apps               ralt       ;; Physical ralt key will be used for apps layer when hold.
  bookm              prnt       ;; Physical prnt key will be used for bookmark layer when hold.
  ;; Copilot key issues alt+sft+f23 when pressed. If present will be used as bookm key.
  ;; See (deflayermap (!lalt+lsft_layer)...) in layer_mod_physical.kbd to see how this key
  ;; is captured.
  copilot            f23        ;; Physical copilot key will be used for bookmark layer when hold.
  replace            $!lmet     ;; Physical lctl key will be used for replace layer when hold.
  search             $!lalt     ;; Physical lwin key will be used for search layer when hold.
  select             $!lctl     ;; Physical lalt key will be used for select layer when hold.


  ;; GUI objects modifiers (used for move/resize/snap/swap sublayers).
  swap              $!lmet
  resize            $!lalt
  move              $!lctl
  toggle            ralt       
  float_&_snap      $copilot
  done         $copilot
  ;; Depending on the physical keyboard, the following keys can be used to trigger GUI object layers:
  ;; float_&_snap    prnt      
  ;; swap            rctl        
)

(defsrc
  esc        f1         f2         f3         f4         f5         f6         f7         f8         f9         f10        f11        f12    del
  grv        1          2          3          4          5          6          7          8          9          0          -          =      bspc
  tab        q          w          e          r          t          y          u          i          o          p          [          ]      \
  caps       a          s          d          f          g          h          j          k          l          ;          '          ret
  lsft       lsgt       z          x          c          v          b          n          m          ,          .          /          rsft   
  lctl       lmet       lalt                             spc                              ralt       prnt       rctl
) ;;""

(deftemplate default_layer ()
    $esc|opts              (t!      th  esc                                   $toggle_opts_layer)   

  ;; Number row keys
      $`|mod`              (t! fast_th (t! char `)                            (layer-toggle void_layer))
      $0|mod0              (t! fast_th (t! char Digit0)                       (layer-toggle void_layer))
      $1|mod1              (t! fast_th (t! char Digit1)                       (layer-toggle void_layer))
      $2|mod2              (t! fast_th (t! char Digit2)                       (layer-toggle void_layer))
      $3|mod3              (t! fast_th (t! char Digit3)                       (layer-toggle void_layer))
      $4|mod4              (t! fast_th (t! char Digit4)                       (layer-toggle void_layer))
      $5|mod5              (t! fast_th (t! char Digit5)                       (layer-toggle void_layer))
      $6|mod6              (t! fast_th (t! char Digit6)                       (layer-toggle void_layer)) 
      $7|mod7              (t! fast_th (t! char Digit7)                       (layer-toggle void_layer))
      $8|mod8              (t! fast_th (t! char Digit8)                       (layer-toggle void_layer))
      $9|mod9              (t! fast_th (t! char Digit9)                       (layer-toggle void_layer))
      $-|mod-              (t! fast_th (t! char -)                            (layer-toggle void_layer))
      $=|mod=              (t! fast_th (t! char =)                            (layer-toggle void_layer))

  ;; Upper row keys
    $tab|open              (t! fast_th tab                                    $toggle_open_layer)   
      $q|system            (t! fast_th (t! char q)                            $toggle_system_layer)
      $w|worktrees         (t! fast_th (t! char w)                            $toggle_worktrees_layer)
      $e|agents            (t! fast_th (t! char e)                            $toggle_agents_layer)
      $r|run               (t! fast_th (t! char r)                            $toggle_run_layer)
      $t|rev_panes         (t! fast_th (t! char t)                            $toggle_rev_panes_layer)
      $y|rev_panes         (t! fast_th (t! char y)                            $toggle_rev_panes_layer)
      $u|run               (t! fast_th (t! char u)                            $toggle_run_layer) 
      $i|agents            (t! fast_th (t! char i)                            $toggle_agents_layer) 
      $o|worktrees         (t! fast_th (t! char o)                            $toggle_worktrees_layer) 
      $p|system            (t! fast_th (t! char p)                            $toggle_system_layer) 
      $[|mod[              (t! fast_th (t! char [)                            (layer-toggle void_layer)) 
      $]|mod]              (t! fast_th (t! char ])                            (layer-toggle void_layer)) 
      $\|mod\              (t! fast_th (t! char \)                            (layer-toggle void_layer)) 

  ;; Medium row keys (a, s, d, f, j, k, l, ; work as lmet, lalt, lsft/rsft and lctl)
    $esc|omni              (t! fast_th $action_omni                           $toggle_omni_layer)  
      $a|lmet              (t! fast_th (t! char a)                            $toggle_lmet_layer)
      $s|lalt              (t! fast_th (t! char s)                            $toggle_lalt_layer)
      $d|lsft              (t! fast_th (t! char d)                            $toggle_lsft_layer)
      $f|lctl              (t! fast_th (t! char f)                            $toggle_lctl_layer)
      $g|windows           (t! fast_th (t! char g)                            $toggle_windows_layer)
      $h|windows           (t! fast_th (t! char h)                            $toggle_windows_layer)
      $j|lctl              (t! fast_th (t! char j)                            $toggle_lctl_layer)
      $k|rsft              (t! fast_th (t! char k)                            $toggle_rsft_layer)
      $l|lalt              (t! fast_th (t! char l)                            $toggle_lalt_layer)
      $;|lmet              (t! fast_th (t! char ;)                            $toggle_lmet_layer)
      $'|mod'              (t! fast_th (t! char ')                            (layer-toggle void_layer)) 
                     
  ;; Lower row keys: z/ = workspaces, x/. = sessions, c/, = rev_tabs, v/m = tabs, b/n = panes.
  lsft                     (t!      th (t! 2x $action_tabs+h)                 $toggle_lsft_layer)
 $invert|keyb              (t!      th $APPS_SORT_TOGGLE                      $toggle_keyb_layer)
      $z|workspaces        (t! fast_th (t! char z)                            $toggle_workspaces_layer)
      $x|sessions          (t! fast_th (t! char x)                            $toggle_sessions_layer)
      $c|rev_tabs          (t! fast_th (t! char c)                            $toggle_rev_tabs_layer)
      $v|tabs              (t! fast_th (t! char v)                            $toggle_tabs_layer)
      $b|panes             (t! fast_th (t! char b)                            $toggle_panes_layer)
      $n|panes             (t! fast_th (t! char n)                            $toggle_panes_layer)
      $m|tabs              (t! fast_th (t! char m)                            $toggle_tabs_layer)
      $,|rev_tabs          (t! fast_th (t! char ,)                            $toggle_rev_tabs_layer)
      $.|sessions          (t! fast_th (t! char .)                            $toggle_sessions_layer)
      $/|workspaces        (t! fast_th (t! char /)                            $toggle_workspaces_layer)
  rsft                     (t!      th (t! 2x $action_tabs+l)                 $toggle_rsft_layer)

  ;; Modifiers row.
  $!lmet|replace           (t!      th (t! 2x $action_workspaces+toggle)      $toggle_!lmet|replace_layer)
  $!lalt|search            (t!      th (t! 2x $action_panes+toggle)           $toggle_!lalt|search_layer)
  $!lctl|select            (t!      th (t! 2x $action_tabs+toggle)            $toggle_!lctl|select_layer)
    $spc|domains           (t! fast_th spc                                    $toggle_domains_layer) 
   $ralt|apps              (t!      th (t! 2x $windows_toggle)                $toggle_apps_layer)
   $prnt|bookm             (t!      th (t! 2x $action_sessions+toggle)        $toggle_bookmarks_layer)
;;$copilot|bookm             (t!      th (t! 2x $action_sessions+toggle)        $toggle_bookmarks_layer)
$copilot|bookm             (t!      th $action_sessions+toggle                $toggle_bookmarks_layer)
  ;; $rctl|opts              (t!      th (t! 2x XX)                             $toggle_opts_layer)

     enter                 (t!      th enter                                  (layer-toggle void_layer))
)

(deflayermap (default)
  (t! default_layer)
)

(deflayermap (void_layer))
